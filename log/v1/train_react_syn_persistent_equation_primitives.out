from fractions import Fraction
import math

def main():
    total_count = 8 * 8
    total_sum_mod_8 = 0
    
    # Iterate over all pairs (x, y) from 1 to 8
    for x in range(1, 9):
        for y in range(1, 9):
            product = x * y
            remainder = product % 8
            total_sum_mod_8 += remainder
            
    result = Fraction(total_sum_mod_8, total_count)
    # Return as reduced fraction string "numerator/denominator" if not integer
    # The problem asks for expected value. Usually a rational number.
    # "Find the expected value".
    # If it's an integer, return "X". If fraction, "a/b".
    if result.denominator == 1:
        return str(result.numerator)
    else:
        return f"{result.numerator}/{result.denominator}"

