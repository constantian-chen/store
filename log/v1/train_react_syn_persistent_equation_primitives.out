from fractions import Fraction

def solve_game_probability():
    """
    Calculates the probability that Ainsley wins the game.
    Game rules:
    - Roll a fair 6-sided die.
    - Ainsley wins if two multiples of 3 occur in a row (MM) before a non-multiple followed by a multiple (NM).
    - Multiples of 3: 3, 6 (Prob 0.5).
    - Non-multiples: 1, 2, 4, 5 (Prob 0.5).
    Returns the calculated probability as a formatted string "p_a / p_b" if not integer, or just the integer part if applicable,
    but specifically formatted to return a/b such that result is 100a+b printed in the code, 
    actually function returns the string "104" based on the derivation.
    Actually, let's compute it via simulation/state equations to verify symbolically.
    """
    # Define probabilities
    p_m = Fraction(1, 2)  # Prob of multiple of 3
    p_n = Fraction(1, 2)  # Prob of non-multiple of 3
    
    # Let x be prob A wins starting from state "Previous was M"
    # Let y be prob A wins starting from state "Previous was N"
    # Let s be prob A wins starting from start state
    
    # Equations derived in reasoning:
    # x = p_m * 1 + p_n * y
    # y = p_m * 0 + p_n * y  => y(1-p_n) = 0 => y=0 since p_n != 1
    # s = p_m * x + p_n * y
    
    # Solving y:
    y = Fraction(0, 1)
    
    # Solving x:
    x = p_m * Fraction(1, 1) + p_n * y
    
    # Solving s:
    s = p_m * x + p_n * y
    
    # Format result
    # a/simplified_b
    result_fraction = s
    a = result_fraction.numerator
    b = result_fraction.denominator
    
    # Verify gcd
    # from math import gcd
    # if gcd(a, b) != 1: ... # Fraction handles this
    
    final_answer = 100 * a + b
    return str(final_answer)

solve_game_probability()

