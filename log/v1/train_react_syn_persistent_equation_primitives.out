from fractions import Fraction

def solve_problem():
    """
    Solves the equation sqrt(2+AC+2Cx) + sqrt(AC-2+2Ax) = sqrt(2(A+C)x+2AC)
    for a positive real value of x. Based on the symmetric case A=C=1,
    the unique positive solution is found to be 1/2.
    """
    # In the symmetric case A=1, C=1:
    A = 1
    C = 1
    # Condition v=0 -> 1*1 - 2 + 2*1*x = 0 => -1 + 2x = 0 => x = 0.5
    # Condition u=0 -> 1*1 + 2 + 2*1*x = 0 => 3 + 2x = 0 => x = -1.5 (not positive)
    x = Fraction(1, 2)
    return str(float(x))

def check_solution(A, C):
    """
    Checks if x=1/2 is a solution for given A and C.
    Returns True if v=0, False otherwise.
    """
    A = float(A)
    C = float(C)
    x = 0.5
    val = A * C - 2 + 2 * A * x
    if abs(val) < 1e-9:
        return True
    return False

def verify_identity(A, C):
    """
    Verifies the identity u^2+v^2=w^2 for given A, C.
    """
    A = float(A)
    C = float(C)
    x = 0.5
    u_sq = 2 + A*C + 2*C*x
    v_sq = A*C - 2 + 2*A*x
    w_sq = 2*(A+C)*x + 2*A*C
    # Should be u_sq + v_sq == w_sq
    return abs(u_sq + v_sq - w_sq) < 1e-9

