import math
from fractions import Fraction

def solve_rectangular_prism():
    """
    Calculates the sum of all possible values for the area of the third face 
    of a rectangular prism with integer side lengths, given the smallest face area is 48 
    and the largest is 240.
    
    Returns the sum as a string.
    """
    # Let sides be a <= b <= c
    # Smallest area: ab = 48
    # Largest area: bc = 240
    # Middle area: ac = x
    # From ab=48 and bc=240 => b = 48/a, c = 240/b = 5a
    # x = ac = a * 5a = 5a^2
    # Constraints:
    # 1. a, b, c are integers
    # 2. a <= b <= c
    # From b = 48/a, a must divide 48.
    # From c = 5a, c is integer if a is integer.
    # Condition a <= b: a <= 48/a => a^2 <= 48 => a <= 6 (since a is positive integer)
    # Condition b <= c: 48/a <= 5a => 48 <= 5a^2 => a^2 >= 9.6 => a >= 4
    
    valid_sums = []
    possible_a = [1, 2, 3, 4, 5, 6] # divisors of 48 in range [1, 6]
    
    for a in possible_a:
        if 48 % a != 0:
            continue
        b = 48 // a
        if 48 <= 5 * a * a:
            # Check b <= c
            c = 5 * a
            if b <= c:
                x = a * c
                # Check if x is equal to 48 or 240
                if x != 48 and x != 240:
                    valid_sums.append(x)
    
    total_sum = sum(valid_sums)
    return str(total_sum)

print(solve_rectangular_prism())
