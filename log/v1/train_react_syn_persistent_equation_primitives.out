from fractions import Fraction

def calculate_suit_probability() -> str:
    """
    Calculates the probability that in a 52-card deck:
    1. The second card has a different suit than the first.
    2. The third card has a different suit than the first and second.
    
    Returns:
        The probability as a reduced fraction string "a/b".
    """
    # Initial state
    total_cards = 52
