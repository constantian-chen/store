from fractions import Fraction

def solve_pyramid_paths(num_rows: int) -> str:
    """
    Calculates the number of ways to select one brick from each of the given number of rows
    in a standard triangular pyramid arrangement such that adjacent selected bricks are connected.
    In a pyramid with 'num_rows' rows, the $i$-th row has $i$ bricks.
    Brick $j$ in row $k$ connects to brick $j$ and $j+1$ in row $k+1$.
    This computes the sum of the binomial coefficients C(n, r) for the bottom row, which is 2^(n-1).
    """
    if num_rows <= 0:
        return "0"
    try:
        result = 1 << (num_rows - 1)
        return str(result)
    except Exception:
        return "Error"

def calculate_dp_counts(num_rows: int) -> str:
    """
    Computes the exact number of paths using dynamic programming for validation.
    dp[c] stores the number of ways to reach column c in the current row.
    Returns the total number of ways as a string.
    """
    if num_rows <= 0:
        return "0"
    
    # Initialize for row 1 (1 brick, index 0)
    current_counts = [1]
    
    for r in range(2, num_rows + 1):
        # New row has 'r' bricks (indices 0 to r-1)
        new_counts = [0] * r
        # Brick 0 connects only from previous brick 0
        if len(current_counts) > 0:
            new_counts[0] = current_counts[0]
        for c in range(1, len(current_counts)):
            # Brick c connects from c-1 and c (if they exist)
            ways = 0
            if c < len(current_counts):
                ways += current_counts[c]
            if (c+1) < len(current_counts):
                ways += current_counts[c+1]
            new_counts[c] = ways
        
        # Last brick connects only from the last brick of previous row
        current_counts = new_counts
        
