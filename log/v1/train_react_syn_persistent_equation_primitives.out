def solve_math_problem(n: int) -> str:
    """
    Solves the competition-style math problem for a spider's web.
    Given n distinct leaves equally spaced around a circle, calculates the number of ways
    the spider can make the base layer (a non-crossing Hamiltonian path).
    
    The formula derived is n * 2^(n-2) for n >= 2.
    Uses exact integer arithmetic.
    """
    if n < 2:
        return "0"  # Problem states n > 1
    
    # Formula: n * 2^(n-2)
    # Using pow with integers for exact arithmetic
    result = n * pow(2, n - 2)
    return str(result)

def verify_sequence(n_val: int, expected: int) -> str:
    """
    Verification function to check the formula against known small cases.
    Returns "PASS" if correct, "FAIL" otherwise.
    This is a helper for internal logic, returning a string.
    """
    from math import isclose
    # Not strictly needed for final answer but for structure
    result = n_val * pow(2, n_val - 2)
    if result == expected:
        return "FORMULA_VERIFIED"
    else:
        return f"MISMATCH: {result} != {expected}"

def format_result(n: int) -> str:
    """
    Formats the final result of the computation.
    Returns the expression or value as a string.
    """
    val = n * 2**(n-2)
    return f"n 2^{{n-2}} \text{ (for } n={n}: {val}\text{)}" if n < 6 else f"n 2^{{n-2}} \text{ (for } n={n}: {val}\text{)}"
