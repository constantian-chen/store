def solve():
    # We need to find p such that E[X_t] = a*t + b for all t >= 0.
    # Recurrence: E[X_{t+1}] = k * E[X_t] + p
    # where k = 3*p + (1-p)/2 = (5*p + 1) / 2
    # Solution for E[X_t] given E[X_0] = x0:
    # E[X_t] = k^t * (x0 - p/(1-k)) + p/(1-k)
    # For this to be linear in t (a*t + b), the term k^t must be linear or the coefficient must be 0.
    # 1) If k != 1, k^t is exponential. For E[X_t] to be linear for ANY x0, we must have the coefficient of k^t be 0, 
    #    which requires x0 = p/(1-k). Since x0 is arbitrary, this is not a general solution.
    # 2) If k = 1, E[X_t] = x0 + t*p, which is linear (a=p, b=x0) for ANY x0.
    # Thus, we require k = 1.
    # 5*p + 1 = 2 => 5*p = 1 => p = 1/5.
    
    from sympy import Rational, solve, symbols, Eq
    
    p = symbols('p')
    # Define k
    k_expr = 3 * p + (1 - p) / 2
    # Condition k = 1
    equation = Eq(k_expr, 1)
    solution = solve(equation, p)
    
    if solution:
        p_val = str(solution[0])
        return p_val
    else:
        return "No solution found"

