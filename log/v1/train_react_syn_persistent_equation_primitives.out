from typing import List

# Generate the sequence and count numbers with an even digit sum
def solve_even_digit_sum_count(start: int, end: int, step: int) -> str:
    """
    Counts how many integers in the range [start, end] with step 'step' have an even sum of decimal digits.
    
    Args:
        start (int): The starting integer.
        end (int): The ending integer (inclusive).
        step (int): The common difference between consecutive integers.
        
    Returns:
        str: The count of integers with an even sum of digits.
    """
    count = 0
    current = start
    while current <= end:
        # Calculate sum of digits
        digit_sum = 0
        temp = current
        while temp > 0:
            digit_sum += temp % 10
            temp //= 10
        
        # Check if sum is even
        if digit_sum % 2 == 0:
            count += 1
        
        current += step
    
    return str(count)

def main() -> str:
    """
    Solves the specific problem asked: count terms in {4, 9, 14, ..., 2014} with even digit sum.
    Returns the result as a string.
    """
    result = solve_even_digit_sum_count(4, 2014, 5)
    return result


