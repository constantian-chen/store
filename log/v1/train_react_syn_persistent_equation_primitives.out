from math import sqrt
from fractions import gcd

def get_tau(n):
    """Calculate the number of divisors of n."""
    if n == 1:
        return 1
    tau = 0
    # Optimization: iterate up to sqrt(n)
    i = 1
    while i * i <= n:
        if n % i == 0:
            if i * i == n:
                tau += 1
            else:
                tau += 2
        i += 1
    return tau

def solve_repunit_sum(n):
    """Solve for the given problem constraints."""
    count = 0
    for n_val in range(1, 51):
        d_count = get_tau(n_val)
        if is_square(d_count):
            count += 1
    return str(count)

def is_square(k):
    """Check if k is a perfect square."""
    if k < 0:
        return False
    root = int(sqrt(k))
    return root * root == k

def main():
    """Main function to execute the solution."""
    result = solve_repunit_sum(50)
    return result

