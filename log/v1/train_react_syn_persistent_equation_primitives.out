    # 2(7 - 2y + 3z) - y + 2z = 6
    # 14 - 4y + 6z - y + 2z = 6
    # 14 - 5y + 8z = 6
    # -5y = 6 - 14 - 8z
    # -5y = -8 - 8z
    # 5y = 8 + 8z
    # y = (8 + 8z) / 5
    
    # Substitute y back into x = 7 - 2y + 3z:
    # x = 7 - 2((8 + 8z)/5) + 3z
    # x = (35 - 16 - 16z + 15z) / 5
    # x = (19 - z) / 5
    
    # Calculate 8x + y
    # 8x + y = 8*(19-z)/5 + (8+8z)/5
    # = (152 - 8z + 8 + 8z) / 5
    # = 160 / 5
    
    numerator = 160
    denominator = 5
    result = Fraction(numerator, denominator)
    return str(result)

