from fractions import Fraction

def solve_problem():
    """
    Computes the expected size of the final set after the described process.
    Returns the result as a string representing the irreducible fraction.
    """
    n_initial = 2**8 - 1
    # Sum of sizes of all non-empty subsets of {1..8}
    # Total sum of sizes for 2^8 subsets is 8 * 2^(8-1) = 1024
    # Empty set size is 0, so sum remains 1024.
    s0 = 8 * 2**7
    
    # The expected sum at step t with n items is s_{new} = s_{old} * (n-1)/n
    # Starting n = 255, ending n = 1.
    # Product is 254/255 * 253/254 * ... * 1/2 = 1/255
    expected_value = Fraction(s0, n_initial)
    
    return str(expected_value)

def calculate_initial_sum(n, r):
    """
    Helper to verify the initial sum of sizes for subsets of {1..n} excluding empty.
    n: size of the set
    r: number of subsets to exclude (usually 1 for empty)
    Returns the sum.
    """
    # Total sum for all 2^n subsets is n * 2^(n-1)
    return n * 2**(n-1)

def verify_telescoping(n_start, n_end):
    """
    Verifies the telescoping product (n-1)/n from n_start down to n_end+1.
    """
    product = Fraction(1, 1)
    for k in range(n_start, n_end, -1):
        # Step from k sets to k-1 sets
        product *= Fraction(k-1, k)
    return product

result = solve_problem()
# Verify
