    # Coefficient of x^2: 6a^2 - 2b = 108
    # 2b = 6a^2 - 108
    two_b = 6 * a**2 - 108
    b = two_b // 2
    
    # Coefficient of constant term: (a^2 - b)^2 - c = 9
