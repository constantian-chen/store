[[ #python_codes ## ]]
import math
from functools import reduce
import operator

def compute_sum():
    terms = []
    for m in range(1, 11):
        terms.append(1 / (2*m + 11))
    
    # Use fractions for exact arithmetic
    from fractions import Fraction
    s = Fraction(0, 1)
    for x in terms:
        s += Fraction(1, int(2*x**-1 + 11e-9)) # This is wrong logic
    
    # Correct loop
    denom_list = [2*m + 11 for m in range(1, 11)]
    s = Fraction(0, 1)
    for d in denom_list:
        s += Fraction(1, d)
    
    # Total sum
    total = 1 + 20 * s
    return total

def solve():
    from fractions import Fraction
    s = Fraction(0, 1)
    for m in range(1, 11):
        s += Fraction(1, 2*m + 11)
    total = 1 + 20 * s
    # Return a, b such that total = a/b
    a = total.numerator
    b = total.denominator
    return str(a) + " " + str(b)

# Run the code in a sandbox to get the result
# I will write a function that returns the string "a b"
print(solve())
