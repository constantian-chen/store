from sympy import Integer

def solve_digit_sum_base_change():
    """
    Finds the smallest integer n > 10 such that the sum of digits in base 10
    equals the sum of digits in base 17.
    
    Properties used:
    1. n == S_10(n) (mod 9)
    2. n == S_17(n) (mod 16)
    Therefore n == S (mod 144) where S is the common sum.
    This implies n = 144*k + S.
    Since for n>10, S < n, we have k >= 1.
    Try k=1, n = 144 + S. Iterate S to find the first match.
    """
    def digit_sum(n, base):
        s = 0
        while n > 0:
            s += n % base
            n //= base
        return s

    n = 11
    while True:
        s10 = digit_sum(n, 10)
        s17 = digit_sum(n, 17)
        if s10 == s17:
            return str(n)
        n += 1

def verify_153():
    """
    Explicitly verifies n=153.
    Checks 10s sum, 17s base representation sum, and the modular constraints.
    """
    n = 153
    s10 = sum(int(d) for d in str(n))
    digits_17 = []
    temp = n
    while temp > 0:
        digits_17.append(temp % 17)
        temp //= 17
    s17 = sum(digits_17)
    return str(s10), str(s17), (s10 == s17)

if __name__ == '__main__':
    # The code below is for internal verification and not part of the final output string
    ans = solve_digit_sum_base_change()
    print(ans)
    v1, v2, ok = verify_153()
    print(f"153: 10s sum={v1}, 17s sum={v2}, match={ok}")

