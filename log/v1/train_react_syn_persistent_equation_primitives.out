--- Synthesized Tool Code ---
from typing import Tuple

def find_party_sizes() -> Tuple[int, int]:
    """
    Solves for m (MIT students) and h (Harvard students) based on friendship constraints.
    Returns (m, h) as a tuple.
    """
    # From problem statement:
    # Each MIT student has 16 MIT friends and 8 Harvard friends.
    # Each Harvard student has 7 MIT enemies (so m-7 MIT friends) and 10 Harvard enemies (so h-11 Harvard friends).
    
    # Equation derived from counting MIT-Harvard edges:
    # m * 8 = h * (m - 7)
    # m = 7h / (h - 8)
    # m = 7 + 56 / (h - 8)
    
    # Let k = h - 8. Then h = k + 8 and m = 7 + 56/k.
    # k must be a divisor of 56.
    # Constraints:
    # 1. h >= 11 (since a Harvard student has 10 Harvard enemies, h-1 >= 10)
    # 2. m >= 17 (since an MIT student has 16 MIT friends, m-1 >= 16)
    
    divisors_of_56 = [d for d in range(1, 57) if 56 % d == 0]
    valid_pairs = []
    
    for k in divisors_of_56:
        m = 7 + 56 // k
        h = k + 8
        
        if h >= 11 and m >= 17:
            valid_pairs.append((m, h))
            
    if len(valid_pairs) != 1:
        raise ValueError(f"Expected exactly one solution, found {len(valid_pairs)}: {valid_pairs}")
        
    return valid_pairs[0]

def count_total_friends(m: int, h: int) -> int:
    """
    Calculates the total number of friend pairs given m and h.
    MIT-MIT friends: m * 16 / 2
    MIT-Harvard friends: m * 8
    Harvard-Harvard friends: h * (h - 11) / 2
    """
    mit_mit_friends = (m * 16) // 2
    mit_harvard_friends = m * 8
    harvard_harvard_friends = (h * (h - 11)) // 2
    
    return mit_mit_friends + mit_harvard_friends + harvard_harvard_friends

def solve_hmm_problem() -> str:
    """
    Main function to solve the HMMT party problem.
    Returns the total number of friend pairs as a string.
    """
    m, h = find_party_sizes()
    total_friends = count_total_friends(m, h)
    return str(total_friends)

