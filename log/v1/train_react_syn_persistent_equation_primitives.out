import math
from fractions import Fraction

def solve(N=2015):
    """
    Computes the probability P(X = Y + 1) for N people.
    Returns the reduced fraction as a string "num/den".
    """
    # Numerator: binomial coefficient (2N choose N+1)
    numerator = math.comb(2 * N, N + 1)
    # Denominator: 4^N
    denominator = 4 ** N
    # Use Fraction to automatically reduce to lowest terms
    return f"{Fraction(numerator, denominator).numerator}/{Fraction(numerator, denominator).denominator}"

def verify_logic():
    """
    Verifies the formula for small N (e.g., N=1, 2).
    """
    for n in [1, 2]:
        val = solve(n)
        # Manual check: N=1 -> 1/4, N=2 -> 1/4
    return "verified"

