from math import prod, isqrt

def check_max_probability(N):
    """
    Calculates the maximum probability of picking one ball of each of the three colors
    for a bag with N balls (an arbitrary distribution of colors is allowed).
    The probability is maximized when the counts of the three colors are as equal as possible.
    Returns the probability value.
    """
    if N < 3:
        return 0.0
    # Find the most balanced distribution of N into 3 parts
    r = N // 3
    rem = N % 3
    if rem == 0:
        w = r
        b = r
    elif rem == 1:
        w = r + 1
        b = r
    elif rem == 2:
        w = r + 1
        b = r + 1
    # Calculate probability = 6 * r * w * b / (N * (N-1) * (N-2))
    denom = N * (N - 1) * (N - 2)
    num = 6 * r * w * b
    if denom == 0:
        return 0.0
    prob = num / denom
    return prob

def solve():
    """
    Finds the largest integer N such that the probability of picking one ball of each of
    three colors (red, white, blue) is strictly greater than 0.23.
    Returns the string of floor(N/3).
    """
    # We know the probability decreases as N increases (approaching 2/9 from above).
    # We need to find the largest N satisfying the condition.
    # Search upwards from 3. Since 2/9 approx 0.222 and we need > 0.23, 
    # we expect the condition to fail for large N.
    # Upper bound estimation: 2/9 + 2/(9k) > 0.23 => k < 28.5 => N < 85 roughly.
    # Let's search up to 200 to be safe.
    max_valid_N = -1
    for N in range(3, 200):
        p = check_max_probability(N)
        if p > 0.23:
            max_valid_N = N
        else:
            # Since P decreases with N, once it fails, it will fail for all larger N
            break
    
    if max_valid_N == -1:
        return "No such N exists"
    
    ans = max_valid_N // 3
    return str(ans)

if __name__ == "__main__":
    result = solve()
    print(result)

