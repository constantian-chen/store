from sympy import sqrt, sin, pi, acos, Abs
from fractions import Fraction

def calculate_area_triangle(r, angles_deg):
    """
    Calculate the area of a triangle inscribed in a circle of radius r,
    given the angles of the vertices in degrees.
    The vertices are sorted counter-clockwise.
    """
    angles_rad = sorted([a * pi / 180 for a in angles_deg])
    if sum(angles_rad) >= 3 * pi:
        # Normalize gaps
        sorted_angles = sorted(angles_rad)
        gaps = []
        for i in range(3):
            diff = (sorted_angles[(i+1)%3] - sorted_angles[i]) % (2*pi)
            if diff < 0: diff += 2*pi
            gaps.append(diff)
    else:
        gaps = [angles_rad[i+1] - angles_rad[i] for i in range(2)]
        gaps.append(2*pi - gaps[0] - gaps[1])
    
    area = 0.5 * r**2 * (sin(gaps[0]) + sin(gaps[1]) + sin(gaps[2]))
    return area

