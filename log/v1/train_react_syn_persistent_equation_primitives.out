from fractions import Fraction

def expected_length_mm():
    """
    Calculates the expected length of a random string generated by appending
    'H', 'M', or 'T' with probabilities 1/4, 1/2, 1/4 respectively, until
    'MM' appears consecutively.
    
    Returns:
        str: The expected value as a string.
    """
    # Define probabilities as fractions for exact arithmetic
    p_H = Fraction(1, 4)
    p_M = Fraction(1, 2)
    p_T = Fraction(1, 4)
    
    p_not_M = p_H + p_T  # Probability to get H or T
    # p_not_M is the probability of transitioning from any state (0 or 1) back to state 0
    # except when in state 1 and getting not M, it goes to state 0.
    
    # Let e0 be the expected additional length from state 0 (no trailing M)
    # Let e1 be the expected additional length from state 1 (trailing M)
    # State 2 (MM) is absorbing (0 additional length).
    
    # Equations:
    # e0 = 1 + p_not_M * e0 + p_M * e1
    # e1 = 1 + p_not_M * e0 + p_M * 0
    
    # Rearranging e0:
    # e0 - p_not_M * e0 = 1 + p_M * e1
    # e0 * (1 - p_not_M) = 1 + p_M * e1
    # Note 1 - p_not_M = p_M
    # e0 * p_M = 1 + p_M * e1
    # e0 = 1/p_M + e1
    
    # From e1:
    # e1 = 1 + p_not_M * e0
    
    # Substitute e1 into e0 equation:
    # e0 = 1/p_M + (1 + p_not_M * e0)
    # e0 - p_not_M * e0 = 1/p_M + 1
    # e0 * (1 - p_not_M) = 1/p_M + 1
    # e0 * p_M = 1/p_M + 1
    # e0 = (1/p_M + 1) / p_M = 1/p_M^2 + 1/p_M
    
    # Calculation:
    # p_M = 1/2
    # e0 = 1/(1/2)^2 + 1/(1/2) = 1/(1/4) + 1/(1/2) = 4 + 2 = 6
    
    p_M_val = Fraction(1, 2)
    e0 = (1 / (p_M_val * p_M_val)) + (1 / p_M_val)
    
    return str(int(e0))

