from fractions import Fraction

def solve():
    # Search range [300^2, 301^2]
    start_n = 300**2  # 90000
    end_n = 301**2    # 90601
    
    # Precompute S(90000)
    # S((m+1)^2) = m(m+1)(m+2)/3 with m=300-1=299?
    # No, S(300^2) is sum up to 300^2.
    # Formula: S(N^2) = (N-1)N(N+1)/3
    # For N=300: 299*300*301/3 = 8999900
    S_start = 8999900
    
    for n in range(start_n + 1, end_n + 1):
        # Calculate S(n)
        # n is in (300^2, 301^2]
        m = 300
        # k = n - m^2
        k = n - m*m
        # Sum over interval [m^2, (m+1)^2]
        # f values: 0, 1, ..., m, m-1, ..., 1, 0
        # k ranges 1 to 2m+1 = 601
        if k <= m:
            # First half: 0, 1, ..., k-1
            add = k * (k - 1) // 2
        else:
            # Second half
            # Full first half sum: m(m+1)/2
            full_half = m * (m + 1) // 2
            j = k - m  # Number of terms in second half
            # Right half values: m, m-1, ..., m-j+1
            # Sum = j*m - j(j-1)/2
            add_second = j * m - j * (j - 1) // 2
            add = full_half + add_second
        
        S_n = S_start + add
        
        if S_n == 100 * n:
            return str(n)
    return "No solution found"

def main():
    return solve()

