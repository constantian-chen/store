def solve_fib_sequence():
    """
    Solves the problem of finding the number of sequences a1...a10 of positive integers
    such that a(n+2) = a(n+1) + a(n) and a10 = 2002.
    
    Returns:
        str: The count of such sequences as a string.
    """
    from math import floor
    
    # Coefficients of x and y in a10 = 21x + 34y
    coef_x = 21
    coef_y = 34
    target = 2002
    
    count = 0
    
    # Iterate over possible values of y
    # Since x >= 1, 21x = target - coef_y*y >= 21 => target - coef_y*y >= 21
    # coef_y*y <= target - 21
    max_y = floor((target - 21) / coef_y)
    
    # Check divisibility condition: target - coef_y*y must be divisible by 21
    # target = 2002, coef_y = 34
    # 2002 % 21 = 7
    # 34 % 21 = 13
    # 7 - 13*y = 0 (mod 21) => 13*y = 7 (mod 21) => y = 7 (mod 21)
    
    # Start y at 7 and increment by 21
    y = 7
    while y <= max_y:
        numerator = target - coef_y * y
        if numerator % coef_x == 0:
            x = numerator // coef_x
            if x >= 1: # Ensure positive integer
                count += 1
            else:
                # If x becomes non-positive, larger y will also fail
                break
        y += 21
        
    return str(count)

