from math import gcd

def compute_result():
    # Coefficients of the original polynomial x^3 + 3x - 1 = 0
    # Roots a, b, c satisfy:
    # a+b+c = 0
    # ab+bc+ca = 3
    # abc = 1
    
    # We want S = sum(1/(a^3+b^3))
    # Using a^3 = 1-3a, a^3+b^3 = 2-3(a+b) = 2+3c
    # S = 1/(2+3c) + 1/(2+3a) + 1/(2+3b)
    
    # Let u = 2+3a, v = 2+3b, w = 2+3c.
    # We compute e1, e2, e3 of u, v, w.
    # e1 = 6 + 3(a+b+c) = 6
    # e2 = 12 + 6*0 + 9*3 = 39
    # e3 is found by substituting x = (t-2)/3 into x^3+3x-1=0
    # Resulting polynomial: t^3 - 6t^2 + 39t - 89 = 0
    # So e3 = 89
    
    numerator = 39
    denominator = 89
    
    # Verify gcd
    common = gcd(numerator, denominator)
    if common != 1:
        numerator //= common
        denominator //= common
    
    # Calculate 100m + n
    result = 100 * numerator + denominator
    return str(result)

