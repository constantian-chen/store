from math import factorial

def solve_cycle_counts():
    """
    Calculates the number of 2-regular simple graphs on n labeled vertices (n=8).
    These graphs correspond to partitions of the vertex set into disjoint cycles of length >= 3.
    """
    n = 8
    total = 0
    
    # Case 1: One cycle of length 8
    # Number of Hamiltonian cycles = (n-1)! / 2
    term1 = factorial(n - 1) // 2
    total += term1
    
    # Case 2: Cycles of lengths 5 and 3
    # Choose 5 vertices for the C5: C(8, 5)
    # Ways to form C5: (5-1)! / 2
    # Ways to form C3: (3-1)! / 2
    # Since sizes differ, no division by 2 for component ordering.
    ways_choose_5 = factorial(8) // (factorial(5) * factorial(3))
    ways_c5 = factorial(5 - 1) // 2
    ways_c3 = factorial(3 - 1) // 2
    term2 = ways_choose_5 * ways_c5 * ways_c3
    total += term2
    
    # Case 3: Two cycles of lengths 4 and 4
    # Partition 8 vertices into two sets of 4: C(8, 4) / 2!
