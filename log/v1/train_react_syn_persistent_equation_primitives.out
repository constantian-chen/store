def compute_g(X):
    """
    Computes the number of pairs (a, b) of positive integers such that gcd(a, b) = 1
    and 2*a + 3*b <= X.
    """
    count = 0
    max_a = (X - 3) // 2
    if max_a < 1:
        return 0
        
    for a in range(1, max_a + 1):
        max_b = (X - 2*a) // 3
        if max_b < 1:
            continue
        # Count b in [1, max_b] coprime to a
        # Instead of iterating, we can use inclusion-exclusion or just iterate since X is small
        # Iterating is fine for X=300
