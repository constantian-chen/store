from sympy import sqrt, Rational

def calculate_reflected_points():
    """
    Calculates the coordinates of the reflections of the headquarters (5,1)
    across the lines y=x and x=7.
    Returns tuple (H1, H2) where H1 is reflection over y=x and H2 over x=7.
    """
    hx, hy = Rational(5), Rational(1)
    # Reflection across y=x
    h1 = (hy, hx)
    # Reflection across x=7
    h2 = (7 + (7 - hx), hy)
    return h1, h2

def compute_min_distance(h1, h2):
    """
    Computes the Euclidean distance between two points h1 and h2.
    Returns the distance as a simplified sympy number.
    """
    x1, y1 = h1
    x2, y2 = h2
    dx = x2 - x1
    dy = y2 - y1
    dist = sqrt(dx**2 + dy**2)
    return dist.simplify()

def solve_problem():
    """
    Solves the shortest path problem for the Evil League using the reflection principle.
    Returns the answer as a string.
    """
    h1, h2 = calculate_reflected_points()
    dist = compute_min_distance(h1, h2)
    return str(dist)

