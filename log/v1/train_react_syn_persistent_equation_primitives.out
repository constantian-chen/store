from fractions import Fraction

def compute_varignon_sum(diagonal_ac: int, diagonal_bd: int) -> str:
    """
    Computes the sum of squares of the diagonals of the Varignon parallelogram
    formed by the midpoints of a convex quadrilateral with given diagonals.
    
    The midpoints of a quadrilateral form a parallelogram whose sides are half the lengths
    of the quadrilateral's diagonals. By the parallelogram law, the sum of the squares of
    the diagonals of this new parallelogram is equal to 2 * (side1^2 + side2^2).
    Substituting the side lengths (half the original diagonals), the result is (d1^2 + d2^2) / 2.
    
    Parameters:
        diagonal_ac (int): Length of the first diagonal AC.
        diagonal_bd (int): Length of the second diagonal BD.
        
    Returns:
        str: The computed integer value of MN^2 + PQ^2.
    """
    # Exact arithmetic using fractions first to ensure correctness, then convert to int
    # The formula is (AC^2 + BD^2) / 2
    numerator = diagonal_ac**2 + diagonal_bd**2
    result_fraction = Fraction(numerator, 2)
    
    # The problem implies integer lengths lead to an integer result or specific format.
    # Based on calculation (49+289)/2 = 169, it is an integer.
    result_int = int(result_fraction)
    return str(result_int)

def solve_math_problem() -> str:
    """
    Solves the specific instance of the problem where AC=7 and BD=17.
    Returns the final answer as a string.
    """
    ac_length = 7
    bd_length = 17
    return compute_varignon_sum(ac_length, bd_length)

