import math
from math import sqrt

def solve_rhombus_problem():
    """
    Solves the problem of finding the side length of a larger rhombus
    given that it is similar to a smaller rhombus (area 1), they share a diagonal,
    and the larger rhombus has area 9.
    
    Returns:
        str: The side length of the larger rhombus as a string.
    """
    # Area ratio k^2 = 9/1 = 9 => k = 3
    area1 = 1.0
    area2 = 9.0
    k = math.sqrt(area2 / area1)
    
    # Let diagonals of small rhombus be u, v
    # Area 1 = 0.5 * u * v => u * v = 2
    # Since they are similar and share a diagonal, either u = k*v or v = k*u
    # Assume u = k*v
    # (k*v) * v = 2 => v^2 = 2/k
    # u^2 = k^2 * v^2 = k^2 * (2/k) = 2*k
    
    v_squared = 2 / k
    u_squared = 2 * k
    
    # Diagonals of large rhombus are k*u and k*v
    # Side length s2 = 0.5 * sqrt( (k*u)^2 + (k*v)^2 )
    #               = 0.5 * k * sqrt( u^2 + v^2 )
    # Alternatively, s2 = k * s1 = k * 0.5 * sqrt(u^2 + v^2)
    
    s1_sq = 0.25 * (u_squared + v_squared)
    s1 = math.sqrt(s1_sq)
    s2 = k * s1
    
    # Check with direct calculation using large diagonals
    # Diagonals of large: D1 = k*u, D2 = k*v
    # Area check: 0.5 * D1 * D2 = 0.5 * k^2 * u * v = 0.5 * 9 * 2 = 9. Correct.
    
    return str(s2)

if __name__ == "__main__":
    print(solve_rhombus_problem())

