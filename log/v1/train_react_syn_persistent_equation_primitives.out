    # State F: diff=1, next is EVEN.
    # Even game: Tim wins (prob 1/4) -> diff becomes 2 (MATCH OVER). Allen wins (prob 3/4) -> diff becomes 0.
    # F = 1 + (1/4)*0 + (3/4)*E => F = 1 + (3/4)E
    # Re-evaluate G:
    # State G: diff=-1, next is EVEN.
    # Even game: Tim wins (prob 1/4) -> diff becomes 0. Allen wins (prob 3/4) -> diff becomes -2 (MATCH OVER).
    # G = 1 + (1/4)*E + (3/4)*0 => G = 1 + (1/4)E
    
