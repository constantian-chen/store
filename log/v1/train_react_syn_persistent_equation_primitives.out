def check_palindrome_99(n):
    return str(n) == str(n)[::-1] and n % 99 == 0

def solve_smallest_5digit_palindrome_multiple_of_99():
    # Iterate through all 5-digit palindromes in increasing order
    # Palindrome structure: ab c ba
    # Value: 10000a + 1000b + 100c + 10b + a
    # Loop a from 1 to 9
    # Loop b from 0 to 9
    # Loop c from 0 to 9
    for a in range(1, 10):
        for b in range(0, 10):
            for c in range(0, 10):
                n = 10000 * a + 1000 * b + 100 * c + 10 * b + a
                if check_palindrome_99(n):
                    return str(n)
    return "None found"

def main():
    return solve_smallest_5digit_palindrome_multiple_of_99()

