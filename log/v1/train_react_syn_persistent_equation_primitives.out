[[python_codes ## ]]
from fractions import Fraction

def solve():
    # We are looking for the minimum of sum(x_i^2) / M^2
    # subject to sum(x_i) = 0 and median(x_i) = M.
    # Based on the analysis, the minimum occurs when 50 values are equal to a and 51 values are equal to M.
    # 50*a + 51*M = 0 => a = -51/50 * M.
    # Since a <= M is required for M to be the median (51st value),
    # -51/50 * M <= M. If M > 0, -1.02 <= 1 (True).
    # Sum of squares = 50 * a^2 + 51 * M^2
    # = 50 * (51/50)^2 * M^2 + 51 * M^2
    # = (51^2 / 50) * M^2 + 51 * M^2
    # = 51 * M^2 * (51/50 + 1)
    # = 51 * M^2 * (101/50)
    # = (51 * 101) / 50 * M^2
    # = 5151 / 50 * M^2
    # Thus c = 5151/50.
    numerator = 51 * 101
    denominator = 50
    result = Fraction(numerator, denominator)
    return str(numerator) + "/" + str(denominator)

