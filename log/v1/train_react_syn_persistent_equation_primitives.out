from sympy import symbols, summation, oo, pi, simplify, N

def solve_sequence_limit():
    # Calculate the sum S = sum_{n=3 to infinity} 1/(n^4 - n^2)
    n = symbols('n', integer=True)
    term = 1 / (n**4 - n**2)
    S = summation(term, (n, 3, oo))
    
    # The limit L is given by (8 + 3*S) / 6
    # Note: The constant part from initial conditions leads to 3z + 5z^2 in the numerator at z=1.
    # 3*1 + 5*1 = 8.
    L = (8 + 3 * S) / 6
    
    # Simplify the expression
    L_simplified = simplify(L)
    return str(L_simplified)

def verify_numerically():
    # Verify the convergence numerically
    A = [0, 1, 2]
    for n in range(4, 10000):
        val = (A[-1] + A[-2] + A[-3]) / 3 + 1.0 / (n**4 - n**2)
        A.append(val)
    limit_val = A[-1]
    
    expected = (26 - pi**2) / 12
    return f"Numerical: {limit_val:.6f}, Expected: {float(expected):.6f}"

def compute_final_answer():
    # Exact computation
    from sympy import Rational, Sum, oo
    n = Sum
    # Compute sum
    S = (5/3) - (pi**2)/6 # Precomputed symbolic form
    # Or recompute
    # Let's stick to the symbolic derivation
    return str((26 - pi**2) / 12)

def main_solve():
    # Combines logic to return the final string representation
    # Using sympy for exact arithmetic
    from sympy import symbols, Sum, oo, pi, simplify
    n = symbols('n', integer=True)
    expr = 1/(n**4 - n**2)
    S = Sum(expr, (n, 3, oo))
    L_expr = (8 + 3*S) / 6
    L_val = simplify(L_expr)
    return str(L_val)

