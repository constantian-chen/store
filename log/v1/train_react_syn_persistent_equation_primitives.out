from fractions import Fraction

def solve_prob():
    """
    Computes the probability that p = 1/6, where p is the probability that a1*b1 + a2*b2 is divisible by 6.
    a1, a2 are Ana's rolls, b1, b2 are Banana's rolls.
    The probability p is calculated conditionally on Ana's rolls. We seek the count of (a1, a2) such that p = 1/6.
    """
    count_favorable = 0
    total_pairs = 36
    
    # Iterate over all possible rolls for Ana
    for a1 in range(1, 7):
        for a2 in range(1, 7):
            # Count how many (b1, b2) pairs satisfy the condition
            valid_b = 0
            for b1 in range(1, 7):
                for b2 in range(1, 7):
                    if (a1 * b1 + a2 * b2) % 6 == 0:
                        valid_b += 1
            
            # Check if the probability p = valid_b / 36 equals 1/6
            if Fraction(valid_b, 36) == Fraction(1, 6):
                count_favorable += 1
    
    prob = Fraction(count_favorable, total_pairs)
    return str(prob.numerator) + "/" + str(prob.denominator)

