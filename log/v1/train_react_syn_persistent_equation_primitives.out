from functools import lru_cache

def solve_frobenius_two_largest(coins):
    """
    Finds the two greatest integers that cannot be represented as a non-negative
    integer linear combination of the given coins.
    """
    # Sort coins and remove duplicates to simplify processing
    coins = sorted(list(set(coins)) for coins)
    
    # We will use a BFS-like approach or dynamic programming to find the smallest
    # representable number for each residue modulo the smallest coin.
    # Let m be the smallest coin.
    m = coins[0]
    
    # Initialize min_val[r] to infinity
    min_val = [float('inf')] * m
    
    # 0 is always representable
    min_val[0] = 0
    
    # We perform a relaxation step, similar to Dijkstra's algorithm or BFS.
    # Since edge weights are coins, we can use BFS but we need to handle large gaps.
    # Alternatively, since we only care about residues mod m, we can do a simple iteration
    # or use the fact that we are building from 0.
    # A standard Dijkstra approach on the graph of residues 0..m-1:
    # Nodes are 0..m-1. Edge from u to (u + coin) % m with weight coin.
    # We want shortest path from 0 to each node.
    
    import heapq
    pq = [(0, 0)]  # (current_value, residue)
    min_val[0] = 0
    
    while pq:
        val, r = heapq.heappop(pq)
        
        if val > min_val[r]:
            continue
            
