[[ python_codes ## ]]
def solve():
    from math import factorial
    # Total permutations for n=6
    total = factorial(6)
    # Number of permutations where no student has to pass: 2^(n-1)
    # Derived from pattern where count for n=6 is 32
    safe_count = 2 ** 5
    prob_safe = safe_count / total
    prob_pass = 1 - prob_safe
    # Format as fraction
    from fractions import Fraction
    return str(Fraction(int(prob_pass * total), total))

