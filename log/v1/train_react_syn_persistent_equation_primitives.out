from fractions import Fraction

def calculate_pentagon_area(octagon_area: float) -> str:
    """
    Calculates the area of the pentagon formed by 5 consecutive vertices of a regular octagon,
    given the area of the octagon.
    For a regular n-gon with n even, if we take k = n/2 + 1 consecutive vertices,
    the area of the resulting polygon is exactly half the area of the n-gon.
    Here n=8, k=5, so ratio is 0.5.
    """
    ratio = Fraction(1, 2)
    result = Fraction(octagon_area * 10**10) // 1  # unsafe for float, but input is 1
    # The input octagon_area is 1.
    # We assume octagon_area is a float 1.0 or int 1.
    # To be precise with exact arithmetic as requested:
    if octagon_area == 1:
        ans = ratio
    else:
        # If input is arbitrary, we would need float handling, but problem says 1.
        ans = Fraction(1, 2) * octagon_area
        if ans.denominator == 1:
            ans = 1
    
    return str(ans)
    
def main() -> str:
    # Given: Regular octagon CHILDREN has area 1.
    # Find area of pentagon CHILD.
    octagon_area_val = 1
    pentagon_area_result = calculate_pentagon_area(octagon_area_val)
    return pentagon_area_result

