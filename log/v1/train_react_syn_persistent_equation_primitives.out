from math import gcd

def phi(n):
    """
    Calculated Euler's totient function phi(n).
    Returns the number of positive integers less than or equal to n that are relatively prime to n.
    """
    result = n
    p = 2
    temp = n
    while p * p <= temp:
        if temp % p == 0:
            while temp % p == 0:
                temp //= p
            result -= result // p
        p += 1
    if temp > 1:
        result -= result // temp
    return result

def solve_phi_power_k(n_val, k_val):
    """
    Solves for phi^k(n) where phi^k(n) is the number of integers x in 1 <= x <= floor(n/k)
    such that gcd(x, n) == 1.
    
    Args:
        n_val (int): The number n from the problem n = 2002^2 - 1.
        k_val (int): The exponent k from the problem phi^k(n).
        
    Returns:
        str: The calculated value of phi^k(n).
    """
    # Calculate upper bound m = floor(n/k)
    m = n_val // k_val
    
    count = 0
    # Iterate through 1 to m to count valid x
    # For large n, we can optimize, but here m is small (2003), so direct loop is fine.
    # However, to follow the generic python code requirement, we can use logic derived.
    # But for robustness against variation, a direct loop is safest for this specific instance size.
    for x in range(1, m + 1):
        if gcd(x, n_val) == 1:
            count += 1
            
    return str(count)

def calculate_result():
    """
    Main function to calculate the specific instance of the problem.
    n = 2002^2 - 1, k = 2001.
    Returns the result as a string.
    """
    n = 2002**2 - 1
    k = 2001
    return solve_phi_power_k(n, k)

