def solve_geometry():
    """
    Solves the geometry problem involving intersecting chords in a circle.
    Calculates the perimeter of triangle XYZ given segment lengths.
    Returns the perimeter as a string.
    """
    from fractions import Fraction
    
    # Given lengths
    AX = Fraction(3)
    BX = Fraction(2)
    CY = Fraction(4)
    DY = Fraction(10)
    EZ = Fraction(16)
    FZ = Fraction(12)
    
    # Variables for unknown segments
    # k = XY, m = XZ, n = YZ
    # Equations derived from Power of a Point theorem:
    # 1) Point X: AX * XD = BX * XE
    #    XD = XY + YD = k + DY
    #    XE = XZ + ZE = m + EZ
    #    3*(k+10) = 2*(m+16) => 3k - 2m = 2
    
    # 2) Point Z: BZ * ZE = CZ * ZF
    #    BZ = BX + XZ = 2 + m
    #    CZ = CY + YZ = 4 + n
    #    (2+m)*16 = (4+n)*12 => 4m - 3n = 4
    
    # 3) Point Y: AY * YD = CY * YF
    #    AY = AX + XY = 3 + k
    #    YF = YZ + ZF = n + 12
    #    (3+k)*10 = 4*(n+12) => 5k - 2n = 9
    
    # Solve system
    # From (1): 2m = 3k - 2 => m = 1.5k - 1
    # Sub into (2): 4*(1.5k - 1) - 3n = 4 => 6k - 4 - 3n = 4 => 3n = 6k - 8
    # n = 2k - 8/3
    # Sub into (3): 5k - 2*(2k - 8/3) = 9 => 5k - 4k + 16/3 = 9 => k = 27/3 - 16/3 = 11/3
    
    k = Fraction(11, 3)
    m = Fraction(3, 2) * k - 1
    n = 2 * k - Fraction(8, 3)
    
    # Perimeter
    perimeter = k + n + m
    return str(perimeter)

