    from fractions import Fraction

    # Initial state for column 0
    # x0 = P(T0 reachable) = 1
    # y0 = P(B0 reachable) = 1/2
    # z0 = P(T0 and B0 reachable) = 1/2
    x, y, z = Fraction(1), Fraction(1, 2), Fraction(1, 2)

    # We want sum of (x_k + y_k) for k=0 to infinity
    # The recurrence:
    # x_k = (4x_{k-1} + 2y_{k-1} - z_{k-1}) / 8
    # y_k = (2x_{k-1} + 4y_{k-1} - z_{k-1}) / 8
    # z_k = (2x_{k-1} + 2y_{k-1} - z_{k-1}) / 8

    total = Fraction(11, 4) # x0+y0 = 1 + 0.5 = 1.5 = 15/12? No 1+0.5=1.5. Let's use Fraction.
    # Actually sum starts from k=0.
    # x0+y0 = 1.5.
    total = x + y

    # Iterate until convergence. The matrix has spectral radius < 1?
    # Max eigenvalue?
    # Let's iterate 100 times.
    for _ in range(200):
        x_new = (4*x + 2*y - z) / 8
        y_new = (2*x + 4*y - z) / 8
        z_new = (2*x + 2*y - z) / 8
        
        total += x_new + y_new
        x, y, z = x_new, y_new, z_new

    return str(total)

