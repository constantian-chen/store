import math

def solve_cos_equation():
    '''
    Solves the trigonometric equation 1 + sin(x)/sin(4x) = sin(3x)/sin(2x) for x in (0, 180).
    Returns the sum of all solutions.
    '''
    solutions = []
    # 1. Root from factor (2c-1) => c = 0.5
    c1 = 0.5
    # cos(x) = 0.5 => x = 60 deg in (0, 180)
    if 0 < 60 < 180:
        # Check exclusion x != k*45
        if 60 % 45 != 0: # 60 is not divisible by 45
            solutions.append(60)
            
    # 2. Roots from 8c^3 - 6c - 1 = 0 => cos(3 theta) = 1/2
    # theta values: 20, 140, 260 (cos 260 = cos 100)
    # Distinct cos values correspond to x in (0, 180)
    # cos(x) = cos(20) -> x = 20
    # cos(x) = cos(140) -> x = 140
    # cos(x) = cos(100) -> x = 100
    
    thetas = [20, 140, 100] # These are the principal angles for the cos values in [0, 180]
    for theta in thetas:
        if 0 < theta < 180:
             if theta % 45 != 0:
                solutions.append(theta)
                
    total_sum = sum(solutions)
    return str(total_sum)

def verify_roots():
    '''
    Verifies that the calculated solutions satisfy the equation within tolerance.
    Returns True if all valid.
