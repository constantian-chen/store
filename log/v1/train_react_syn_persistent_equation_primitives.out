    angles = [0, math.pi/3, 2*math.pi/3, math.pi, 4*math.pi/3, 5*math.pi/3]
    
    xs = [0.0]
    ys = [0.0]
    
    for i in range(6):
        s = sides_list[i]
        ang = angles[i]
        x += s * math.cos(ang)
        y += s * math.sin(ang)
        xs.append(x)
        ys.append(y)
        
    # Shoelace formula
    area = 0.0
    for i in range(6):
        j = (i+1) % 6
        area += xs[i] * ys[j] - xs[j] * ys[i]
    area = abs(area) / 2.0
    
    return area

