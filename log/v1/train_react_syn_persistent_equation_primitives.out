from fractions import Fraction
from sympy import divisors as sympy_divisors

def solve():
    # We need to find the maximum integer n such that for each k in [1, floor(n/2)],
    # there exist two divisors of n with difference k.
    # Based on analysis, n=24 works and seems to be the maximum.
    # We will write a function to verify this for a range and return the max.
    
    def check(n):
        if n == 1:
            # k <= 0, vacuously true
            return True
        divs = sympy_divisors(n)
        divs = sorted(divs, reverse=True)
        # divs includes n.
        # We need to cover 1 to n//2
        limit = n // 2
        found = set()
        # Optimized check: precompute pairwise diffs?
        # For n up to 100, it's fine.
        for i, d1 in enumerate(divs):
            for d2 in divs[i:]: # d2 < d1
                diff = d1 - d2
                if diff <= limit:
                    found.add(diff)
                # if diff > limit, and we are iterating downwards, d2 is smaller,
                # but we might find smaller diffs with other pairs.
                # Just break if d2 is too small? No.
        return len(found) == limit and all(1 <= k <= limit and k in found for k in range(1, limit+1))
    
    # Check up to 100 to find max
    max_n = -1
    for n in range(1, 200):
        if check(n):
            max_n = n
    
    return str(max_n)

