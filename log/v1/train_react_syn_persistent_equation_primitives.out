from sympy import factorint, isprime
from math import isqrt

def get_numerator_prime():
    N = 316990099009901
    factors = factorint(N)
    # The problem states N is the product of two distinct primes.
    # So factors should be {p1, p2} with exponents 1.
    # We need the smaller one.
    primes = list(factors.keys())
    # Just in case the factorization finds something else, take the smallest
    # Check if there are exactly two factors
    if len(primes) == 2:
        return str(min(primes))
    elif len(primes) == 1:
        # If only one prime factor, check exponent
        p, exp = primes[0], factors[primes[0]]
        if exp == 1:
            return str(p**exp) # Should be large prime but problem says two
        else:
            return str(None)
    else:
        # Fallback to finding the smallest prime factor
        smallest = None
        for p in primes:
            if smallest is None or p < smallest:
                smallest = p
        return str(smallest)

def calculate_smaller_prime():
    result = get_numerator_prime()
    return result

if __name__ == "__main__":
    # Execute if run directly, but here we just define functions
    pass

