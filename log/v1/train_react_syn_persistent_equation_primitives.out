import math

def calculate_area(a_plus_b, c_prime):
    """
    Calculates the area of the right triangle ABC given the sum of legs (a+b)
    and the hypotenuse c (c_prime).
    
    Parameters:
    a_plus_b (float): The sum of the legs of the right triangle (a + b).
    c_prime (float): The length of the hypotenuse (c).
    
    Returns:
    str: The area of the triangle as a string.
    """
    # We know:
    # 1) a + b = a_plus_b
    # 2) a^2 + b^2 = c_prime^2
    # We want Area = 0.5 * a * b
    # Note that (a+b)^2 = a^2 + b^2 + 2ab
    # So 2ab = (a+b)^2 - (a^2 + b^2) = a_plus_b^2 - c_prime^2
    # Area = 0.5 * ab = 0.25 * (2ab) = 0.25 * (a_plus_b^2 - c_prime^2)
    
    two_ab = a_plus_b**2 - c_prime**2
    area_val = 0.25 * two_ab
    
    # Use exact integer arithmetic if possible, but inputs are numbers
    # Convert to string representation of float or integer
    if area_val.is_integer():
        return str(int(area_val))
    else:
        return str(area_val)

