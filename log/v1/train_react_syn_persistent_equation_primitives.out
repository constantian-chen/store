import sympy as sp
import math

def compute_integral():
    # Define the variable
    theta = sp.symbols('theta')
    
    # Define the integrand
    # Numerator: 2*sin(theta) + 3*cos(theta) - 3
    # Denominator: 13*cos(theta) - 5
    numerator = 2 * sp.sin(theta) + 3 * sp.cos(theta) - 3
    denominator = 13 * sp.cos(theta) - 5
    integrand = numerator / denominator
    
    # Compute the definite integral from 0 to pi
    # The integrand has a removable singularity at theta = acos(5/13), 
    # which sympy should handle correctly with simplify or direct integration.
    # However, direct integration might be tricky due to form.
    # We will use the simplified rational form in terms of t = tan(theta/2) or direct sympy integration.
    # Using sympy's integrate.
    result = sp.integrate(integrand, (theta, 0, sp.pi))
    
    # Simplify the result
    result_simplified = sp.simplify(result)
    
    # Convert to string representation if needed, but returning the expression is standard for sympy functions
    # We need to return a string representation of the exact result.
    return str(result_simplified)

def verify_result():
    # Numerical verification
