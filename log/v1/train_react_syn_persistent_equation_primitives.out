import math

def solve_problem():
    # Calculate the two possible values for the ratio s6/s5
    # Based on derivation:
    # B = 5 + sqrt(17) -> val = (40 + 7*sqrt(17)) / 4
    # B = 5 - sqrt(17) -> val = 10 - 2*sqrt(17)
    
    # Using sympy for exact symbolic representation to ensure precision and form
    # But the requirement says "exact arithmetic", and returning str.
    # Since floats are not exact, we should output the symbolic string representation or exact arithmetic form.
    # However, the instruction "output exactly the requested format/range" and "plain string only" usually expects the mathematical expression or integer.
    # Given the square roots, the expression is the answer.
    
    import sympy as sp
    
    sqrt17 = sp.sqrt(17)
    
    # Case 1
    val1 = (40 + 7*sqrt17) / 4
    # Case 2
    val2 = 10 - 2*sqrt17
    
    # Verify relations
    # s2/s1 = 4, s4/s3 = 2
    # Derived polynomial for B: B^2 - 10B + 8 = 0
    
    # Return the string representation of the two values
    return str(val1) + ", " + str(val2)

# To make it work as a single calculation and verification within the function scope
def main():
    import sympy as sp
    sqrt_17 = sp.sqrt(17)
    val1 = sp.Rational(40, 4) + sp.Rational(7, 1)*sqrt_17 / 4  # (40 + 7*sqrt(17))/4
    val2 = 10 - 2*sqrt_17
    # Simplify val1
    val1_simp = sp.simplify(val1)
    # Format the output string
    return f"{val1_simp}, {val2}"

