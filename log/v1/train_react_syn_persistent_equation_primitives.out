def calculate_f_value():
    """
    Calculates f(-2) based on the solution of the functional equation.
    Equation: 3f(1/x) + 2f(x)/x = x^2
    Derived solution: f(x) = 3/(5x^2) - 2x^3/5
    """
    from fractions import Fraction
    
    x = -2
    # Calculate f(x) = 3/(5x^2) - 2x^3/5 using exact arithmetic
    term1 = Fraction(3, 5) / (x ** 2)
    term2 = Fraction(2, 5) * (x ** 3)
    result = term1 - term2
    return str(result)

def verify_solution(x_val: int) -> str:
    """
    Verifies the functional equation for a specific x value using the derived formula.
    Checks if 3*f(1/x) + 2*f(x)/x equals x^2.
    """
    from fractions import Fraction
    
    x = x_val
    # Derive f(1/x) from the derived formula f(x) = 3/(5x^2) - 2x^3/5
    # f(1/x) = 3/(5(1/x)^2) - 2(1/x)^3/5 = 3x^2/5 - 2/(5x^3)
    f_x = Fraction(3, 5) / (x ** 2) - Fraction(2, 5) * (x ** 3)
    f_1_x = Fraction(3, 5) * (x ** 2) - Fraction(2, 5) / (x ** 3)
    
    lhs = 3 * f_1_x + 2 * f_x / x
    rhs = x ** 2
    
    if lhs == rhs:
        return "1"
    else:
        return "0"

def main():
    ans = calculate_f_value()
    return ans

