--- Synthesized Tool Code ---
from fractions import Fraction
from math import comb

def solve_probability(N=54, Q=4):
    """
    Calculates the probability that the card immediately following the first Queen
    in a shuffled deck of N cards containing Q Queens is also a Queen.
    
    Assumes Q >= 2. If Q < 2, returns 0.
    """
    if Q < 2:
        return "0"
    
    # Total number of ways to choose positions for Queens
    total_outcomes = comb(N, Q)
    
    # Number of favorable ways:
    # The first Queen is at position k, and the second is at k+1.
    # We sum the ways to choose the remaining Q-2 queens from the N-(k+1) positions
    # for all valid k.
    # Sum_{k=1}^{N-Q+1} C(N - 1 - k, Q - 2) = C(N-1, Q-1)
    favorable_outcomes = comb(N - 1, Q - 1)
    
    prob = Fraction(favorable_outcomes, total_outcomes)
    # Simplify is automatic in Fraction, but we want a/b form.
    # The problem asks for the probability. Usually a reduced fraction or decimal.
    # Given the context of "exact arithmetic", fraction is safest if not specified.
    # However, often these problems want the value. Let's return string of fraction.
    return f"{prob.numerator}/{prob.denominator}"

def main_solution():
    ans = solve_probability()
    return ans if ans else "0"

print(main_solution())

