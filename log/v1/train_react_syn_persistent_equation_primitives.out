from collections import defaultdict

def simulate_coin_game(target_tails):
    """
    Simulates the coin flipping game and returns the number of steps taken
    to reach exactly 'target_tails' tails.
    
    Parameters:
    target_tails (int): The target number of tails coins required to stop.
    
    Returns:
    str: The total number of steps taken as a string.
    """
    if target_tails <= 0:
        return "0"
    
    pos = 0
    face = 1  # 1 for positive, -1 for negative
    tails_count = 0
    # Dictionary to store coin states: 'H' (Heads), 'T' (Tails), 'E' (Empty).
    # If a position is not in the dict, it defaults to 'H'.
    # However, 'E' must be stored explicitly because it's a transient state created by picking up.
    coins = defaultdict(lambda: 'H')
    
    steps = 0
    
    while tails_count < target_tails:
        steps += 1
        current_coin = coins[pos]
        
        if current_coin == 'H':
            # Flip to Tails, turn around
            coins[pos] = 'T'
            face = -face
            pos += face
            tails_count += 1
        elif current_coin == 'T':
            # Pick up (becomes Empty)
            coins[pos] = 'E'
            # Direction unchanged
            pos += face
        elif current_coin == 'E':
            # Place Heads up (becomes H)
            coins[pos] = 'H'
            # Direction unchanged
            pos += face
        # Note: If current_coin is something else, it shouldn't happen with this logic
        
    return str(steps)

def main_solve():
    """
    Wrapper function to solve the specific problem instance requested.
    Returns the final answer as a string.
    """
    target = 20
    result = simulate_coin_game(target)
    return result

