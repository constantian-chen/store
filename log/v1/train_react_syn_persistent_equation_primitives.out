--- Synthesized Tool Code ---
def count_representable(n_limit: int) -> str:
    """
    Counts the number of positive integers <= n_limit that can be written as a sum of 
    distinct powers of 3 (i.e., integers whose base-3 representation contains only 0s and 1s).
    """
    # Powers of 3 up to n_limit
    powers = []
    k = 0
    while (3 ** k) <= n_limit:
        powers.append(3 ** k)
        k += 1
    
    # If the largest power is n_limit or less, we might need more if we go beyond n_limit in recursion?
    # Actually, we just need powers that can contribute. 
    # Let's generate a list of powers of 3.
    ps = []
    p = 1
    while p <= n_limit:
        ps.append(p)
        p *= 3
    
    # We will use a recursive backtracking approach to count valid sums <= n_limit.
    # Since n_limit is 1000 and number of powers is small (7), this is fast.
    
    count = 0
    
    def backtrack(index: int, current_sum: int) -> None:
        nonlocal count
        if current_sum > n_limit:
            return
        
        if index == len(ps):
            # We reached sum < n_limit.
            # If current_sum > 0, count it.
            if current_sum > 0:
                count += 1
            return
        
        # Option 1: Skip this power
        backtrack(index + 1, current_sum)
        
        # Option 2: Include this power
        if current_sum + ps[index] <= n_limit:
            backtrack(index + 1, current_sum + ps[index])
    
    backtrack(0, 0)
    return str(count)

def verify_count(n_limit: int) -> str:
    """
    Verification by checking every integer from 1 to n_limit.
    Converts each number to base 3 and checks if digits are only 0 or 1.
    """
    valid_count = 0
    for n in range(1, n_limit + 1):
        temp = n
        is_valid = True
        while temp > 0:
            if temp % 3 != 0 and temp % 3 != 1:
                is_valid = False
                break
            temp //= 3
        if is_valid:
            valid_count += 1
    return str(valid_count)

