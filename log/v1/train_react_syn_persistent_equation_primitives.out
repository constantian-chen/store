    # n-1 = 127
    
    # Modulo 2
    # C(127, j) is odd for all j in 0..127 because 127 = 2^7 - 1
    # Sum is sum_{j=0}^{127} (j+1) % 2
    # This is sum of 1..128 % 2
    # Sum = 128*129/2 = 64*129 = even
    mod2_result = 0
    
    # Modulo 5
    # Lucas theorem on 127 = (1, 2, 2)_5
    # Sum over j0 in 0..2, j1 in 0..2, j2 in 0..1
    # Term: C(2, j0) * C(2, j1) * C(1, j2) * (j0+1)^(j0+j1+j2+1) % 5
