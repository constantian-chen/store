from sympy import factorial, gcd, lcm
from math import isqrt

def calculate_x(n):
    if n == 1:
        return 1
    # Compute x_n = M(1, M(2, ... M(n-1, n)))
    # We compute from inside out: val = M(n-1, n), then M(n-2, val), ... m(1, val)
    val = lcm(n-1, n) // gcd(n-1, n)
    for i in range(n-2, 0, -1):
        val = lcm(i, val) // gcd(i, val)
    return val

def count_n(limit):
    count = 0
    for n in range(2, limit + 1):
        xn = calculate_x(n)
        xn1 = calculate_x(n+1)
        # Check 5*xn^2 + 5*xn1^2 = 26*xn*xn1
        # Equivalent to 5(xn/xn1 + xn1/xn) = 26 <=> xn/xn1 + xn1/xn = 5.2
        # Which implies xn/xn1 = 5 or 1/5
        if xn == 5 * xn1 or xn1 == 5 * xn:
            count += 1
    return count

print(count_n(2021))

