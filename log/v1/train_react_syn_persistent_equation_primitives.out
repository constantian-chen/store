from itertools import combinations

def solve():
    # Define grid coordinates (row, col) for 3x3 grid
    cells = [(r, c) for r in range(3) for c in range(3)]
    
    count = 0
    valid_sets = []
    
    # Check all combinations of 3 cells
    for combo in combinations(cells, 3):
        # Check condition: no two cells share an edge
        is_valid = True
        for i in range(3):
            for j in range(i + 1, 3):
                r1, c1 = combo[i]
                r2, c2 = combo[j]
                # Share an edge if Manhattan distance is 1
                if abs(r1 - r2) + abs(c1 - c2) == 1:
                    is_valid = False
                    break
            if not is_valid:
                break
        
        if is_valid:
            count += 1
            valid_sets.append(combo)
            
    return str(count)

