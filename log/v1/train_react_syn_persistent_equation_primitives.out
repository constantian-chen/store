def solve_xyz():
    from itertools import product
    
    # A12 must be a digit < 10.
    # We iterate over possible digits for A12, B, C, D.
    # Constraints: 10 > A12 > B > C > D > 0.
    # Equation: (1000*A + 100*B + 10*C + D) - (1000*D + 100*C + 10*B + A) == (1000*B + 100*D + 10*A + C)
    
    found_solutions = []
    for A in range(1, 10):
        for B in range(1, A):
            for C in range(1, B):
                for D in range(1, C):
                    # Form numbers
                    num1 = 1000*A + 100*B + 10*C + D
                    num2 = 1000*D + 100*C + 10*B + A
                    target = 1000*B + 100*D + 10*A + C
                    
                    if num1 - num2 == target:
                        found_solutions.append((A, B, C, D))
    
    return found_solutions

result = solve_xyz()
