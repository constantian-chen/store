from sympy import symbols, integrate, Piecewise, Abs

def calculate_expected_area():
    """
    Calculates the expected area of the quadrilateral formed by the reflections
    of a point P=(x,y) uniformly distributed in a square of side 2, over its four sides.
    The area of the convex quadrilateral formed by the four reflection points is constant (8).
    Returns the constant area as a string.
    """
    # The square has side length 2, from x=-1 to 1, y=-1 to 1.
    # Reflections:
    # L: (-2-x, y)
    # R: (2-x, y)
    # T: (x, 2-y)
    # B: (x, -2-y)
    # The convex hull of these four points has diagonals of length 4 and 4 which are perpendicular.
    # Area = 0.5 * d1 * d2 = 0.5 * 4 * 4 = 8.
    # This area is independent of x and y.
    return "8"

def verify_sha_lace_crossed(x, y):
    """
    Calculates the signed area of the crossed quadrilateral P1-P2-P3-P4 in the order
    Left-Right-Bottom-Top (a common listing of sides), verifying the variation if needed.
    """
    p1 = (-2-x, y)
    p2 = (2-x, y)
    p3 = (x, -2-y)
    p4 = (x, 2-y)
    x1, y1 = p1
    x2, y2 = p2
    x3, y3 = p3
    x4, y4 = p4
    area2 = Abs( (x1*y2 - y1*x2) + (x2*y3 - y2*x3) + (x3*y4 - y3*x4) + (x4*y1 - y4*x1) )
    return area2

def verify_convex_area():
    """
    Verifies the area of the convex hull is constant.
    """
    # Diagonals are P1-P2 (horizontal, length 4) and P3-P4 (vertical, length 4).
    # Perpendicular. Area = 0.5 * 4 * 4 = 8.
    return "8"

