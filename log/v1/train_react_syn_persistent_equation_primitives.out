import math

def solve():
    """
    Computes the number of circular arrangements of integers 1 to 100
    such that opposite sums are equal. Returns the result as a string.
    """
    # The formula derived is 49! * 2^49
    factorial_part = math.factorial(49)
    power_of_2 = 1 << 49
    result = factorial_part * power_of_2
    return str(result)

def format_output(ans: str) -> str:
    """
