from math import prod

def solve_prob():
    """
    Calculates the conditional probability that two students who look the same 
    are actually the same person, given the distribution of identical groups.
    Returns a string representation of the reduced fraction.
    """
    # Group sizes: 1, 2, ..., 8
    k_max = 8
    total_students = 0
    favorable_same_look = 0  # Total pairs (A, B) where |A| == |B| in same group, i.e., A and B look same
    same_person_picks = 0    # Total pairs (A, B) where A and B are the same person
    
    # Generate group sizes
    group_sizes = list(range(1, k_max + 1))
    
    # Sum of students
    for k in group_sizes:
        total_students += k
    
    # According to problem, total should be 36.
    # But we calculate based on the input list.
    n = total_students
    
    # Count pairs looking the same: sum of k^2 for each group size k
    for k in group_sizes:
        favorable_same_look += k * k
        
    # Count pairs of same person: n
    same_person_picks = n
    
    # Probability P(E) = favorable_same_look / (n*n)
    # Probability P(F) = same_person_picks / (n*n)
    # P(F|E) = P(F)/P(E) = (n * n^-2 * n) / (favorable_same_look * n^-2 * n) ... 
    # Actually P(F) = n / n^2
    # P(E) = favorable_same_look / n^2
    # Ratio = n / favorable_same_look
    
    # Simplify fraction n / favorable_same_look
    numerator = same_person_picks
    denominator = favorable_same_look
    
    # Reduce fraction
    gcd_val = math.gcd(numerator, denominator)
    
    res_num = numerator // gcd_val
    res_den = denominator // gcd_val
    
    return f"{res_num}/{res_den}"

