from fractions import Fraction
import math

def calculate_rain_probability(n):
    """
    Calculates the probability of rain n days from today given it didn't rain today.
    Recurrence: p_{k+1} = 0.5 * p_k + 0.25
    Analytic solution: p_n = 0.5 - 0.5 / (2^n)
    """
    # Use exact rational arithmetic with Fractions
    # p_n = 1/2 - 1/2^(n+1) = (2^n - 1) / 2^(n+1)
    # Alternatively, just use the formula derived: p_n = 0.5 * (1 - (1/2)^n)
    p_n = Fraction(1, 2) - Fraction(1, 2**(n+1))
    return float(p_n)  # Return float for comparison

def find_smallest_n_threshold(threshold):
    """
    Finds the smallest n such that p_n > threshold.
    Uses the inequality 2^(n+1) > 1 / (0.5 - threshold).
    """
    # p_n = 0.5 - 1/(2^(n+1))
    # p_n > threshold
    # 0.5 - threshold > 1/(2^(n+1))
    # 2^(n+1) > 1 / (0.5 - threshold)
    
    diff = Fraction(1, 2) - Fraction(threshold)
    # We need integer n such that 2**(n+1) > 1/diff
    # => 2**(n+1) >= floor(1/diff) + 1 (since strict inequality)
    # Actually, let's just iterate to be safe with floating point edge cases, 
    # though analytical is clear.
    # For threshold = 0.499, diff = 0.001. 1/diff = 1000.
    # We need 2^(n+1) > 1000.
    
    target = float(1 / float(diff))
    n_plus_1 = 0
    while (2 ** n_plus_1) <= target:
        n_plus_1 += 1
    
    n = n_plus_1 - 1
    return n

def solve_problem():
    """
    Solves the specific problem: find smallest n for p_n > 0.499.
    """
    threshold = 0.499
    n = find_smallest_n_threshold(threshold)
    return str(n)

