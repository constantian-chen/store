from fractions import Fraction

def solve_expected_multiples():
    '''
    Computes the expected number of partial sums S_k = sum(x_i for i in 1..k)
    that are divisible by 6, where x_i are independent uniform random integers from 1 to 6.
    
    Returns:
        str: The exact expected value as a reduced fraction string.
    '''
    n = 100
    mod = 6
    
    # Since the step distribution {1, 2, 3, 4, 5, 6} maps bijectively to {1, 2, 3, 4, 5, 0} mod 6,
    # the position after each step k (for k >= 1) is uniformly distributed over Z/6Z.
    # Therefore, the probability S_k % 6 == 0 is 1/6 for each k from 1 to n.
    
    prob = Fraction(1, mod)
    expected_value = n * prob
    
    return str(expected_value.numerator) + "/" + str(expected_value.denominator)

