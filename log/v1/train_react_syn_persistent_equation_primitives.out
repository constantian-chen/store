from math import gcd

def is_rel_prime(a, b):
    """Returns True if gcd(a, b) == 1, False otherwise."""
    return gcd(a, b) == 1

def count_coprime_less_than(m, n):
    """
    Counts positive integers k such that 1 <= k < m*n and gcd(k, n) == 1.
    This implements the definition of phi_d(n) with d = m.
    Assumes n > 1. If n=1, it counts 1 to m-1, all coprime to 1 (since gcd(k,1)=1).
    But problem context implies standard n>1 behavior.
    """
    if n == 1:
        # For n=1, gcd(k, 1) = 1 for all k. Count numbers in 1..m*n - 1 = m-1.
        return m - 1
    
    # For n > 1, numbers in 1..mn with gcd(k, n)=1 are m * phi(n).
    # Since gcd(mn, n) = n > 1, the range k < mn includes exactly the same coprimes as k <= mn.
    phi_n = sum(1 for k in range(1, n) if is_rel_prime(k, n))
    return m * phi_n

def solve_math_problem():
    """
    Solves the problem:
    Find least n such that phi_x(n) = 64000, where x = phi_y(n) and y = phi(n).
    phi_d(n) is count of k < d*n with gcd(k, n)=1.
    Derived: (phi(n))^3 = 64000 -> phi(n) = 40.
    Find min n such that phi(n) = 40.
    Lower bound n >= 41 since phi(n) < n for n > 1.
    Check n=41.
    """
    target_val = 40
    
    # Check n starting from 1
    # Optimization: loop until found
    n = 1
    while True:
        # Calculate phi(n)
        count = 0
        for k in range(1, n): # range 1 to n-1
            if gcd(k, n) == 1:
                count += 1
        
        # If phi(n) == 40, we found a candidate
        if count == 40:
            # Verify the chain just in case
            y = count
            # x = phi_y(n)
            # d = y. Count k < y*n
            # For n=41, y=40. y*n = 1640.
            # Count k < 1640, gcd(k, 41)=1.
            # 41 is prime. All 1..1639 are coprime.
            x = y * (y if y != 0 else 0) # simplified logic, but let's use function
            # Actually for n=41, phi(41)=40. x = 40*40 = 1600.
            # phi_x(41): count k < 1600*41. 41 is prime. All coprime.
            # Count = 1600 * 40 = 64000. Correct.
            return str(n)
        
        n += 1

if __name__ == "__main__":
