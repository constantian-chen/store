{"code": "from sympy import symbols, cos, sin, pi, solve, simplify, N, sqrt, acos, deg2rad\nA = symbols('A', real=True)\n# Angles in radians\nB_deg = 45\nB2_rad = B_deg / 2 * pi / 180 # 22.5 deg\n# C/2 = (180 - 45 - A_deg)/2 = 67.5 - A/2\n# Equation: cos(A) = 4 * sin(A/2) * sin(22.5) * sin(67.5 - A/2)\n# Note: Argument to cos is A (radians)\n# sin terms take A/2 and 67.5 - A/2 in radians\nA_rad = A\nexpr = cos(A_rad) - 4 * sin(A_rad/2) * sin(B2_rad) * sin(3*pi/8 - A_rad/2) # 67.5 deg = 3*pi/8\nsol = solve(expr, A_rad)\nvalid_A = None\nfor s in sol:\n    val = complex(s)\n    if abs(val.imag) < 1e-6:\n        if 0 < val.real < pi:\n            valid_A = s\n            break\nif valid_A:\n    # Calculate C\n    C_rad = 3*pi/4 - valid_A\n    cos_C = cos(C_rad)\n    print(f\"Valid A (rad): {N(valid_A)}\")\n    print(f\"Valid A (deg): {N(valid_A * 180/pi)}\")\n    print(f\"cos(C): {cos_C}\")\n    print(f\"Simplified cos(C): {simplify(cos_C)}\")\n    # Check against (2 - sqrt(2))/2\n    target = (2 - sqrt(2))/2\n    diff = simplify(cos_C - target)\n    print(f\"Difference from target: {diff}\")"}

