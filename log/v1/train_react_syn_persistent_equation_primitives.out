from functools import reduce
import operator

def compute_product(a_list):
    """
    Computes the product P = product_{i=1 to 6} (a[i]-a[(i+1)%6]) / (a[(i+2)%6]-a[(i+3)%6])
    assuming 1-based indexing logic mapped to 0-based list.
    Returns '1' or '-1' or 'undefined' or error string.
    """
    n = len(a_list)
    if n != 6:
        return "Invalid length"
    
    # Check for zeros in denominators
    denom_ok = True
    for i in range(6):
        u = a_list[(i+2)%6]
        v = a_list[(i+3)%6]
        if u == v:
            denom_ok = False
            break
    
    if not denom_ok:
        return "Undefined division"
        
    numer = 1
    denom = 1
    
    for i in range(6):
        u = a_list[i]
        v = a_list[(i+1)%6]
        numer *= (u - v)
        
        u2 = a_list[(i+2)%6]
        v2 = a_list[(i+3)%6]
        denom *= (u2 - v2)
        
    if denom == 0:
        return "Zero denominator"
        
    # Since we expect 1 or -1, check equality
    if numer == denom:
        return "1"
    elif numer == -denom:
        return "-1"
    else:
        return f"{numer / denom}"

def solve_min_product():
    """
    Generates all permutations of 1..6 and finds the minimum product.
    """
    import itertools
    target_list = list(range(1, 7))
    min_val = None
    
