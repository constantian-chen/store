from sympy import Point, Line, simplify

def solve_rectangle_intersection():
    """
    Solves the geometry problem for the rectangle ABCD with AB=6, BC=4.
    Finds the length of BG where G is the intersection of DF and BC,
    F is on AE halfway between AB and CD, and E is on BC with BE=3.
    """
    # Case 1: AB is vertical (A=(0,6), B=(0,0), C=(4,0), D=(4,6))
    A1 = Point(0, 6)
    B1 = Point(0, 0)
    C1 = Point(4, 0)
    D1 = Point(4, 6)
    
    # E on BC with BE=3. B=(0,0), C=(4,0). Vector BC is (4,0). Unit vector (1,0).
    # E = B + 3 * unit_vector = (3, 0)
    E1 = Point(3, 0)
    
    # Line AE
    line_AEs_1 = Line(A1, E1)
    
    # F is on AE, halfway between AB and CD.
    # AB is x=0, CD is x=4. Halfway x=2.
    F_x = 2
    F_y = line_AEs_1.eval(F_x)
    F1 = Point(F_x, F_y)
    
    # Line DF
    line_DFs_1 = Line(D1, F1)
    
    # Line BC is y=0 (x-axis)
    line_BCs_1 = Line(B1, C1)
    
    # Intersection G
    G1 = line_DFs_1.intersection(line_BCs_1)[0]
    
    # Distance BG
    dist_BG_1 = (G1.distance(B1)).evalf()
    
    # Case 2: AB is horizontal (A=(6,0), B=(0,0), C=(0,4), D=(6,4))
    A2 = Point(6, 0)
    B2 = Point(0, 0)
    C2 = Point(0, 4)
    D2 = Point(6, 4)
    
    # E on BC with BE=3. B=(0,0), C=(0,4). E=(0,3)
    E2 = Point(0, 3)
    
    # Line AE
    line_AEs_2 = Line(A2, E2)
    
    # F is on AE, halfway between AB (y=0) and CD (y=4). Halfway y=2.
    F_y2 = 2
    F_x2 = line_AEs_2.eval(F_y2)
    F2 = Point(F_x2, F_y2)
    
    # Line DF
    line_DFs_2 = Line(D2, F2)
    
    # Line BC is x=0 (y-axis)
    line_BCs_2 = Line(B2, C2)
    
    # Intersection G
    G2 = line_DFs_2.intersection(line_BCs_2)[0]
    
    # Distance BG
    dist_BG_2 = (G2.distance(B2)).evalf()
    
    return str(int(dist_BG_1))

