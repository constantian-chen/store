from math import comb
from fractions import Fraction

def solve_probability():
    """
    Calculates the probability that a randomly selected set of 5 numbers from
    the first 15 positive integers has a sum divisible by 3.
    
    Returns:
        str: The probability as a reduced fraction string "numerator/denominator".
    """
    n_total_elements = 15
    k = 5
    remainder_counts = [0, 0, 0]
    
    # Classify numbers 1 to 15 mod 3
    for i in range(1, n_total_elements + 1):
        remainder_counts[i % 3] += 1
        
    # Count favorable subsets by iterating through possible counts of each remainder
    favorable = 0
    # Iterate k0 (count of remainder 0), k1 (count of remainder 1), k2 (count of remainder 2)
    for k0 in range(k + 1):
        for k1 in range(k - k0 + 1):
            k2 = k - k0 - k1
            
            # Check if valid selection counts (cannot exceed available)
            if k0 > remainder_counts[0]: continue
            if k1 > remainder_counts[1]: continue
            if k2 > remainder_counts[2]: continue
            
            # Check sum condition: 0*k0 + 1*k1 + 2*k2 = 0 mod 3
            if (k1 + 2 * k2) % 3 != 0:
                continue
            
            # Calculate ways to choose
            ways = comb(remainder_counts[0], k0) * comb(remainder_counts[1], k1) * comb(remainder_counts[2], k2)
            favorable += ways
            
    total_ways = comb(n_total_elements, k)
    prob_frac = Fraction(favorable, total_ways)
    return f"{prob_frac.numerator}/{prob_frac.denominator}"

