def solve_alternating_sum():
    """
    Computes the sum of the alternating series of squares:
    100^2 + 99^2 - 98^2 - 97^2 + ... + 4^2 + 3^2 - 2^2 - 1^2.
    The series consists of 25 groups of 4 consecutive integers squared, with signs ++--.
    Returns the result as a string.
    """
    # The number of terms is 100. Each group has 4 terms, so 25 groups.
    num_groups = 100 // 4
    
    total_sum = 0
    # Iterate through each group starting from the largest n (100, 96, ..., 4)
    # The first number in each group is n = 4 * j where j goes from 1 to 25.
    for j in range(1, num_groups + 1):
        n = 4 * j
        # Contribution of the group n^2 + (n-1)^2 - (n-2)^2 - (n-3)^2
        # Derived formula: 8*n - 12
        contribution = 8 * n - 12
        total_sum += contribution
        
    return str(total_sum)

