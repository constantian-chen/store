        a = k // 10
        b = k % 10
        
        # Condition a != 0
        if a == 0:
            continue
            
        # Reconstruct number to ensure format matches exactly
        reconstructed = 1010 * a + 101 * b
        if reconstructed == val:
            solutions.append(str(val))
            
    return ", ".join(solutions)

