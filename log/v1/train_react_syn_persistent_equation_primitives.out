import math

def is_feared(num: int) -> bool:
    """
    Check if a number is 'feared' (contains the substring '13').
    """
    return '13' in str(num)

def find_min_n() -> str:
    """
    Compute the smallest positive integer n such that there exists a positive integer a < 100
    where n and n + 10a are fearless, and n + a, n + 2a, ..., n + 9a are all feared.
    """
    # We know from reasoning that n=1290, a=11 is a candidate.
    # Let's verify this and search downwards to ensure minimality.
    
    # Search range for n: 1 to 2000 (based on analysis)
    # Search range for a: 1 to 99
    
    for n in range(1, 2000):
        if is_feared(n):
            continue
        
        for a in range(1, 100):
            # Check n + 10a
            if is_feared(n + 10 * a):
                continue
            
            # Check intermediate terms
            all_feared = True
            for k in range(1, 10):
                val = n + k * a
                if not is_feared(val):
                    all_feared = False
                    break
            
            if all_feared:
                return str(n)
    
    return "No solution found in range"

