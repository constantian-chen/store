def solve_1_over_998():
    N = 998
    m = 499
    # Find order of 10 mod 499
    L = 1
    cur = 10
    while cur != 1 % m:
        cur = (cur * 10) % m
        L += 1
    # Generate periodic remainders r_1, ... r_L
    # r_k = 10^k % N
    P = []
    cur_r = 10 % N
    for i in range(L):
        P.append(cur_r)
        cur_r = (cur_r * 10) % N
    
    # We need digits at positions 9998, 9999, 10000
    # d_k derived from r_{k-1}
    # r sequence for k>=1 is P[0], P[1], ... with period L
    # r_{k-1} for k=9998 is r_{9997}. Index in P: (9997 - 1) % L = 9996 % L
    
    idx1 = 9996 % L
    idx2 = 9997 % L
    idx3 = 9998 % L
    
    r1 = P[idx1]
    r2 = P[idx2]
    r3 = P[idx3]
    
    d1 = (10 * r1) // N
    d2 = (10 * r2) // N
    d3 = (10 * r3) // N
    
    return f"{d1}{d2}{d3}"

def verify_order():
    # Just to ensure L is correct
    m = 499
    k = 1
    val = 10
    while val != 1 % m:
        val = (val * 10) % m
        k += 1
    return k

if __name__ == '__main__':
    print(verify_order())


