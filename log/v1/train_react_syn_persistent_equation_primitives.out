def solve():
    """
    Calculates the value 10000p where p is the probability that at least one number
    from 1 to 10 is not selected by any of four people, each selecting 5 consecutive numbers.
    """
    # Total number of outcomes
    total_outcomes = 10**4
    
    # We derived that the condition "not everything is selected" is equivalent to
    # the starting positions being clusterable within an arc of 5 points (gaps >= 6).
    # We counted the number of valid ordered tuples (x1, x2, x3, x4) where the sorted
    # gaps contain a maximum of 6 or 7.
    
    # Type A: Permutations of (7, 1, 1, 1)
    # g4 values: 1, 1, 1, 7 -> sum = 10
    sum_g4_type_a = 10
    
    # Type B: Permutations of (6, 2, 1, 1)
    # g4 values distribution:
    # Ends in 6: 3 permutations, weight 6 -> 18
    # Ends in 2: 3 permutations, weight 2 -> 6
    # Ends in 1: 6 permutations, weight 1 -> 6
    # Sum = 30
    sum_g4_type_b = 30
    
    total_sum_g4 = sum_g4_type_a + sum_g4_type_b
    favorable_tuples = total_sum_g4 * 24 # 24 is 4!
    
    # Probability p
    p = favorable_tuples / total_outcomes
    
    # Return 10000 * p
    return str(int(10000 * p))

print(solve())

