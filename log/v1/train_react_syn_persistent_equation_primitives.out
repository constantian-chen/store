from fractions import Fraction

def compute_fibonacci_sum():
    """
    Computes the infinite sum sum_{n=1 to infinity} Fib_n / 4^(n+1)
    where Fib_1 = 1, Fib_2 = 1, Fib_{n+2} = Fib_{n+1} + Fib_n.
    
    Returns:
        str: The exact reduced fraction representing the sum.
    """
    # The generating function for Fibonacci numbers is G(x) = x / (1 - x - x^2)
    # We need to compute (1/4) * G(1/4)
    # x = 1/4
    # G(1/4) = (1/4) / (1 - 1/4 - 1/16)
    
    x = Fraction(1, 4)
    numerator_g = x
    denominator_g = 1 - x - x*x
    
    val_g = numerator_g / denominator_g
    result = val_g * Fraction(1, 4)
    
    return str(result)

