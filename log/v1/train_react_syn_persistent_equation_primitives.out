from itertools import product

def count_valid_pairs_sum_mod_k(tuple_values, k):
    """
    Counts pairs (a, b) where a and b are chosen from tuple_values such that (a+b) % k == 0.
    Args:
        tuple_values (tuple): Tuple of possible values for each element.
        k (int): Modulus.
    Returns:
        int: Count of valid pairs.
    """
    count = 0
    for val_a in tuple_values:
        for val_b in tuple_values:
            if (val_a + val_b) % k == 0:
                count += 1
    return count

def solve_math_problem():
    """
    Solves the problem: Count 4-digit multiples of 11 with digit sum divisible by 11.
    Returns the integer result as a string.
    """
    # Digits for positions 2 and 0 (d2, d0) can be 0-9
    digits_0_9 = tuple(range(10))
    # Count pairs (d2, d0) such that sum is divisible by 11
    count_sub1 = count_valid_pairs_sum_mod_k(digits_0_9, 11)
    
    # Digits for position 3 (d3) can be 1-9, position 1 (d1) can be 0-9
    digits_1_9 = tuple(range(1, 10))
    # We need number of pairs (d3, d1) such that sum is divisible by 11
    # And we iterate d3 from digits_1_9 and d1 from digits_0_9
    count_sub2 = 0
    for d3 in digits_1_9:
        for d1 in digits_0_9:
            if (d3 + d1) % 11 == 0:
                count_sub2 += 1
    
    total = count_sub1 * count_sub2
    return str(total)

