from math import gcd
from fractions import Fraction

def solve_probability():
    """
    Calculates the probability that the lowest number appearing on any of four
    fair six-sided dice is exactly 3.
    
    Returns:
        str: The probability as a reduced fraction string "numerator/denominator".
    """
    num_dice = 4
    max_face = 6
    
    # Total possible outcomes
    total_outcomes = max_face ** num_dice
    
    # Outcomes where all dice are >= 3
    # Possible faces: 3, 4, 5, 6 (4 options)
    outcomes_min_ge_3 = 4 ** num_dice
    
    # Outcomes where all dice are >= 4
    # Possible faces: 4, 5, 6 (3 options)
    outcomes_min_ge_4 = 3 ** num_dice
    
    # Favorable outcomes where min is exactly 3
    favorable_outcomes = outcomes_min_ge_3 - outcomes_min_ge_4
    
    # Create fraction and reduce using Fraction class
    prob = Fraction(favorable_outcomes, total_outcomes)
    
    return f"{prob.numerator}/{prob.denominator}"

