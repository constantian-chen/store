        # If edge (1,2): non-edges 0.
        # If no edge: non-edge (1,2). Common neighbors 0.
        return "0"
    
    # Formula: (n-1)(n-2)/2
    # Using integer arithmetic
    result = (n - 1) * (n - 2) // 2
    return str(result)

def verify_formula(n_str: int) -> str:
    """
