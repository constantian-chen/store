{"""
import math
from sympy import symbols, solve, Eq, sqrt, Matrix, simplify

# Coordinates
A = (0, 0)
B = (2, 0)
C = (1, sqrt(3))

def get_parabola_intersections(focus, directrix_points1, directrix_points2):
    # Focus
    f_s, f_y = focus
    # Directrix line points
    d1, d2 = directrix_points1, directrix_points2
    # Line equation of directrix: ax + by + c = 0
    # Slope m = (d2[1]-d1[1])/(d2[0]-d1[0])
    denom = d2[0] - d1[0]
    if denom == 0:
        # Vertical line
        m_def = 1000 # placeholder
    else:
        m_def = (d2[1] - d1[1]) / denom
    # y - d1[1] = m (x - d1[0]) => m*x - y + (d1[1] - m*d1[0]) = 0
    # Normalize: sqrt(a^2+b^2) factor? Distance formula uses |Ax+By+C|/sqrt(A^2+B^2)
    # Let's use Ax + By + C = 0 form directly.
    # m*x - y + C = 0
    a_eq = m_def
    b_eq = -1
    c_eq = d1[1] - m_def*d1[0]
    
    # Normalize by sqrt(a^2+b^2) for distance? 
    # Distance is |ax+by+c| / sqrt(a^2+b^2)
    norm = sqrt(a_eq**2 + b_eq**2)
    
    def dist_to_directrix(x, y):
        return abs(a_eq*x + b_eq*y + c_eq) / norm
    
    def dist_to_focus(x, y):
        return sqrt((x-f_s)**2 + (y-f_y)**2)
    
    # Parabola eq: dist_to_focus = dist_to_directrix
    # 4(x^2 + y^2) = (a*x + b*y + c)^2? No, norm^2 = m^2 + 1 = (d2[1]-d1[1])^2/(d2[0]-d1[0])^2 + 1
    # Actually, (a*x+b*y+c)^2 / norm^2 = x^2+y^2
    # (a*x+b*y+c)^2 = norm^2 * (x^2+y^2)
    # norm^2 = 1/(cos^2 + sin^2) ? No.
    # a = m, b = -1. norm^2 = m^2 + 1 = ((d2y-d1y)^2 + (d2x-d1x)^2) / (d2x-d1x)^2
    # Let L2 = length of directrix segment? No.
    
    # Simplify: The directrix line is ax+by+c=0.
    # Distance d = |ax+by+c| / sqrt(a^2+b^2).
    # Eq: (sqrt((x-fx)^2+(y-fy)^2)) * sqrt(a^2+b^2) = |ax+by+c|
    # Square: (a^2+b^2) * ((x-fx)^2+(y-fy)^2) = (ax+by+c)^2
    
    eq_a2 = a_eq**2 + b_eq**2
    x, y = symbols('x y')
    eq_parabola = Eq(eq_a2 * ((x-f_s)**2 + **(y-f_y)2), (a_eq*x + b_eq*y + c_eq)**2)
    
    # Intersect with side AB: y=0, 0 <= x <= 2
    res_AB = solve(eq_parabola.subs(y, 0), x)
    valid_AB = []
    for r in res_AB:
        if r.is_real:
            rv = float(r.evalf())
            if 0 <= rv <= 2:
                valid_AB.append(rv)
    
    # Intersect with side AC: line through (0,0) and (1, sqrt(3)) => y = sqrt(3)x
    # x in [0, 1]
    valid_AC = []
    for r in res_AB: # reusing solver, just substitute
        pass
    # Solve for y = sqrt(3)x
    eq_ac = eq_parabola.subs(y, sqrt(3)*x)
    res_AC = solve(eq_ac, x)
    for r in res_AC:
        if r.is_real:
            rv = float(r.evalf())
            if 0 <= rv <= 1:
                valid_AC.append(rv)
                
    # Intersect with side BC: line through (2,0) and (1, sqrt(3)) => y = -sqrt(3)(x-2)
    # x in [1, 2]
    eq_bc = eq_parabola.subs(y, -sqrt(3)*(x-2))
    res_BC = solve(eq_bc, x)
    valid_BC = []
    for r in res_BC:
        if r.is_real:
            rv = float(r.evalf())
            if 1 <= rv <= 2: # Note: B is 2, C is 1. Range [1,2]
                valid_BC.append(rv)
                
    # Collect points
    pts = []
    if valid_AB:
        pts.append((float(valid_AB[0]), 0))
    if valid_AC:
        pts.append((float(valid_AC[0]), sqrt(3)*float(valid_AC[0])))
    if valid_BC:
        pts.append((float(valid_BC[0]), -sqrt(3)*(float(valid_BC[0])-2)))
        
    return pts

# Get points for A (focus A, directrix BC)
# Focus A, Directrix BC
p_A = get_parabola_intersections(A, B, C)
# p_A should have 2 points: A1 on AB, A2 on AC
A1 = simplify(Matrix(p_A[0]))
A2 = simplify(Matrix(p_A[1]))

# Get points for B (focus B, directrix CA)
p_B = get_parabola_intersections(B, C, A)
# B1 on BC, B2 on BA (which is AB, y=0)
B1 = simplify(Matrix(p_B[0])) # Order might differ, check logic
B2 = simplify(Matrix(p_B[1]))

# Get points for C (focus C, directrix AB)
p_C = get_parabola_intersections(C, A, B)
# C1 on CA, C2 on CB
C1 = simplify(Matrix(p_C[0]))
C2 = simplify(Matrix(p_C[1]))

# Function to get line from two points
def line_from_pts(p1, p2):
    x, y = symbols('x y')
    a = p1[1] - p2[1]
    b = p2[0] - p1[0]
    c = a*p1[0] + b*p1[1]
    return Eq(a*x + b*y + c, 0)

L_A = line_from_pts(A1, A2)
L_B = line_from_pts(B1, B2)
L_C = line_from_pts(C1, C2)

# Convert lines to forms ax+by+c=0 for solving
# L_A: already ax+by+c=0
# Solve intersections
# Intersection of L_A and L_B
sol_AB = solve((L_A, L_B), (symbols('x'), symbols('y')))
P_AB = sol_AB[symbols('x')].evalf(), sol_AB[symbols('y')].evalf()

sol_BC = solve((L_B, L_C), (symbols('x'), symbols('y')))
P_BC = sol_BC[symbols('x')].evalf(), sol_BC[symbols('y')].evalf()

sol_CA = solve((L_C, L_A), (symbols('x'), symbols('y')))
P_CA = sol_CA[symbols('x')].evalf(), sol_CA[symbols('y')].evalf()

# Calculate side lengths
d1 = (P_AB[0]-P_BC[0])**2 + (P_AB[1]-P_BC[1])**2
d2 = (P_BC[0]-P_CA[0])**2 + (P_BC[1]-P_CA[1])**2
d3 = (P_CA[0]-P_AB[0])**2 + (P_CA[1]-P_AB[1])**2

sides = [sqrt(d1), sqrt(d2), sqrt(d3)]
total_perim = sum(sides)

print(f"A1: {A1}, A2: {A2}")
print(f"B1: {B1}, B2: {B2}")
print(f"C1: {C1}, C2: {C2}")
print(f"Lines: {L_A}, {L_B}, {L_C}")
print(f"Intersections: {P_AB}, {P_BC}, {P_CA}")
print(f"Sides: {sides}")
print(f"Perimeter: {total_perim}")

exact_sides = [simplify(sqrt(d1).evalf()), simplify(sqrt(d2).evalf()), simplify(sqrt(d3).evalf())]
print(f"Exact sides: {exact_sides}")
exact_perim = simplify(sqrt(d1) + sqrt(d2) + sqrt(d3))
print(f"Exact perimeter: {exact_perim}")
        """}

