from sympy import Matrix, Rational, simplify

def calculate_areas_and_ratio():
    # Define the transformation matrices for D and E points
    # Vertices are expressed as linear combinations of A1, A2, A3
    
    # Matrix for D points
    # Row i corresponds to Di, cols are coefficients of A1, A2, A3
    mat_D_lower = Matrix([
        [3, 3, 1],
        [1, 3, 3],
        [3, 1, 3]
    ])
    det_D_lower = mat_D_lower.det()
    factor_D = Rational(1, 7)**3
    area_ratio_D = simplify(factor_D * det_D_lower)
    
    # Matrix for E points
    mat_E_lower = Matrix([
        [3, 1, 1],
        [1, 3, 1],
        [1, 1, 3]
    ])
    det_E_lower = mat_E_lower.det()
    factor_E = Rational(1, 5)**3
    area_ratio_E = simplify(factor_E * det_E_lower)
    
    # Calculate the ratio of area(D) to area(E)
    final_ratio = simplify(area_ratio_D / area_ratio_E)
    
    # Return the result as a string "a/b"
    if final_ratio.is_integer:
        return str(int(final_ratio))
    else:
        num = final_ratio.numerator
        den = final_ratio.denominator
        return f"{num}/{den}"

