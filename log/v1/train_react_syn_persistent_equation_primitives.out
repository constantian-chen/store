def solve_polynomial_problem():
    """
    Computes P(2) given Q(x) = x**2 + 2*x + 3 and P(Q(x)) = x**6 + 6*x**5 + 18*x**4 + 32*x**3 + 35*x**2 + 22*x + 8.
    The strategy is to substitute x = u - 1 where u^2 = Q(x) - 2, expand the polynomial in terms of u,
    then express it in terms of y = u^2 + 2 to find P(y), and finally evaluate at y=2.
    """
    # Define the polynomial RHS in terms of u (where x = u - 1)
    # R(u) = (u-1)^6 + 6(u-1)^5 + 18(u-1)^4 + 32(u-1)^3 + 35(u-1)^2 + 22(u-1) + 8
    
    # We derived by hand that R(u) = u^6 + 3u^4 + 2u^2 + 2
    # Let's verify this with symbolic expansion to be absolutely sure
    
    import sympy as sp
    
    u = sp.symbols('u')
    expr = (u - 1)**6 + 6 * (u - 1)**5 + 18 * (u - 1)**4 + 32 * (u - 1)**3 + 35 * (u - 1)**2 + 22 * (u - 1) + 8
    
    # Expand the expression
    expanded_expr = sp.expand(expr)
    
    # We expect this to be u^6 + 3*u^4 + 2*u^2 + 2
    # Let's construct the polynomial in terms of y = u^2 + 2
    y = sp.symbols('y')
    # u^2 = y - 2
    # u^4 = (y-2)^2
    # u^6 = (y-2)^3
    
    # Substitute u^2 with (y-2) in the expanded polynomial?
    # No, the polynomial is even in u, so we have terms u^6, u^4, u^2, u^0.
    # We can just replace u**2 with (y-2). But we need to handle the powers correctly.
    # Since there are no odd powers of u, we can safely substitute u**2 = y-2 everywhere.
    
    # However, direct substitution of powers:
    # u**6 -> (y-2)**3
    # u**4 -> (y-2)**2
    # u**2 -> (y-2)
    # 1 -> 1
    
    R_in_terms_of_y = expanded_expr.subs(u**2, y - 2)
    # The substitution u**2 -> y-2 automatically handles u**4 -> (y-2)**2 and u**6 -> (y-2)**3 because
    # (u**2)**2 = u**4 -> (y-2)**2, etc.
    
    P_y = sp.expand(R_in_terms_of_y)
    
    # Now evaluate P(2), which means setting y = 2
    result = P_y.subs(y, 2)
    
    return str(int(result))

