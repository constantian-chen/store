from sympy import symbols, solve, Rational

def find_smallest_radius_sq():
    """
    Solves the problem of finding the smallest squared radius of a sphere 
    with integer coordinates center passing through (2,0,0), (0,4,0), (0,0,6) 
    but not (0,0,0).
    
    Returns the minimum r^2 as a string.
    """
    # Define integer parameter m
    m = symbols('m', integer=True)
    
    # Expressions for center coordinates based on derivation:
    # l = 2m + 1
    # k = 3m - 1
    # h = 6m - 5
    l_expr = 2 * m + 1
    k_expr = 3 * m - 1
    h_expr = 6 * m - 5
    
    # Calculate r^2 as distance squared from center to (2,0,0)
    # r^2 = (h-2)^2 + k^2 + l^2
    r2_expr = (h_expr - 2)**2 + k_expr**2 + l_expr**2
    r2_simplified = r2_expr.expand()
    
    # Condition for passing through origin: h^2 + k^2 + l^2 = r^2
    # So we check if r2_expr == h_expr**2 + k_expr**2 + l_expr**2
    dist_origin_sq = h_expr**2 + k_expr**2 + l_expr**2
    cond_eq = r2_expr - dist_origin_sq
    
    # We need to iterate through small integer values of m
    candidates = []
    min_r2_valid = None
    
    # Search range for m. Since quadratic grows, checking neighbors of vertex is enough.
    # Vertex is at m = 86/98 approx 0.88. Check -2 to 5.
    for val in range(-5, 10):
        mh = h_expr.subs(m, val)
        mk = k_expr.subs(m, val)
        ml = l_expr.subs(m, val)
        
        r2_val = r2_simplified.subs(m, val)
        r2_int = int(r2_val)
        
        # Check if sphere passes through origin
        dist_o_int = int(dist_origin_sq.subs(m, val))
        
        if r2_int == dist_o_int:
            continue  # Invalid case
        
        candidates.append((val, r2_int, mh, mk, ml))
        
        if min_r2_valid is None or r2_int < min_r2_valid:
            min_r2_valid = r2_int
            
    return str(min_r2_valid)

