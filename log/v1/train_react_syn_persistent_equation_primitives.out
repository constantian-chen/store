from math import comb

def solve_sum_ijk():
    """
    Computes the sum of i*j*k for all positive integer triples (i,j,k) such that i+j+k=17.
    This corresponds to the coefficient of x^17 in (sum i*x^i)^3.
    sum i*x^i = x/(1-x)^2.
    Cube is x^3 * (1-x)^(-6).
    Coeff of x^17 in x^3*(1-x)^(-6) is coeff of x^14 in (1-x)^(-6).
    Which is binom(6+14-1, 14) = binom(19, 14) = binom(19, 5).
    """
    n = 17
    # Coefficient of x^n in (x/(1-x)^2)^3
    # = Coefficient of x^(n-3) in (1-x)^(-6)
    # = binom(k+6-1, 6-1) where k = n-3
    # k = 14, size = 15? No.
    # Standard form: Coeff of x^k in (1-x)^(-m) is binom(k+m-1, k) or binom(k+m-1, m-1).
    # Here m=6, k=14.
    # binom(14+6-1, 14) = binom(19, 14) = binom(19, 5).
    result = comb(19, 5)
    return str(int(result))

