from sympy import symbols, Eq, solve

def solve_geometry_problem():
    '''
    Solves for the radius r of a circle externally tangent to two circles of diameter 1
    and internally tangent to a circle of diameter 2.
    Setup: 
      - Two small circles of diameter 1 are centered at (-0.5, 0) and (0.5, 0) with radius 0.5.
      - Large circle of diameter 2 is centered at (0, 0) with radius 1.
      - Target circle has radius r and center (0, y) due to symmetry.
    '''
    r = symbols('r')
    # Equation from tangency to small circle
    # (0 - 0.5)^2 + y^2 = (r + 0.5)^2
    # We know x=0 by symmetry.
    # We also know distance to origin is 1-r (internal tangency)
    # So y^2 = (1-r)^2.
    # Substitute y^2 into the first equation.
    
    # 0.25 + (1-r)^2 = (r + 0.5)^2
    # Use fractions for exactness: 1/4 + (1-r)^2 = (r + 1/2)^2
    eq1 = Eq(1/4 + (1 - r)**2, (r + 1/2)**2)
    
    # Solve for r
    solutions = solve(eq1, r)
    
    # There might be multiple solutions, we expect r = 1/3.
    # Filter for positive, physically valid r (smaller than 1)
    valid_solutions = []
    for sol in solutions:
        if sol.is_real and sol > 0 and sol < 1:
            valid_solutions.append(sol)
            
    # Return the solution as a formatted string "p/q" if rational, or str(sol)
    # Assuming rational output based on problem type
    res = str(sol) # This is just for placeholder in logic, will format properly
    
    return f"{valid_solutions[0]}"

