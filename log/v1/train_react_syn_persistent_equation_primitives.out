from math import comb

def max_problems(num_students, choices_per_problem):
    """
    Calculates the maximum number of problems given the number of students and the number of choices per problem.
    The condition is that any two students have at most 1 answer in common.
    Uses the bound: sum_{problems, choices} binomial(n_{p,c}, 2) <= binomial(num_students, 2).
    Minimizing the LHS by making n_{p,c} uniform.
    """
    if num_students <= 1:
        return "unbounded"
    
    k = num_students
    q = choices_per_problem
    
    # Minimum intersections per problem when counts are uniform (k//q or k//q + 1)
    # Ideally uniform. Let's assume uniform distribution k/q.
    # Exact minimum for integer partition of k into q parts:
    # r = k % q
    # parts of size s+1 (count r) and size s (count q-r), where s = k // q
    s = k // q
    r = k % q
    
    # min_binom = r * binom(s+1, 2) + (q-r) * binom(s, 2)
    min_bins = r * comb(s + 1, 2) + (q - r) * comb(s, 2)
    
    total_pairs = comb(k, 2)
    max_problems = total_pairs // min_bins
    
    # Check if the theoretical construction (Affine Plane) allows achieving the bound when q is a prime power.
    # If q is a prime power, we can use the q+1 directions of the affine plane AG(2, q).
    # In that case, we can achieve exactly (k= q^2) students and n = q+1 problems with exactly 1 common answer per pair.
    # However, if the bound from the pigeonhole principle (min bins) is strictly less than q+1, our bound is tighter.
    # But in the affine plane case with k=q^2 and n=q+1:
    # Each col has 4 sets of size 4 (if q=4, k=16). min_bins for q=4, k=16 is 4*comb(4,2) = 24.
    # Total pairs = 120. 120/24 = 5. And q+1 = 5. Matches.
    # If the optimal configuration is not the affine plane (or if k is not q^2), the bound holds.
    # The problem asks for the maximum, and the bound is N = floor(TotalPairs / min_bins_per_problem).
    # We must ensure that for the specific case k=16, q=4, N=5 is constructible.


