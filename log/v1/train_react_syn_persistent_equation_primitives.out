from typing import Optional

def solve_problem() -> str:
    """
    Calculates the number of pairs of nonzero integers (c, d) within the range [-2015, 2015]
    such that both equations c*x = d and d*x = c have integer solutions.
    
    The condition implies |c| = |d| and c != 0, d != 0.
    This splits into two disjoint cases: d = c and d = -c.
    Returns the total count as a string.
    """
    n = 2015
    # Number of nonzero integers in range [-n, n] is 2 * n
    count_c = 2 * n
    # For each c, there are 2 valid d's: c and -c
    total_pairs = count_c * 2
    return str(total_pairs)

def verify_solution_mechanism(n: int) -> str:
    """
    Verifies the logic by explicitly counting for a small n.
    Returns the expected count for a given n.
    """
    # Range [-n, n] excluding 0
    valid_c = set()
    for i in range(-n, n + 1):
        if i != 0:
            valid_c.add(i)
    
    count = 0
    valid_pairs = []
    for c in valid_c:
        # Condition: c|d and d|c implies |d|=|c|
        # Since d must be in valid_c, d can be c or -c
        if (-n <= c <= n) and (c != 0):
            d1 = c
            d2 = -c
            if d1 != 0 and d2 != 0: # always true since c!=0
                count += 2
                valid_pairs.append((c, d1))
                valid_pairs.append((c, d2))
    return str(count)

def calculate_exact_value() -> str:
    """
    Returns the exact final answer string "8060".
    """
    result = 4 * 2015
    return str(result)

