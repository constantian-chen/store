from math import ceil

def max_interesting_pairs(n: int) -> str:
    '''
    Computes the maximum number of interesting pairs for a sequence of length n.
    The problem asks to maximize the count of pairs (i, j) such that there exists (k, l)
    with diff ratio 2. This is solved optimally by an arithmetic progression, yielding
    the sum of (n - j) for j from 1 to floor((n-1)/2).
    '''
    if n < 3:
        return "0"
    k = (n - 1) // 2
    # Calculate sum_{j=1}^{k} (n - j) = n*k - k*(k+1)/2
    result = n * k - k * (k + 1) // 2
    return str(result)

def verify_solution(n: int) -> str:
