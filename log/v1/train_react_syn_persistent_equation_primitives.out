from sympy import primerange, isprime
from sympy import factorial

def check_sparkly(n: int) -> bool:
    if n < 2:
        return False
    # Find smallest prime divisor
    smallest_divisor = None
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            smallest_divisor = i
            break
    if smallest_divisor is None:
        smallest_divisor = n
    
    # Count number of divisors
    count = 0
    for i in range(1, int(n**0.5) + 1):
        if n % i == 0:
            count += 1
            if i*i != n:
                count += 1
    
    return smallest_divisor == count

def solve_sparkly_count(limit: int) -> str:
    count = 0
    for n in range(2, limit + 1):
        if check_sparkly(n):
            count += 1
    return str(count)

