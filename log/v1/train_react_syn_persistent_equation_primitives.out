import math
from sympy import factorint

def solve():
    # We want to count n in [1, 10^6] such that max(prime factors of n^2+1) > n.
    # Heuristic estimate is floor(10^6 * ln(2)).
    # Let's verify by exact computation for n up to 10^6 if feasible,
    # but factorizing 10^12 numbers is slow in pure Python.
    # The problem asks to "Estimate", suggesting the formula N*ln(2) is the intended answer.
    # N = 10^6
    N = 10**6
    ans = math.floor(N * math.log(2))
    return str(ans)

def verify_estimate(max_n=1000):
    # Small scale verification to see convergence
    count = 0
    for n in range(1, max_n + 1):
        m = n * n + 1
        # Find largest prime factor
        factors = factorint(m)
        if not factors:
            continue
        max_p = max(factors.keys())
        if max_p > n:
            count += 1
    return count

def calculate_exact_count_for_small_N(N):
    count = 0
    for n in range(1, N + 1):
        m = n * n + 1
        factors = factorint(m)
        if not factors:
            continue
        max_p = max(factors.keys())
        if max_p > n:
            count += 1
    return count

