from fractions import Fraction

def expected_cycle_length(n_int: int) -> str:
    '''
    Computes the expected length of the cycle containing a specific element
    in a random permutation of n elements.
    
    The distribution of the cycle length is uniform on {1, 2, ..., n}.
    The expected value is (n + 1) / 2.
    
    Parameters:
        n_int (int): The size of the set S = {1, 2, ..., n}. Must be a positive integer.
        
    Returns:
        str: The expected value as a reduced fraction string (e.g., "1008.5" or "2017/2").
    '''
    if n_int <= 0:
        return "0"
    
    # Expected value is (n + 1) / 2
    numerator = n_int + 1
    denominator = 2
    
    # Check if it's an integer
    if numerator % denominator == 0:
        return str(numerator // denominator)
    else:
        # Return as a reduced fraction if not integer, but standard practice might prefer decimal
        # or mixed. Given "Reduce fractions", a/b is safer.
        # However, 1008.5 is exact. Let's output the fraction representation if not integer 
        # to adhere strictly to "_reduce_ fractions".
        return f"{numerator}/{denominator}"

