from typing import List

def count_valid_subsets(n: int) -> str:
    """
    Calculates the number of subsets S of {1, ..., n} such that for all i in [1, n-1],
    either i is in S or i+1 is in S.
    This is equivalent to counting subsets of {1, ..., n} with no two consecutive integers,
    which follows the Fibonacci recurrence.
    """
    if n == 0:
        return "1"
    if n == 1:
        return "2"
    
    # f[i] represents the number of valid subsets for a set of size i+1 (indices 0 to n)
    # f[0] = f(0) = 1
    # f[1] = f(1) = 2
    # f[k] = f[k-1] + f[k-2]
    
    prev2 = 1 # f(0)
    prev1 = 2 # f(1)
    
    current = 0
    for i in range(2, n + 1):
        current = prev1 + prev2
        prev2 = prev1
        prev1 = current
        
    return str(current)

