from math import comb

def solve_frog_fights():
    """
    Calculates the minimum number of fights (monochromatic triangles) 
    in a party of 11 frogs where every pair is friendly or unfriendly.
    A fight occurs if a triple is all friendly or all unfriendly.
    """
    n = 11
    total_triples = comb(n, 3)
    
    # We want to maximize mixed triangles to minimize monochromatic ones.
    # Number of mixed triangles = (1/2) * sum(d_i * (n-1-d_i))
    # Maximize sum of d*(10-d) subject to sum(d) even and 0 <= d <= 10.
    # The function f(d) = d(10-d) is max at d=5 (value 25).
    # n*25 = 275, which is odd, so we can't have all d=5.
    # Best we can do is ten 5s and one 4 (or 6).
    # Sum of terms = 10*25 + 4*5 = 250 + 20 = 270? No.
    # f(5) = 25. f(4) = 24.
    # Sequence: ten 5s, one 4.
    # Sum of terms = 10*25 + 24 = 274.
    
    # Verify EDF (d(10-d)) values:
    term_5 = 5 * (10 - 5)  # 25
    term_4 = 4 * (10 - 4)  # 24
    
    best_sum = (n - 1) * term_5  # Start with assumption of n-1 vertices? No.
    # We have n vertices.
    # Using 10 vertices of degree 5 and 1 vertex of degree 4.
    count_5 = n - 1
    count_4 = 1
    max_terms_sum = count_5 * term_5 + count_4 * term_4
    
    max_mixed = max_terms_sum // 2
    min_fights = total_triples - max_mixed
    
    return str(min_fights)

