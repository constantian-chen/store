import math
from functools import reduce

def solve():
    '''
    Calculate the digital root of N = 7^(6^(5^(3^2))) in base 12.
    The digital root in base b is equivalent to N mod (b-1), with the convention that
    if N mod (b-1) == 0, the result is b-1 (unless 0, but here N is huge positive).
    Base 12 -> b-1 = 11. Digits 0..11 (where 10=A, 11=B).
    If N % 11 == 0, result is 11. Else result is N % 11.
    '''
    # Calculate N = 7^(6^(5^(3^2))) mod 11
    # Using Fermat's Little Theorem: a^10 = 1 (mod 11)
    # We need exponent E = 6^(5^(3^2)) mod 10
    
    # Calculate exponent tower
    exp_base = 5
    exp_exponent = 3**2 # 9
    # Calculate exp_exponent_val = 3^2 = 9
    # Next level: 5^9
    # We need 5^9 mod phi(10) ? No, base is 6, we need 6^k mod 10.
    # 6^k mod 10 is 6 for any k >= 1.
    # Since 5^9 is huge, k >= 1 holds.
    # So exponent mod 10 is 6.
    
    # Just to be safe with general logic, let's compute step by step using pow with large exponent reduction if needed, 
    # though 5^9 is small enough to compute exactly.
    k = 3**2 # 9
    y = pow(5, k) # 5^9 = 1953125
    # We need 6^y mod 10. Since y >= 1, 6^y % 10 == 6.
    exponent_mod = pow(6, y, 10)
    
    # Now compute 7^exponent_mod mod 11
    # exponent_mod is 6.
    n_mod_11 = pow(7, exponent_mod, 11)
    
    # Determine final digit
    if n_mod_11 == 0:
        final_digit = 11
    else:
        final_digit = n_mod_11
        
    return str(final_digit)

