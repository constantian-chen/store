from bincount_helper import bincount_helper

def solve():
    """
    Solves for the 2009th jubilant number.
    A number is jubilant if the number of 1s in its binary representation is even.
    The sequence is 0, 3, 5, 6, 9, 10, 12, 15, ...
    Formula derived: a_n = 2*(n-1) + (popcount(n-1) % 2).
    """
    n = 2009
    m = n - 1
    # Calculate population count (number of set bits) of m
    # Using bin().count('1') is safe and exact for integers
    pc = bin(m).count('1')
    b = pc % 2
    result = 2 * m + b
    return str(result)

def verify_small(n_values):
    """
    Verifies the formula for small values of n against direct computation.
    """
    def is_jubilant(x):
        return bin(x).count('1') % 2 == 0
    
    # Generate first 30 jubilant numbers directly
    direct_list = []
    x = 0
    while len(direct_list) < max(n_values):
        if is_jubilant(x):
            direct_list.append(x)
        x += 1
    
    for n in n_values:
        calculated = solve_single(n)
        # The result should equal direct_list[n-1] (since 1-indexed)
        if calculated != str(direct_list[n-1]):
            print(f"Mismatch at {n}: Calculated {calculated}, Direct {direct_list[n-1]}")
            return False
    return True

def solve_single(n):
    m = n - 1
    pc = bin(m).count('1')
    b = pc % 2
    return str(2 * m + b)

if __name__ == "__main__":
    # Verification
    test_values = range(1, 20)
    if verify_small(test_values):
        print("Verification passed for small values.")
    
    # Actual calculation
    ans = solve()
    print(f"Answer for n=2009: {ans}")
    
