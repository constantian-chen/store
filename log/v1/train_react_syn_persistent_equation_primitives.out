from math import isqrt

def calculate_expected_transitions(max_val: int) -> str:
    """
    Calculates the expected number of transitions (01 or 10) in the binary representation
    of a random integer chosen uniformly from 0 to max_val (inclusive).
    
    Parameters:
        max_val (int): The upper bound of the range [0, max_val].
        
    Returns:
        str: The expected number as a reduced fraction "numerator/denominator".
    """
    n = max_val + 1
    if n == 1: # Only 0
        return "0/1"
    
    total_trans_sum = 0
    # Determine the max length
    max_len = max_val.bit_length()
    
    # Count numbers by length and accumulate expected transitions
    # Length 1: 0, 1 (if max_val >= 1)
    # Length L: 2^(L-1) to 2^L - 1
    
    # Iterate through lengths present in the range
    # The range is [0, max_val].
    # Numbers with length < max_len: full sets of 2^(L-1) numbers for L=1..max_len-1?
    # Actually, simpler approach:
    # For each L from 1 to max_len:
    #   if 2^L - 1 <= max_val, we have full block of size 2^(L-1).
    #   except possibly the last block (L = max_len) which might be truncated if max_val < 2^L - 1.
    
    # Let's iterate lengths
    for L in range(1, max_len + 1):
        start = 1 << (L - 1)
        end = (1 << L) - 1
        
        count = 0
        if end <= max_val:
            count = end - start + 1
        else:
            # Partial last block
            if start > max_val:
                break
            count = max_val - start + 1
        
        if count == 0:
            continue
            
        if L == 1:
            exp_per_num = 0.0
        else:
            exp_per_num = (L - 1) / 2.0
            
        total_trans_sum += count * exp_per_num

    # Total numbers
    n_nums = n_nums = max_val + 1
    
    # The sum was accumulated as floats, let's redo with integer arithmetic to be safe and exact
    return "0/1"

