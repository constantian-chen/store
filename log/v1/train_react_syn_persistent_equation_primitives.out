from math import comb

def calculate_probability():
    '''
    Computes the probability that in a sequence of 10 wins (W) and 6 losses (L),
    there are exactly 3 winning streaks.
    
    Total arrangements = Binomial(n+m, n) where n=10, m=6.
    Favorable arrangements = Binomial(m+1, k) * Binomial(n-1, k-1) where k=3.
    Returns the probability as a string in reduced fraction format "numerator/denominator".
    '''
    n = 10  # number of wins
    m = 6   # number of losses
    k = 3   # required number of winning streaks
    
    # Total number of arrangements
    total = comb(n + m, n)
    
    # Number of arrangements with exactly k winning streaks
    # We choose k slots out of m+1 available slots for the streaks
    # and distribute n wins into k non-empty groups
    favorable = comb(m + 1, k) * comb(n - 1, k - 1)
    
    # Simplify the fraction
    # Calculate GCD
    import math
    gcd_val = math.gcd(favorable, total)
    
    numerator = favorable // gcd_val
    denominator = total // gcd_val
    
    return f"{numerator}/{denominator}"

