--- Synthesized Tool Code ---
from math import factorial

def count_ball_placements(n: int) -> str:
    """
    Calculates the number of ways to place n purple balls and n green balls in an n x n grid
    such that every row and column contains exactly one purple and one green ball,
    with no two balls sharing a cell.
    
    The problem is equivalent to finding the number of pairs of permutations (pi_P, pi_G)
    of {1, ..., n} such that pi_P(i) != pi_G(i) for all i.
    This is given by n! * D_n, where D_n is the number of derangements of n items.
    
    Args:
        n (int): The dimension of the grid and number of balls of each color.
    
    Returns:
        str: The total count of valid configurations as a string.
    """
    if n < 1:
        return "0"
    
    # Calculate n!
    fact_n = factorial(n)
    
    # Calculate D_n (number of derangements)
    # Using the recurrence relation: D_n = (n-1) * (D_{n-1} + D_{n-2})
    # Base cases: D_1 = 0, D_2 = 1
    if n == 1:
        derangements = 0
    elif n == 2:
        derangements = 1
    else:
        d_prev2 = 0  # D_1
        d_prev1 = 1  # D_2
        derangements = 0
        for i in range(3, n + 1):
            current = (i - 1) * (d_prev1 + d_prev2)
            derangements = current
            d_prev2 = d_prev1
            d_prev1 = current
    
    total_ways = fact_n * derangements
    return str(total_ways)

def solve_problem() -> str:
    """
    Solves the specific instance for 4 purple and 4 green balls.
    Returns the result as a string.
    """
    return count_ball_placements(4)

