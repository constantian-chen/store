from fractions import Fraction

def solve_math_probability(problem_statement: str) -> str:
    '''
    Solves the probability problem for the given set of factors of 6000.
    Factors of 6000 are divisors of 2^4 * 3^1 * 5^3.
    Calculates the product of probabilities for each prime exponent.
    Formula for prob at exponent e: (2e^3 + 4e^2 + 3e + 1) / (e+1)^4.
    '''
    exponents = [4, 1, 3]
    numerator = 1
    denominator = 1
    for e in exponents:
        N_e = 2 * e**3 + 4 * e**2 + 3 * e + 1
        den = (e + 1)**4
        numerator = numerator * N_e
        denominator = denominator * den
    return f"{numerator}/{denominator}"

def verify_formula(e: int) -> int:
    '''
    Verifies the formula for N_e for a given exponent e by computing the sum of valid configurations directly.
    Returns the computed N_e.
    '''
    total_valid = 0
    for k in range(e + 1):
        M = (e + 1)**2 - k**2 - **(e - k)2
        N_B = 2 * (e - k) + 1
        N_C = 2 * k + 1
        N_union = 2 * e + 1
        M_rest = M - N_union
        count_k = M**2 - **(M - N_B)2 - **(M - N_C)2 + M_rest**2
        total_valid += count_k
    return total_valid

def compute_final_answer() -> str:
    '''
    Computes the final answer string.
    '''
    exponents = [4, 1, 3]
    num = 1
    den = 1
    for e in exponents:
        n_val = 2 * e**3 + 4 * e**2 + 3 * e + 1
        d_val = (e + 1)**4
        num *= n_val
        den *= d_val
    return f"{num}/{den}"

