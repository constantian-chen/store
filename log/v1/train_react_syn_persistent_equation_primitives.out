def solve():
    # Helper to generate permutations and compute GCD
    import math
    from itertools import permutations
    
    def gcd_of_set(nums):
        if not nums: return 0
        g = nums[0]
        for x in nums[1:]:
            g = math.gcd(g, x)
        return g
    
    def generate_numbers(digits):
        # digits is a tuple/list of 3 digits
        perms = set()
        for p in permutations(digits):
            val = p[0]*100 + p[1]*10 + p[2]
            perms.add(val)
        return list(perms)
    
