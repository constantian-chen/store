def solve():
    """
    Calculates the total time taken for the caterpillar to eat 10 fruits.
    The time to reach the nth fruit is given by n * 2^(n-1).
    The sum is calculated as sum_{n=1 to 10} n * 2^(n-1).
    Returns the integer result as a string.
    """
    n_eats = 10
    total_time = sum(n * (2**(n-1)) for n in range(1, n_eats + 1))
    return str(total_time)

