from sympy import sqrt, Rational, solve

def compute_circle_radius():
    """
    Computes the radius r of a circle externally tangent to three inscribed circles
    in a 3x3 grid of unit squares.
    The inscribed circles are centered at (0.5, 0.5), (1.5, 2.5), and (2.5, 1.5)
    with radius 0.5 each.
    Returns the exact value of r as a string.
    """
    # Centers of the small circles
    c1_x, c1_y = Rational(1, 2), Rational(1, 2)
    c2_x, c2_y = Rational(3, 2), Rational(5, 2)
    c3_x, c3_y = Rational(5, 2), Rational(3, 2)
    r_small = Rational(1, 2)
    
    # Let R = r_small + r. The distance from (x,y) to each center is R.
    # Equations:
    # (x - c1_x)^2 + (y - c1_y)^2 = R^2
    # (x - c2_x)^2 + (y - c2_y)^2 = R^2
    # (x - c3_x)^2 + (y - c3_y)^2 = R^2
    
    # Subtracting pairs gives lines of centers for circles with equal radii.
    # (x - 1.5)^2 + (y - 2.5)^2 = (x - 0.5)^2 + (y - 0.5)^2
    # -2x - 4y + 8 = 0 => x + 2y = 4
