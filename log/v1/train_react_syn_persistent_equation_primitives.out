from itertools import permutations

def is_degree_5_perm(perm):
    """
    Given a permutation of [1..6], determines if the interpolation polynomial
    has degree exactly 5. Returns True if degree is 5, False otherwise.
    """
    y = [x for x in perm]
    # Leading coefficient numerator for degree 5 interpolation on 1..6
    # 120 * c5 = -y1 + 5y2 - 10y3 + 10y4 - 5y5 + y6
    numerator = (
        -y[0] + 5*y[1] - 10*y[2] + 10*y[3] - 5*y[4] + y[5]
    )
    return numerator != 0

def solve_problem():
    """
    Counts the number of permutations of {1, 2, 3, 4, 5, 6} such that
    the interpolating polynomial has degree exactly 5.
    """
    total_perms = 6
    count_exact_5 = 0
    for p in permutations(range(1, total_perms + 1)):
        if is_degree_5_perm(p):
            count_exact_5 += 1
    return str(count_exact_5)

