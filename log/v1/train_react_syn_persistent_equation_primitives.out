--- Synthesized Tool Code ---
import sympy as sp

def solve_geometry_problem():
    """
    Solves the geometry problem for the convex trapezoid ABCD.
    Returns AP as a reduced fraction string.
    """
    # Define coordinates based on the problem description
    # A = (0, 0)
    # B = (0, 20)
    # D = (21, 0)
    # C = (21, 28) (Determined to ensure convexity)
    
    A = sp.Point(0, 0)
    B = sp.Point(0, 20)
    C = sp.Point(21, 28)
    D = sp.Point(21, 0)
    
    # Parametrize P on AC
    # P = A + k * (C - A) where k is a scalar between 0 and 1
    # Actually, let's use a parameter t such that P = (t, 4t/3)
    t = sp.symbols('t', real=True)
    Px = t
    Py = 4 * t / 3
    P = sp.Point(Px, Py)
    
    # Condition: angle BPD = 90 degrees => dot product of PB and PD is 0
    PB = B - P
    PD = D - P
    
    dot_product = PB.dot(PD)
    
    # Solve for t
    # t(25t - 429) = 0 derived in reasoning.
    solutions = sp.solve(dot_product, t)
    # Exclude t=0 because P != A
    valid_t = [sol for sol in solutions if sol != 0]
    
    if len(valid_t) == 0:
        raise ValueError("No solution found.")
    
    t_val = valid_t[0]
    
    # Calculate AP distance
    # AP = distance(A, P) = sqrt(t^2 + (4t/3)^2) = 5t/3
    AP_dist = sp.sqrt(t_val**2 + (4*t_val/3)**2)
    
    # Simplify the result
    AP_simplified = sp.nsimplify(AP_dist)
    
    return str(AP_simplified)

