from fractions import Fraction

def solve_min_fraction():
    """
    Calculate the minimum value of (ab + c) / (a + b + c)
    for integers a, b, c in [1, 2011].
    Returns the result as a string 'numerator/denominator'.
    """
    a_min = 1
    b_min = 1
    c_max = 2011
    
    # Based on analysis:
    # 1. Fix a, b. Expression E decreases as c increases. So c should be max (2011).
    # 2. Fix b, c. Expression E increases as a increases (since b^2+bc-c > 0). So a should be min (1).
    # 3. Fix a, c. Expression E increases as b increases (same logic). So b should be min (1).
    # Thus, minimum is at a=1, b=1, c=2011.
    
    # Compute the fraction
    num = a_min * b_min + c_max
    den = a_min + b_min + c_max
    
    # Use Fraction to ensure it is reduced
    f = Fraction(num, den)
    
    return f"{f.numerator}/{f.denominator}"

