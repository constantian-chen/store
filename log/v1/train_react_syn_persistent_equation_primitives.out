import math

def solve_apple_cutting(n_apples: int, k_students: int) -> str:
    """
    Calculates the minimal number of pieces required to divide n_apples
    evenly among k_students.
    
    The formula is: pieces = n_apples + k_students - gcd(n_apples, k_students).
    
    Args:
        n_apples: Total number of apples (positive integer).
        k_students: Total number of students (positive integer).
        
    Returns:
        The minimal number of pieces as a string.
    """
    if n_apples <= 0 or k_students <= 0:
        raise ValueError("Number of apples and students must be positive integers.")
    
    gcd_val = math.gcd(n_apples, k_students)
    min_pieces = n_apples + k_students - gcd_val
    
    return str(min_pieces)

def verify_formula_examples() -> str:
    """
    Verifies the formula with a few small examples to ensure correctness.
    Returns a status string.
    """
    # Example 1: 1 apple, 2 students -> 2 pieces (1 + 2 - 1)
    a1 = 1 + 2 - math.gcd(1, 2)
    # Example 2: 2 apples, 4 students -> 4 pieces (2 + 4 - 2)
    a2 = 2 + 4 - math.gcd(2, 4)
    # Example 3: 5 apples, 3 students -> 7 pieces (5 + 3 - 1)
    a3 = 5 + 3 - math.gcd(5, 3)
    
    result = "OK"
    if a1 != 2 or a2 != 4 or a3 != 7:
        result = "FAILED"
    return result

def compute_min_pieces(n: int, k: int) -> str:
    """
    Main function to compute the answer for the specific problem input.
    """
    ans_val = solve_apple_cutting(n, k)
    return "Computed value: " + ans_val

