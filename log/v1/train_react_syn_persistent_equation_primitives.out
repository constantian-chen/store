from fractions import Fraction

def solve_polynomial_interpolation():
    """
    Solves the problem of finding P(5) given P(x) matches 1/(1+x+x^2) at x=1,2,3,4.
    Uses Lagrange interpolation to compute the exact rational value.
    """
    # Data points (x, y)
    x_vals = [1, 2, 3, 4]
    y_vals = [Fraction(1, 3), Fraction(1, 7), Fraction(1, 13), Fraction(1, 21)]
    target_x = 5
    
    result = Fraction(0, 1)
    
    # Lagrange interpolation formula
    for i in range(len(x_vals)):
        Li = Fraction(1, 1)
        # Calculate numerator of L_i(x)
        for j in range(len(x_vals)):
            if i != j:
                Li *= (target_x - x_vals[j])
        
        # Calculate denominator of L_i(x)
        for j in range(len(x_vals)):
            if i != j:
                Li *= (x_vals[i] - x_vals[j])
        
        Li = Li # This is the coefficient
        result += Li * y_vals[i]
        
    return str(result)

def solve_reminder_method():
    """
    Solves using the remainder method: Q(x) = (x^2+x+1)P(x)-1 has roots 1,2,3,4.
    Q(x) = (x-1)(x-2)(x-3)(x-4)(Ax+B). Uses complex roots of x^2+x+1 to find A, B.
    """
    # Roots of unity
    import cmath
    # We solve analytically for A and B derived in reasoning
    # A = -4/273, B = -1/91
    A = Fraction(-4, 273)
    B = Fraction(-3, 273) # simplified to -1/91 internally if needed, but -3/273 is fine
    
    # Evaluate R(5) = (5-1)(5-2)(5-3)(5-4)(5A+B)
    prod_x = (5-1)*(5-2)*(5-3)*(5-4) # 24
    val_lin = 5*A + B
    R5 = prod_x * val_lin
    # P(5) = (R(5) + 1) / (5^2+5+1)
    denom = 5*5 + 5 + 1 # 31
    P5 = (R5 + 1) / denom
    
    return str(P5)

def main():
    ans1 = solve_polynomial_interpolation()
    ans2 = solve_reminder_method()
    return f"Interpolation: {ans1}, Remainder: {ans2}"

if __name__ == "__main__":
    pass
