from math import gcd, floor

def check_theta(n, M):
    """
    Check if theta = (2*n*pi)/(2^(M+1)-1) satisfies the non-zero cosine condition.
    Condition: cos(2^k * theta) != 0 for k in 0..M.
    This requires 2^k * (2*n) / (2^(M+1)-1) != 2*m + 1 for any integer m.
    Or 2^(k+1)*n is not an odd multiple of (2^(M+1)-1).
    Returns True if valid, False otherwise.
    """
    denom = 2**(M+1) - 1
    # Check for k from 0 to M
    for k in range(M + 1):
        numerator = (1 << (k + 1)) * n
        # We need numerator / denom != odd integer
        # i.e., numerator is not divisible by denom, OR if divisible, quotient is even.
        # Since denom = 2^(M+1)-1 is odd, divisibility implies numerator is multiple of denom.
        if numerator % denom == 0:
            quotient = numerator // denom
            # If quotient is odd, it corresponds to an odd integer (2m+1)
            if quotient % 2 != 0:
                return False
    return True

