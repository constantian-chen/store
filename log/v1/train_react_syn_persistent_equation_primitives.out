from math import ceil, floor, pi

def count_solutions():
    '''
    Counts the number of integer k such that k*pi is in the interval (-19, 98).
    This corresponds to the number of solutions to cos^2(x) + 2*sin^2(x) = 1 in that range.
    '''
    # The condition is -19 < k*pi < 98
    # Lower bound for k: -19/pi
    # Upper bound for k: 98/pi
    
    # Since k must be strictly greater than -19/pi and strictly less than 98/pi.
    # Let's calculate the bounds precisely.
    # k > -19/pi => k >= floor(-19/pi) + 1 if -19/pi is not integer, which it isn't.
    # k < 98/pi => k <= ceil(98/pi) - 1 if 98/pi is not integer.
    
    lower_limit = -19.0 / pi
    upper_limit = 98.0 / pi
    
    # k must be an integer strictly greater than lower_limit
    k_min = floor(lower_limit)
    if k_min == lower_limit:
        k_min += 1
    else:
        k_min += 1 # Wait, floor(-6.047) is -7. -7 < -6.047 is true. So k_min should be floor + 1?
        # Let's re-evaluate logic.
        # We need k > L.
        # If L = -6.047, floor(L) = -7. -7 is not > -6.047. -6 is > -6.047.
        # So k_min = floor(L) + 1.
        
    # We need k strictly less than upper_limit.
    # If L = 31.194, ceil(L) = 32. 32 is not < 31.194. 31 is < 31.194.
    # So k_max = ceil(U) - 1.
    # Alternatively, k_max = floor(U) if U is not integer.
    
    k_min = floor(lower_limit) + 1
    k_max = floor(upper_limit)
    
    count = k_max - k_min + 1
    return str(count)

if __name__ == "__main__":
    print(count_solutions())

