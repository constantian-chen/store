from math import factorial
import sys

def compute_sum(N):
    if N == 1:
        return "-1"
    if N == 2:
        return "0"
    # Formula: (N - 4) * 2^(N-1) * (-1)^(N-1)^(N-1)? No.
    # Product term = (-1)^(N-1) * 2^(N-1)
    # Det = (N-4) * Product
    # For N odd: N-1 even, so term positive.
    # Det = (N-4) * 2**(N-1)
    # But wait, for N=3: (3-4)*4 = -4. Correct.
    # For N=5: (5-4)*16 = 16. Correct.
    # For N=999: (999-4) * 2**998.
    val = (N - 4) * (1 << (N - 1))
    return str(val)

def get_answer():
