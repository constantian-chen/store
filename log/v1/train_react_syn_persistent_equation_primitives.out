import math

def calculate_minimum():
    AB = 2021
    AC = 2022
    BC = 2023
    # Coordinates
    A = (0, 0)
    B = (AB, 0)
    # Find C
    # x^2 + y^2 = AC^2
    # (x-AB)^2 + y^2 = BC^2
    # x^2 - (x-AB)^2 = AC^2 - BC^2
    # 2*AB*x - AB^2 = AC^2 - BC^2
    # 2*AB*x = AC^2 - BC^2 + AB^2
    two_AB = 2 * AB
    xC = (AC**2 - BC**2 + AB**2) / two_AB
    yC_sq = AC**2 - xC**2
    yC = math.sqrt(yC_sq)
    
    # Function f(x) = x + 2*(AB - x) + 3*sqrt((x-xC)^2 + yC**2) for x in [0, AB]
    # f(x) = 2*AB - x + 3*sqrt((x-xC)^2 + yC**2)
    # f'(x) = -1 + 3 * (x-xC) / sqrt((x-xC)^2 + yC**2)
    # Set f'(x) = 0 => (x-xC)/sqrt(...) = 1/3
    # Let d = x-xC. d/dy = 1/3 => d = yC / sqrt(8)
    # x = xC + d
    d = yC / math.sqrt(8)
    x_opt = xC + d
    
    if x_opt < 0: x_opt = 0
    if x_opt > AB: x_opt = AB
    
    # Calculate f(x_opt)
    # AP = x_opt
    # BP = AB - x_opt
    # CP = sqrt((x_opt - xC)**2 + yC**2)
    AP = x_opt
    BP = AB - x_opt
    CP = math.sqrt((x_opt - xC)**2 + yC**2)
    val = AP + 2*BP + 3*CP
    return str(round(val))

if __name__ == "__main__":
    print(calculate_minimum())
