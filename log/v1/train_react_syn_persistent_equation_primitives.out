def solve_problem():
    '''
    Solves the problem of finding the largest number of colors for an n x n grid
    such that no 2x2 subsquare contains 4 distinct colors.
    Returns the formula in terms of n as a string.
    '''
    from sympy import symbols, simplify
    n = symbols('n')
    # The maximum number of colors is 2n - 1 for n >= 2.
    # For n=1, the condition is vacuously true, but the pattern suggests 1.
    # Assuming n >= 2 based on the existence of 2x2 squares.
    result = 2 * n - 1
    return result

