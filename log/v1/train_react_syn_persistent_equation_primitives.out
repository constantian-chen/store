from fractions import Fraction

def solve_triangle_area():
    """
    Calculates the area of the right triangle described in the problem.
    Returns the area as a string.
    """
    # Let the radius of the circle be r.
    # The legs of the triangle are a and b.
    # The circle is tangent to the legs, so the center is (r, r).
    # The segments of the hypotenuse are 1, 24, 3. Total hypotenuse c = 28.
    # The chord length is 24.
    
    # Using Power of a Point:
    # Let the segments adjacent to the chord ends be x and y.
    # Depending on ordering, we get two pairs of (a-r, b-r).
    # Case 1: A is adjacent to 1, B is adjacent to 3.
    # Power(A) = 1 * (1+24) = 25 => (b-r)^2 = 25 => b = r + 5
    # Power(B) = 3 * (3+24) = 81 => (a-r)^2 = 81 => a = r + 9
    # Case 2: A is adjacent to 3, B is adjacent to 1.
    # This swaps a and b, leading to the same equation for r.
    
    # Equation from c^2 = a^2 + b^2:
    # (r+9)^2 + (r+5)^2 = 28^2
    # 2r^2 + 28r + 81 + 25 = 784
    # 2r^2 + 28r + 106 = 784
    # 2r^2 + 28r - 678 = 0
    # r^2 + 14r - 339 = 0
    
    # We need Area = 0.5 * a * b = 0.5 * (r+9)(r+5)
    # (r+9)(r+5) = r^2 + 14r + 45
    # From the quadratic equation, r^2 + 14r = 339
    # So (r+9)(r+5) = 339 + 45 = 384
    # Area = 0.5 * 384 = 192
    
    # Verification: Check if a valid real positive r exists.
    # Discriminant D = 14^2 - 4*1*(-339) = 196 + 1356 = 1552 > 0.
    # r = (-14 + sqrt(1552)) / 2 is positive.
    
    # Final calculation using exact arithmetic
    # r^2 + 14r = 339
    product_ab = 339 + 45
    area = product_ab / 2
    
    return str(area)

