def calculate_last_digit():
    """
    Calculates the last digit of a_{128,1} defined by:
    a_{1, n} = n^n
    a_{i, j} = a_{i-1, j} + a_{i-1, j+1}
    Using modular arithmetic (mod 2 and mod 5) to find result mod 10.
