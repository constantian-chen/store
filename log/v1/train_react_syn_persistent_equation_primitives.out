def solve():
    # The problem asks for the number of ways to write 10 Cs in a row with:
    # - Case: lower-case (l) or upper-case (u)
    # - Color: green (g) or yellow (y)
    # Constraints:
    # 1. At least one l
    # 2. At least one g
    # 3. At least one C that is both upper-case and yellow (uy)
    # 4. No l followed by u (implies all u's come before all l's: u...ul...l)
    # 5. No y followed by g (implies all g's come before all y's: g...gy...y)
    
    # Let k be the number of lower-case Cs (suffix of cases).
    # Let m be the number of green Cs (prefix of colors).
    # n = 10.
    # Conditions:
    # - 1 <= k <= n-1 (need at least one l and at least one u)
    # - 1 <= m <= n-1 (need at least one g and at least one y to support uy, since uy needs y)
    # - Intersection for uy: Need an index i such that i is u (i <= n-k) AND i is y (i > m).
    #   So we need m < i <= n-k.
    #   This requires m+1 <= n-k => m + k <= n-1.
    
    n = 10
    count = 0
    # k ranges from 1 to n-1
    # m ranges from 1 to n-1
    # We need k + m <= n - 1
    
    minimal_k = 1
    maximal_k = n - 1
    
    for k in range(minimal_k, maximal_k + 1):
        # For a fixed k, m can range from 1 to (n - 1 - k)
        # Since m >= 1, we need 1 <= n - 1 - k => k <= n - 2.
        max_m = n - 1 - k
        if max_m < 1:
            continue
        # Number of valid m is max_m - 1 + 1 = max_m
        count += max_m
            
    return str(count)

