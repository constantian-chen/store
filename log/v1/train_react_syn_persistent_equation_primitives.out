from fractions import Fraction
from math import gcd

def solve_service_problem():
    """
    Solves the work problem where Carl and Bob, Anne and Bob, and Anne and Carl have given work rates.
    Determines the time taken if Carl works for one day then leaves.
    Returns the total time as a string in the format 'numerator/denominator'.
    """
    # Given rates for pairs
    rate_CB = Fraction(1, 6)  # Carl + Bob
    rate_AB = Fraction(1, 3)  # Anne + Bob
    rate_AC = Fraction(1, 5)  # Anne + Carl
    
    # Sum of the three equations: 2*(rA + rB + rC) = rate_CB + rate_AB + rate_AC
    sum_rates_sum = rate_CB + rate_AB + rate_AC
    total_rate = sum_rates_sum / 2  # rA + rB + rC
    
    # Work done in the first day by all three
    work_day1 = total_rate * 1
    
    # Remaining work
    remaining_work = 1 - work_day1
    
    # Rate after Carl leaves (Anne + Bob)
    rate_remaining = rate_AB
    
    # Time needed for remaining work
    time_remaining = remaining_work / rate_remaining
    
    # Total time
    total_time = 1 + time_remaining
    
    # Return as string
    return f"{total_time.numerator}/{total_time.denominator}"

def verify_answer():
    """
    Alternative calculation to verify the main function's logic.
    Explicitly calculates individual rates and simulates the process.
    Returns the result string.
    """
    # Solve for individual rates system:
    # rC + rB = 1/6
    # rA + rB = 1/3
    # rA + rC = 1/5
    
    # rB = 1/3 - rA
    # rC = 1/5 - rA
    # (1/5 - rA) + (1/3 - rA) = 1/6
    # 1/5 + 1/3 - 2*rA = 1/6
    # (3+5)/15 - 2*rA = 1/6
    # 8/15 - 1/6 = 2*rA
    # (16 - 5)/30 = 2*rA => 11/30 = 2*rA => rA = 11/60
    
    rA = Fraction(11, 60)
    rB = Fraction(1, 3) - rA
    rC = Fraction(1, 5) - rA
    
    # Verify individual rates
    # rC + rB should be 1/6
    assert rC + rB == Fraction(1, 6)
    # rA + rB should be 1/3
    assert rA + rB == Fraction(1, 3)
    # rA + rC should be 1/5
    assert rA + rC == Fraction(1, 5)
    
 

