def solve():
    # Calculate W(1) for 4x4 grid with sum 1 per row/col
    # This is the number of 4x4 permutation matrices = 4! = 24
    n = 4
    W1 = 1
    for i in range(n):
        W1 *= (n - i)
    
    # Calculate W(2) for 4x4 grid with sum 2 per row/col
    # This is the number of 2-regular bipartite graphs on 4+4 vertices.
    # Structure 1: A single C8 cycle.
    # Number of C8 in K4,4 is (4-1)! * 4! / 2 = 3! * 24 / 2 = 72
    # Structure 2: Two disjoint C4 cycles.
    # Number of ways to partition 4 rows into 2 pairs: 3
    # Number of ways to partition 4 cols into 2 pairs: 3
    # For a fixed partition, assign pairs: 2 ways
    # For each pair, number of C4: 2
    # Total: 3 * 3 * 2 * 2 * 2 = 72
    # Total W2 = 72 + 72 = 144
    W2_1 = 72
    W2_2 = 72
    W2 = W2_1 + W2_2
    
    # Final answer
    ans = W1 * W1 * W2
    return str(ans)

