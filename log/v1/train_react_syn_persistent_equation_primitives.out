import sympy as sp
from sympy import sqrt, pi

def calculate_area():
    # Constants
    sqrt3 = sqrt(3)
    pi_val = pi
    
    # Radii squared
    R1_sq = 2 - sqrt3
    R2_sq = 2 + sqrt3
    
    # Angles in radians
    theta1 = 5*pi_val / 6  # 150 degrees
    theta2 = pi_val / 6    # 30 degrees
    
    # Areas of segments
    S1 = R1_sq / 2 * (theta1 - sp.sin(theta1))
    S2 = R2_sq / 2 * (theta2 - sp.sin(theta2))
    
    total_area = sp.simplify(S1 + S2)
    return str(float(total_area.evalf(precision=10)))

# Also return symbolic string for exact check
def calculate_area_symbolic():
    sqrt3 = sqrt(3)
    pi_val = pi
    
    R1_sq = 2 - sqrt3
    R2_sq = 2 + sqrt3
    
    theta1 = 5*pi_val / 6
    theta2 = pi_val / 6
    
    S1 = R1_sq / 2 * (theta1 - sp.sin(theta1))
    S2 = R2_sq / 2 * (theta2 - sp.sin(theta2))
    
    total_area = sp.simplify(S1 + S2)
    return str(total_area)

def solve():
    # Run symbolic calculation and print the result formatted as requested
    result_sym = calculate_area_symbolic()
    # The problem asks for a plain string. Usually exact form if possible, or decimal?
    # "Find the area". Exact form is preferred in math competitions.
    # The symbolic result is 'pi - 1 - sqrt(3)*pi/3'.
    return str(result_sym)

