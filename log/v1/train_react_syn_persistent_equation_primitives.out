from math import sqrt, acos

def solve_min_distance():
    """
    Calculates the minimum value of the expression (2 cos alpha + 5 sin beta - 8)^2 + (2 sin alpha + 5 cos beta - 15)^2.
    This is equivalent to finding the squared distance between the point (8, 15) and the set of points
    (2 cos alpha + 5 sin beta, 2 sin alpha + 5 cos beta).
    The set of points (2 cos alpha, 2 sin alpha) forms a circle of radius 2 centered at (0,0).
    The set of points (5 sin beta, 5 cos beta) forms a circle of radius 5 centered at (0,0).
    The sum of these two vectors forms an annulus with inner radius |5-2|=3 and outer radius 5+2=7.
    The point (8, 15) has distance sqrt(8^2 + 15^2) = 17 from the origin.
    Since 17 > 7, the closest point in the annulus is on the outer circle (radius 7) towards (8, 15).
    The distance is 17 - 7 = 10.
    The squared minimum distance is 10^2 = 100.
    """
    # Parameters
    r1 = 2
    r2 = 5
    tx = 8
    ty = 15
    
    # Distance of target point from origin
    dist_target = sqrt(tx**2 + ty**2)
    
    # Max radius of the reachable annulus
    r_max = r1 + r2
    
    # Min radius of the reachable annulus
    r_min = abs(r2 - r1)
    
    if dist_target > r_max:
        # Point is outside the outer circle
        min_dist = dist_target - r_max
    elif dist_target < r_min:
        # Point is inside the inner hole
        min_dist = r_min - dist_target
    else:
        # Point is inside the annulus (or on boundary)
        min_dist = 0.0
        
    # Return squared distance as integer since inputs and operations are exact for this case
    # Using exact arithmetic logic:
    # dist_target = 17, r_max = 7 -> min_dist = 10 -> result = 100
    result = min_dist ** 2
    
    return str(int(result))

