import sympy as sp
from sympy import sqrt

def solve_trig_identity():
    """
    Calculates the value of (sin 10 + sin 20 + ... + sin 80) / (cos 5 cos 10 cos 20)
    using symbolic mathematics to ensure exact arithmetic and simplify the radical form.
    Angles are interpreted in degrees.
    Returns the exact simplified string representation.
    """
    # Define symbols and set degrees
    x = sp.symbols('x')
    # Calculate the numerator sum: sum(sin(k*10)) for k=1 to 8
    angles_deg = [k * 10 for k in range(1, 9)]
    numerator = sum([sp.sin(sp.rad(degree)) for degree in angles_deg])
    
    # Calculate the denominator: cos(5)cos(10)cos(20)
    denominator = sp.cos(sp.rad(5)) * sp.cos(sp.rad(10)) * sp.cos(sp.rad(20))
    
    # Compute the ratio
    ratio = sp.simplify(numerator / denominator)
    
    # Convert to string, ensuring it's in a simple surd form if possible (e.g., 4*sqrt(2))
    # sympy.simplify already handles the trig reduction.
    result_str = str(ratio)
    
    return result_str

