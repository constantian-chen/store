import math
from itertools import permutations

def count_pairs(pi, n):
    count = 0
    for i in range(n):
        for j in range(i+1, n):
            val = pi[i] * pi[j]
            idx_val = (i+1) * (j+1)
            if val > idx_val:
                count += 1
    return count

def max_pairs(n):
    max_c = -1
    best_pi = None
    for p in permutations(range(1, n+1)):
        c = count_pairs(p, n)
        if c > max_c:
            max_c = c
            best_pi = p
    return max_c, best_pi

