from itertools import permutations
from collections import defaultdict

def solve_sushi_orders():
    # Grid 2x3
    # Cells: (1,1) A, (1,2) B, (1,3) C
    #        (2,1) D, (2,2) E, (2,3) F
    # Neighbors:
    # A: B, D
    # B: A, C, E
    # C: B, F
    # D: A, E
    # E: B, D, F
    # F: C, E
    
    nodes = ['A', 'B', 'C', 'D', 'E', 'F']
    neighbors = {
        'A': {'B', 'D'},
        'B': {'A', 'C', 'E'},
        'C': {'B', 'F'},
        'D': {'A', 'E'},
        'E': {'B', 'D', 'F'},
        'F': {'C', 'E'}
    }
    
    valid_permutations = 0
    
    # Pre-check degrees: only pick if current degree <= 2
    # We simulate all 720 permutations
    for p in permutations(nodes):
        # Track removed set
        removed = set()
        valid = True
        for node in p:
            # Calculate current degree
            current_neighbors = neighbors[node] - removed
            deg = len(current_neighbors)
            
            # Check constraint: at most 2
            if deg > 2:
                valid = False
                break
            
            removed.add(node)
        
        if valid:
            valid_permutations += 1
            
    return str(valid_permutations)
