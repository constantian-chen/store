from fractions import Fraction

def solve_geometry_problem():
    """
    Calculates the length of BX in the given geometric configuration using exact arithmetic.
    Returns the reduced fraction string.
    """
    # Define coordinates relative to D=(0,0)
    # B = (-d, 0), C = (6-d, 0), A = (0, h)
    # 16 = d^2 + h^2, 25 = (6-d)^2 + h^2
    # (6-d)^2 - d^2 = 9 => 36 - 12d = 9 => 12d = 27 => d = 9/4
    d = Fraction(9, 4)
    h_sq = 16 - d*d
    # h = sqrt(175)/4 = 5*sqrt(7)/4
    # We can work with h directly as a symbol or use the relation h = sqrt(175)/4
    # To avoid floating point, we compute the ratio x = 12*h*k / (16*h*(h-k) + 9)
    # Express everything in terms of h and k without radicals until the end, or use the specific values.
    
    # h = sqrt(175)/4
    # k = sqrt(7)/7 = (1/7)*sqrt(7)
    # Let's factor out sqrt(7)
    # h = (5/4) * sqrt(7)
    # k = (1/7) * sqrt(7)
    # Let s7 = sqrt(7)
    
    # x depends on h, k.
    # h = (5/4) s7
    # k = (1/7) s7
    # h - k = (35/28 - 4/28) s7 = (31/28) s7
    # h*k = (5/28) s7^2 = 5/4
    
    # Term 1: 12*h*k = 12 * (5/4) = 15
    # Term 2: 16*h*(h-k) = 16 * (5/4 s7) * (31/28 s7) = 16 * (5*31/112) * 7 = 16 * (155/112) * 7?
    # Wait, s7^2 = 7.
    # h(h-k) = (5/4)(1/7) * 7 * (31/4)? No.
    # h(h-k) = (5/4 s7) * (31/28 s7) = (155 / 112) * 7 = 155/16.
    
    # Numerator = 15
    # Denominator = 155 + 9 = 164
    # x = 15/164
    
    # BX = x + d = 15/164 + 9/4 = 15/164 + (9*41)/164 = (15 + 369)/164 = 384/164
    # Simplify 384/164 -> 96/41
    
    num = 15
    den = 164
    numerator = num + (9 * 41)
    denominator = den
    result = Fraction(numerator, denominator)
    return str(result)

