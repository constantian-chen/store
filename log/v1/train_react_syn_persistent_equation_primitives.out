from math import isqrt

def solve():
    """
    Finds the smallest positive integer x for which x^2 + x + 41 is not prime.
    Returns the string representation of x.
    """
    x = 1
    while True:
        val = x * x + x + 41
        # Check if val is prime
        if val <= 1:
            is_prime = False
        else:
            is_prime = True
            limit = isqrt(val)
            for i in range(2, limit + 1):
                if val % i == 0:
                    is_prime = False
                    break
        if not is_prime:
            return str(x)
        x += 1

