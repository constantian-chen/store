def count_graphs():
    """
    Computes the number of labelled 3-regular graphs on 8 vertices satisfying the condition:
    For every pair of distinct vertices, number of common neighbors is 0 or 2.
    Valid graphs: Two copies of K4 (disconnected) and the 3-cube Q3.
    """
    from math import factorial
    
    n = 8
    
    # Case 1: Two disjoint K4s
    # Number of ways to partition 8 vertices into two sets of 4.
    # nC4 / 2! because the two sets are indistinguishable.
    ways_K4 = factorial(8) // (factorial(4) * factorial(4) * 2)
    
    # Case 2: The cube graph Q3
    # |Aut(Q3)| = 48.
    # Number of labelled graphs = 8! / 48
    aut_Q3 = 48
    ways_Q3 = factorial(8) // aut_Q3
    
    # Check for other graphs?
    # Based on graph enumeration theory, these are the only two satisfying the condition.
    # Any graph with a triangle must contain a K4, and connectivity forces components.
    # Triangle-free connected cubic graphs on 8 vertices: Q3 is the only one satisfying the SRG/lambda=0 condition.
    
    total = ways_K4 + ways_Q3
    return str(total)

