{"code": "import itertools\n\nedges_info = [\n    (0, 1, 0, 0), # e1 (0,0)-(1,0) - mapped to integers later\n    # Let's just use the mapped integers directly as in previous run\n]\ncoords = {(0,0):0, (1,0):1, (2,0):2, (0,1):3, (1,1):4, (2,1):5}\nedge_list = [\n    (0, 1), # e1\n    (1, 2), # e2\n    (3, 4), # e3\n    (4, 5), # e4\n    (0, 3), # e5\n    (2, 5), # e6\n    (1, 4), # e7\n]\n\ndef is_spanning_connect(subset_edges):\n    if not subset_edges:\n        return False\n    adj = {i: set() for i in range(6)}\n    involved = set()\n    for u, v in subset_edges:\n        adj[u].add(v)\n        adj[v].add(u)\n        involved.add(u)\n        involved.add(v)\n    if involved != {0, 1, 2, 3, 4, 5}:\n        return False\n    visited = set()\n    count = 0\n    for start in range(6):\n        if start not in visited:\n            count += 1\n            stack = [start]\n            visited.add(start)\n            while stack:\n                node = stack.pop()\n                for nb in adj[node]:\n                    if nb not in visited:\n                        visited.add(nb)\n                        stack.append(nb)\n    return count == 1\n\nspanning_count = 0\nfor r in range(5, 8): # min 5 edges to span 6 vertices\n    for comb in itertools.combinations(range(7), r):\n        subset_edges = [edge_list[i] for i in comb]\n        if is_spanning_connect(subset_edges):\n            spanning_count += 1\n\nprint(spanning_count)"}

