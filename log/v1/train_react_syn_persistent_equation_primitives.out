from sympy import symbols, I, solve, prod, expand, Rational

def solve_math_problem():
    # Define variables
    a, b, c = symbols('a b c')
    i = I
    
    # Define equations
    eq1 = a**2 + a*b + b**2 - (1+i)
    eq2 = b**2 + b*c + c**2 - (-2)
    eq3 = c**2 + c*a + a**2 - 1
    
    # Solve the system
    # Since this is a nonlinear system with 3 variables, solving directly might be complex.
    # We can use the symmetric polynomial approach derived analytically.
    
    # Let X = e1^2 = (a+b+c)^2
    # We derived X^2 - i*X + 8 + 3*I = 0
    X = symbols('X')
    roots = solve(X**2 - i*X + 8 + 3*i, X)
    
    # Calculate e2^2 for each root
    results = []
    for root in roots:
        # e2 = (2X - i)/3
        e2_val = (2*root - i) / 3
        val = expand(e2_val**2)
        results.append(val)
        
    return str(results)

if __name__ == "__main__":
