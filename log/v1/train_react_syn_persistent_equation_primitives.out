    # x^4 - 4a*x^3 + (6a^2 - 2b)*x^2 - 4a(a^2-b)*x + ((a^2-b)^2 - c) = 0
    
    # Match coefficients with x^4 - 20x^3 + 108x^2 - kx + 9
    
    # Coefficient of x^3: -4a = -20
