--- Synthesized Tool Code ---
from typing import List

def calculate_powers_of_two(powers: List[int]) -> int:
    """
    Calculates the sum of 2 raised to the power of each integer in the input list.
    
    Args:
        powers: A list of non-negative integers.
        
    Returns:
        The integer sum of 2^p for each p in the list.
    """
    total_sum = 0
    for p in powers:
        total_sum += 1 << p
    return total_sum

def solve_problem() -> str:
    """
    Solves the problem: How many nonempty subsets of {1, ..., 12} have sum of min and max equal to 13?
    
    Returns:
        The count as a string.
    """
    # Valid pairs (min, max) for min + max = 13 with min < max from the set {1, ..., 12}
    pairs = [(1, 12), (2, 11), (3, 10), (4, 9), (5, 8), (6, 7)]
    
    # For each pair, the number of elements strictly between them is (max - min - 1).
    # We can choose any subset of these intermediate elements.
    # The number of ways is 2^(max - min - 1).
    powers_list = []
    for m, M in pairs:
        k = M - m - 1
        powers_list.append(k)
        
    result = calculate_powers_of_two(powers_list)
    return str(result)

