from math import prod

def count_meals(burger_choices: int, side_choices: int, drink_choices: int) -> str:
    """
    Calculates the total number of different meals possible given independent choices
    for burgers, sides, and drinks using the multiplication principle.
    
    Parameters:
    burger_choices (int): Number of burger options available.
    side_choices (int): Number of side options available.
    drink_choices (int): Number of drink options available.
    
    Returns:
    str: The total number of distinct meal combinations as a string.
    """
    total_combinations = burger_choices * side_choices * drink_choices
    return str(total_combinations)

def verify_calculation(burger_choices: int, side_choices: int, drink_choices: int) -> str:
    """
    Verifies the meal count calculation by computing the product of input choices.
    This function serves as a cross-check for the primary counting function.
    
    Parameters:
    burger_choices (int): Number of burger options.
    side_choices (int): Number of side options.
    drink_choices (int): Number of drink options.
    
    Returns:
    str: The calculated product as a string, ensuring correctness.
    """
    result = burger_choices * side_choices * drink_choices
    return str(result)

def main() -> str:
    """
    Main function to solve the specific problem instance.
    Computes the total number of meals for 5 burgers, 3 sides, and 12 drinks.
    
    Returns:
    str: The final integer answer represented as a string.
    """
    burgers = 5
    sides = 3
    drinks = 12
    
    answer = count_meals(burgers, sides, drinks)
    return verify_calculation(burgers, sides, drinks)

