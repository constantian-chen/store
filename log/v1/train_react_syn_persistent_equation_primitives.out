from math import factorial, log, exp, isqrt

def multinomial_log_prob(n, k, counts):
    """Approximate log probability of multinomial outcome with given counts."""
    # Using Stirling's approximation for large factorials
    # log(n!) ~ (n + 0.5) log(n) - n + 0.5*log(2*pi)
    # But for ratio, many terms cancel.
    # We can compute log(n!) - sum log(count!)
    def lgamma_approx(x):
        if x < 0: return float('-inf')
        return (x + 0.5) * log(x + 0.5) - x
    total = lgamma_approx(n)
    for c in counts:
        total -= lgamma_approx(c)
    return total

