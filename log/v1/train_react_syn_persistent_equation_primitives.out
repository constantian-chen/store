import math

def solve_parallelogram():
    """
    Computes the length of side BC of the parallelogram ABCD given the partition
    of diagonal BD by circles passing through specific points.
    
    Logic:
    1. Let BD = 289 (sum of 200, 9, 80).
    2. Using power of a point for B wrt omega1 and D wrt omega2, derived relations involving L=AB, u, W=BC.
    3. Found W^2 = BD^2 - (BD_I + BD_II)*BD where segments are involved?
       Actually derived W^2 = BD * (BD - 280).
       Wait, derivation: W^2 = 289^2 - 280*289 = 289*(289-280) = 289*9.
       This matches 289^2 - 280*289.
    4. Result W = 51.
    """
    segment1 = 200
    segment2 = 9
    segment3 = 80
    bd = segment1 + segment2 + segment3  # 289
    
    # Derived formula: BC^2 = BD^2 - (segment1 + segment2) * BD
    # Let's re-verify the term.
    # L(L-2u) = (200+80)*BD = 280*BD
    # BC^2 = BD^2 - L^2 + 2uL
    # 2uL = L(L - 280*BD/L) = L^2 - 280*BD
    # BC^2 = BD^2 - L^2 + L^2 - 280*BD = BD^2 - 280*BD
    bc_squared = bd**2 - 280 * bd
    bc = int(math.isqrt(bc_squared))
    
    return str(bc)

