from math import floor

def count_solutions():
    """
    Calculates the total number of positive integer solutions to (a-b)(a+b)+(a-b)c = 2012.
    The equation simplifies to (a-b)(a+b+c) = 2012.
    Let x = a-b and y = a+b+c. Then x*y = 2012.
    Constraints: a,b,c >= 1 integers. This implies x > 0 and y > x + 2 (since 2b+c >= 3).
    For each valid x, count pairs (b,c) satisfying 2b+c = y-x.
    """
    target = 2012
    total_solutions = 0
    
    # Iterate over divisors of 2012
    for x in range(1, target + 1):
        if target % x == 0:
            y = target // x
            # Condition derived from 2b + c = y - x with b,c >= 1
            # 2b >= 2, c >= 1 => 2b + c >= 3 => y - x >= 3
            if y - x >= 3:
                max_b = (y - x - 1) // 2
                if max_b >= 1:
                    total_solutions += max_b
    
    return str(total_solutions)

if __name__ == "__main__":
    result = count_solutions()
    (print(result))

