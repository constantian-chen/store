def solve_trailing_zeroes(target_zeros):
    """
    Finds the smallest n such that n! ends in exactly target_zeros zeroes.
    Uses binary search over the range of possible n values based on the approximation n ≈ target_zeros * 4.
    """
    # Lower bound estimate is target_zeros * 4 (since n/5 + n/25 + ... approx n/4)
    # Upper bound can be slightly higher, e.g., target_zeros * 5
    low = target_zeros * 4
    high = target_zeros * 5
    
    # Helper to calculate trailing zeroes for a given n
    def count_zeroes(n):
        count = 0
        div = 5
        while div <= n:
            count += n // div
            div *= 5
        return count

    while low <= high:
        mid = (low + high) // 2
        c = count_zeroes(mid)
        if c == target_zeros:
