def compute_bc_squared():
    from sympy import symbols, solve, sqrt, S
    u = symbols('u')
    # Equation: u**2 + u - 4 = 0
    # Roots: (-1 + sqrt(17))/2
    # We take the positive root.
    root1 = (-1 + sqrt(17)) / 2
    # Check if root1 > 0
    if root1 < 0:
        return "Invalid"
    # BC^2 = 4 * u
    ans = 4 * root1
    # Simplify
    ans_simplified = ans.simplify()
    return str(ans_simplified)

def finalize_answer():
    return compute_bc_squared()

