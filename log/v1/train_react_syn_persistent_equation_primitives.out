        res = compute_product(list(p))
        if res == "1":
            val = 1.0
        elif res == "-1":
            val = -1.0
        else:
            val = float(res)
            
        if min_val is None or val < min_val:
            min_val = val
            
    if min_val is None:
        return "Error"
    
    if min_val == -1.0:
        return "-1"
    elif min_val == 1.0:
