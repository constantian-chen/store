import math
from itertools import combinations

def calculate_total_area_sum(n: int, m: int) -> str:
    """
    Calculates the sum of areas of all lattice paths from (0,0) to (n,m)
    using unit steps up and right. The area is bounded by the path,
    the x-axis, and the line x=n.
    
    The sum is equivalent to the number of pairs (U, R) in all paths
    such that U comes before R.
    Formula: Total Sum = C(n+m, n) * (n * m) / 2
    
    Parameters:
    n (int): Number of right steps.
    m (int): Number of up steps.
    
    Returns:
    str: The total sum of areas as a string.
    """
    a = n
    b = m
    total_perms = math.comb(a + b, a)
    avg_area = (a * b) / 2
    total_sum = total_perms * avg_area
    return str(int(total_sum))

def verify_with_combinatorial_arg_1(n: int, m: int) -> str:
    """
    Verifies the result by calculating C(n+m-2, m-1) * C(n+m, 2).
    This counts the number of pairs (u, r) in all paths where u < r.
    
    Parameters:
    n (int): Number of right steps.
    m (int): Number of up steps.
    
    Returns:
    str: The calculated sum as a string.
    """
    term1 = math.comb(n + m - 2, m - 1)
    term2 = math.comb(n + m, 2)
    result = term1 * term2
    return str(result)

def verify_with_combinatorial_arg_2(n: int, m: int) -> str:
    """
    Verifies the result using the formula derived from expected value:
    C(n+m, m) * (n * m) / 2.
    
    Parameters:
    n (int): Number of right steps.
    m (int): Number of up steps.
    
    Returns:
    str: The calculated sum as a string.
    """
    total_paths = math.comb(n + m, m)
    sum_val = total_paths * n * m // 2
    return str(sum_val)

