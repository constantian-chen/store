# Function to calculate v_p(n!) using Legendre's Formula
def v_p_factorial(n: int, p: int) -> int:
    """
    Calculates the exponent of prime p in the prime factorization of n!.
    Uses Legendre's Formula: v_p(n!) = sum(floor(n / p^k)) for k >= 1.
    
    Args:
        n (int): The number.
        p (int): The prime number.
        
    Returns:
        int: The exponent of p in n!.
    """
    count = 0
    power_of_p = p
    while power_of_p <= n:
        count += n // power_of_p
        power_of_p *= p
    return count

# Function to solve the specific problem
def solve_problem() -> str:
    """
    Finds the number of positive divisors d of 15! such that gcd(d, 60) = 5.
    
    Returns:
        str: The count of such divisors as a string.
    """
    n = 15
    target_gcd = 60
    
    # Prime factorization of 60: 2^2 * 3^1 * 5^1
    # Constraints on d based on gcd(d, 60) = 5:
    # - v_2(d) must be 0 (since min(v_2(d), 2) = 0)
    # - v_3(d) must be 0 (since min(v_3(d), 1) = 0)
    # - v_5(d) must be >= 1 (since min(v_5(d), 1) = 1)
    
    # Calculate maximum exponents for primes in n!
    primes = [2, 3, 5, 7, 11, 13]
    
    total_ways = 1
    
    for p in primes:
        max_exp = v_p_factorial(n, p)
        
        if p == 2:
            # Must be 0
            choices = 1 if max_exp >= 0 else 0
        elif p == 3:
            # Must be 0
            choices = 1 if max_exp >= 0 else 0
        elif p == 5:
            # Must be >= 1
            if max_exp >= 1:
                choices = max_exp  # Values from 1 to max_exp inclusive
            else:
                choices = 0
        else:
            # No constraint from gcd condition, can be anything from 0 to max_exp
            choices = max_exp + 1
        
        total_ways *= choices
        
    return str(total_ways)

