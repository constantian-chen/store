def solve_expected_numbers():
    """
    Calculates the expected number of numbers in a random circular permutation of 1-10
    that are at least 2 larger than at least one adjacent neighbor.
    
    Returns:
        str: The exact expected value as a reduced fraction string.
    """
    n = 10
    total_pairs = 9  # n-1
    comb_n_minus_1_2 = 36  # n-1 choose 2 for the sample space of neighbors
    
    probabilities = []
    
    for k in range(1, n + 1):
        # Identify neighbors that would cause the condition to hold (good neighbors)
        # Condition: k >= neighbor + 2  =>  neighbor <= k - 2
        # We count total pairs of neighbors (u, v) from S \ {k}
        # Success if at least one of u, v is <= k-2
        
        # It's easier to count failure: both u, v > k-2 => both >= k-1
        # Bad set B = {x in S \ {k} : x >= k-1}
        # Let's manually construct B to be safe
        
        valid_neighbors = [x for x in range(1, n + 1) if x != k]
        
        bad_neighbors = [x for x in valid_neighbors if x >= k - 1]
        b = len(bad_neighbors)
        
        # Number of ways to choose 2 bad neighbors
        if b >= 2:
            ways_fail = (b * (b - 1)) // 2
        else:
            ways_fail = 0
            
        prob_fail = Fraction(ways_fail, comb_n_minus_1_2)
        prob_success = 1 - prob_fail
        probabilities.append(prob_success)
        
    expected_sum = sum(probabilities)
    return str(expected_sum)

