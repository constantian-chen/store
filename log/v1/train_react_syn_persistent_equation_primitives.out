from sympy import nroots, Poly, N

def solve_problem():
    # Define the polynomial coefficients for 3t^3 - 18t^2 - 2t + 1 = 0
    coeffs = [3, -18, -2, 1]
    poly = Poly(coeffs, 't')
    
    # Find numerical roots
    roots = [complex(r) for r in nroots(poly)]
    
    # Filter real roots and sort
    real_roots = [root.real for root in roots if abs(root.imag) < 1e-10]
    real_roots.sort()  # c <= b <= a
    
    # a is the largest root
    a = real_roots[-1]
    
    # Compute a^5
    val = a ** 5
    
    # Return nearest integer
    return str(round(val))

sys.std = solve_problem()
print(sys.std)

