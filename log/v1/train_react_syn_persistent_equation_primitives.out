--- Synthesized Tool Code ---
import math

def count_divisors(n: int) -> int:
    """
    Counts the number of positive divisors of a non-negative integer n.
    If n=0, returns 0 (though product is never 0 here).
    """
    if n == 0:
        return 0
    count = 0
    i = 1
    while i * i <= n:
        if n % i == 0:
            if i * i == n:
                count += 1
            else:
                count += 2
        i += 1
    return count

def solve() -> str:
    """
    Computes the expected number of positive integers that divide the product of the elements of a randomly chosen subset of {1, ..., 10}.
    """
    nums = list(range(1, 11))
    n = len(nums)
    total_expectation_sum = 0
    
    # Iterate over all 2^n subsets using bitmask
    total_subsets = 1 << n
    for mask in range(total_subsets):
        product = 1
        for i in range(n):
            if (mask >> i) & 1:
                product *= nums[i]
        
        # Add the number of divisors for this product to the sum
        total_expectation_sum += count_divisors(product)
    
    expected_value = total_expectation_sum / total_subsets
    return str(expected_value)

if __name__ == "__main__": # This block should not be executed in the final output string, but included for completeness in file
    print(solve())

