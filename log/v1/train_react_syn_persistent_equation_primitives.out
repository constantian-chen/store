    Verifies by simulation that for a random variable X uniform on 1..6,
    X mod 6 is uniform on 0..5.
    This confirms the theoretical basis for the main solution.
    
    Returns:
        str: A confirmation message.
    '''
    from collections import Counter
    counts = Counter()
    for i in range(1, 7):
        counts[i % 6] += 1
    
    # Check if all counts are 1
    is_uniform = all(c == 1 for c in counts.values())
    return "Uniform distribution confirmed." if is_uniform else "Distribution not uniform."

