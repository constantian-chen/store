import sympy as sp

def calculate_hexagon_area():
    """
    Calculates the area of the specified equilateral hexagon using the decomposition method.
    The hexagon is embedded in a bounding box with corner triangles removed.
    Returns the area as an exact symbolic string.
    """
    # Define the symbolic variable for sqrt(3)
    sqrt3 = sp.sqrt(3)
    
    # Dimensions of the bounding box
    # Width = 1.5 = 3/2
    # Height = 1 + sqrt(3)/2
    width = sp.Rational(3, 2)
    height = 1 + sqrt3 / 2
    
    # Area of the bounding rectangle
    rect_area = width * height
    
    # Dimensions of the cut-off triangles
    # Both triangles are right-angled with legs 0.5 and sqrt(3)/2
    base_cut = sp.Rational(1, 2)
    height_cut = sqrt3 / 2
    
    # Area of one triangle
    triangle_area = (1/2) * base_cut * height_cut
    
    # Total area = Rectangle - 2 * Triangle
    # Note: 1/2 is a float, convert to Rational for exactness
    triangle_area_exact = sp.Rational(1, 2) * base_cut * height_cut
    total_area = rect_area - 2 * triangle_area_exact
    
    # Simplify the result
    return str(sp.simplify(total_area))

