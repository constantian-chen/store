from fractions import Fraction

def solve_min_sq_areas():
    # Define the triangle vertices and geometry constants
    # A = (0,0), B = (5,0), C = (1.8, 2.4)
    # AC: y = (4/3)x, BC: y = (3/4)(5-x)
    # P is left square, Q is right square, touching at k
    # P touches AC at top-left: s1 = (4/3)*xP, xP = k - s1 => s1 = 4/7 * k
    # Q touches BC at top-right: s2 = (3/4)*(5 - (k+s2)) => s2 = 3/7 * (5-k)
    # Constraints: k >= 45/37 (for s2 <= AC at k) and k <= 5.
    # Minimize s1^2 + s2^2 = (16/49)k^2 + (9/49)(5-k)^2
    
    # Coefficients of quadratic in k: A*k^2 + B*k + C
    # Area(k) = (16/49)k^2 + (9/49)(25 - 10k + k^2)
    #         = (25/49)k^2 - (90/49)k + 225/49
    # Minimum at k = -B/(2A) = (90/49) / (50/49) = 1.8
    
    k_opt = Fraction(9, 5)
    s1 = Fraction(4, 7) * k_opt
    s2 = Fraction(3, 7) * (5 - k_opt)
    
    total_area = s1**2 + s2**2
    return str(total_area)

