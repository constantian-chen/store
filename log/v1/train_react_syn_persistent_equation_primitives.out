from fractions import Fraction

def solve_triangle_area():
    # Define the segments DB and CD
    db = 3.0
    cd = 2.0
    
    # Base BC length
    bc = db + cd
    
    # We derived the equation h^4 - 37h^2 + 36 = 0 from the cosine condition
    # Solutions for h^2 are 1 and 36.
    # We must check which one yields angle 45 degrees (dot product > 0).
    # Condition: (h^2 - (db*cd)) / sqrt((h^2+db^2)(h^2+cd^2)) > 0
    # Simplifies to h^2 > db*cd
    
    # Possible squared heights
    h2_candidates = [db * cd]  # 6, not a root, just checking threshold logic? 
    # Actually roots are 1 and 36. 1 < 6 (reject), 36 > 6 (accept).
    
    # Calculate roots exactly
    import math
    # u^2 - 37u + 36 = 0 -> u = (37 +/- sqrt(37^2 - 4*36))/2 = (37 +/- sqrt(1252-144? No. 1369-144=1225))/2
    # sqrt(1225) = 35
    # u = (37 +/- 35)/2 -> u1 = 1, u2 = 36.
    
    h2_high = 36.0
    h2_low = 1.0
    
    # Check condition h^2 > db * cd = 6
    if h2_low > db * cd:
        h = math.sqrt(h2_low)
    elif h2_high > db * cd:
        h = math.sqrt(h2_high)
        final_h = h
    else:
        final_h = None # Should not happen
        
    # Calculate Area
    area = 0.5 * bc * final_h
    
    # Return as string
    return str(int(area))

def verify_geometry(h, db, cd):
    # Verify angle is 45
    # A=(0,h), B=(-db, 0), C=(cd, 0)
    # Vectors AB = (-db, -h), AC = (cd, -h)
    dot = -db*cd + h*h
    mag_ab = math.sqrt(db**2 + h**2)
    mag_ac = math.sqrt(cd**2 + h**2)
    cos_angle = dot / (mag_ab * mag_ac)
    angle_rad = math.acos(max(-1, min(1, cos_angle)))
    angle_deg = math.degrees(angle_rad)
    return angle_deg

def compute_final_answer():
    db = 3
    cd = 2
    # Known valid h from reasoning is 6
    h = 6
    bc = db + cd
    area = 0.5 * bc * h
    return str(area)

