def solve_permutation_displacement(n: int) -> str:
    """
    Calculates the number of permutations of {1, ..., n} such that 
    for all i, |i - pi[i]| <= 1.
    This corresponds to the number of ways to tile a 1xn strip with
    monominoes (fixed points) and dominoes (swaps of adjacent elements).
    The recurrence is a(n) = a(n-1) + a(n-2) with a(1)=1, a(2)=2.
    This yields a(n) = F_{n+1} where F is the Fibonacci sequence with F_1=1, F_2=1.
    
    Args:
        n: The number of blocks/people. Must be a positive integer.
        
    Returns:
        The number of valid pairings as a string.
    """
    if n <= 0:
        return "0"
    if n == 1:
        return "1"
    if n == 2:
        return "2"
    
    # Compute Fibonacci numbers up to index n+1
    # We need F_{n+1}
    # Let's use an iterative approach for exact arithmetic
    # f_prev corresponds to F_k, f_curr to F_{k+1}
    # We want F_{n+1}
    
    # F_1 = 1, F_2 = 1
    # A_1 = F_2 = 1
    # A_n = F_{n+1}
    
    # Initialize F_1, F_2
    fib_1 = 1  # F_1
    fib_2 = 1  # F_2
    
    # We need to iterate to find F_{n+1}
    # Start from k=2 up to n
    # At step k, current is F_{k+1}
    
    # If n=1, need F_2 (1). Loop doesn't run? 
    # Let's trace:
    # target index = n + 1
    # If target is 1 -> 1
    # If target is 2 -> 1
    # If target is 3 -> 2
    
    target = n + 1
    if target == 1:
        return "1" # Technically F_1 but context implies n>=1
    if target == 2:
        return "1" # F_2
        
    # Sequence generation
    # f_a = F_i, f_b = F_{i+1}
    # Start with F_1, F_2
    f_a, f_b = 1, 1
    # We want to reach F_{target}
    # Current state: a=F_1, b=F_2
    # Loop runs (target - 2) times to get to F_{target}
    # After 1 run: a=F_2, b=F_3
    # ...
    
    for _ in range(target - 2):
        f_a, f_b = f_b, f_a + f_b
        
    return str(f_b)

