from sympy import symbols, solve, sqrt

def solve_intersection_sum():
    """
    Calculates the sum of the x-coordinates of the distinct points of intersection
    of the curves x^2 = x + y + 4 and y^2 = y - 15*x + 36.
    """
    x, y = symbols('x y')
    
    # Define equations
    # Eq1: x^2 - x - y - 4 = 0 -> y = x^2 - x - 4
    eq1 = x**2 - x - 4 - y
    
    # Eq2: y^2 - y + 15*x - 36 = 0
    eq2 = y**2 - y + 15*x - 36
    
    # Substitute y from eq1 into eq2
    y_expr = x**2 - x - 4
    poly_eq = eq2.subs(y, y_expr)
    
    # Get roots of the polynomial
    roots = solve(poly_eq, x)
    
    # Filter for real roots and distinct values due to floating point issues if any,
    # but here symbolic math gives exact roots.
    # Roots are 2 (mult 2), -1+sqrt(5), -1-sqrt(5)
    # Distinct roots are 2, -1+sqrt(5), -1-sqrt(5)
    
    distinct_roots = []
    for r in roots:
        # Check if r is already in distinct_roots (handling floating point approximation if evalf is used, 
        # but here we keep symbolic)
        is_new = True
        for d in distinct_roots:
            if d == r:
                is_new = False
                break
        if is_new:
            distinct_roots.append(r)
            
    # Calculate sum
    total_sum = sum(distinct_roots)
    
    # Return as a string
    return str(total_sum) if total_sum.is_real else str(total_sum)

print(solve_intersection_sum())

