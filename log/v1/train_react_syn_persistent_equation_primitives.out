def solve_grid_sum():
    """
    Solves the problem of finding the minimum sum of four positive integers in a 2x2 grid
    given that the sum of the grid numbers and their row/column products is 2015.
    
    The relationship derived is (x+1)(y+1) = 2016 where x=a+d and y=b+c.
    We minimize x+y by finding factors of 2016 closest to sqrt(2016).
    """
    target = 2015
    # S + 1 = (x+1)(y+1)
    product_val = target + 1
    
    # We want to factor N = product_val into X * Y such that X >= 3, Y >= 3
    # and (X + Y) is minimized.
    # This happens when X and Y are as close as possible to sqrt(N).
    
    import math
    
    sqrt_n = math.isqrt(product_val)
    best_sum = float('inf')
    
    # Iterate factors from sqrt_n down to 3
    # If i divides N, then j = N/i. Check if i >= 3 and j >= 3.
    # Since we want closest, we start from sqrt and go down.
    # The first valid pair (where i and j are integers) that satisfies constraints will be optimal.
    
    for i in range(int(math.sqrt(product_val)), 2, -1):
        if product_val % i == 0:
            j = product_val // i
            # Constraints: x = X-1 >= 2 => X >= 3. y = Y-1 >= 2 => Y >= 3.
            if i >= 3 and j >= 3:
                current_sum = i + j
                if current_sum < best_sum:
                    best_sum = current_sum
                break # Found the closest pair since we iterate downwards from sqrt
    
    # The required answer is x + y = (X-1) + (Y-1) = X + Y - 2
    result = best_sum - 2
    return str(result)

