import math
from fractions import Fraction

def solve_math_problem():
    """
    Computes the expected area of the union of two unit squares centered at random points in [0,1].
    Returns the result as a string "1409".
    """
    # Probability density function for the difference of two uniform variables in [0,1]
    # f(u) = 2 * (1 - u) for u in [0, 1]
    # Expected overlap length in one dimension: E[1 - u] = integral from 0 to 1 of (1-u) * 2*(1-u) du
    # = 2 * integral (1-u)^2 du = 2 * [-(1-u)^3/3] from 0 to 1 = 2 * (0 - (-1/3)) = 2/3
    
    E_overlap_1d = Fraction(2, 3)
    area_union = 2 - E_overlap_1d * E_overlap_1d
    
    # Expected area of union = 2 - (2/3)^2 = 2 - 4/9 = 14/9
    a = area_union.numerator
    b = area_union.denominator
    
    # Check if relatively prime
    if math.gcd(a, b) != 1:
        raise ValueError("a and b are not relatively prime")
        
    result_val = 100 * a + b
    return str(result_val)

