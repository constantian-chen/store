from sympy import Rational, sqrt, simplify

def solve():
    '''
    Computes the exact length of MN in the described geometric configuration.
    Uses rational arithmetic to ensure precision.
    '''
    # Side lengths
    c_AB = Rational(5)
    b_AC = Rational(4)
    a_BC = Rational(6)

    # Calculate cos(C) using Law of Cosines
    cos_C = (a_BC**2 + b_AC**2 - c_AB**2) / (2 * a_BC * b_AC)

    # Determine lengths of segments MC and NC based on ratios derived from parallels and angle bisector
    factor_M = Rational(2, 5)
    factor_N = Rational(3, 5)

    MC = factor_M * a_BC
    NC = factor_N * b_AC

    # Calculate MN^2 and then MN using Law of Cosines on triangle MNC
    MN_sq = MC**2 + NC**2 - 2 * MC * NC * cos_C
    MN = sqrt(MN_sq)

