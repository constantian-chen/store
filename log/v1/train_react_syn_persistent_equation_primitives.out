import math
from functools import reduce

def count_combinations():
    """
    Calculates the number of ways to pair up 5 cows, 4 pigs, and 7 horses
    such that no pair consists of animals of the same species.
    Returns the result as a string.
    """
    # Number of cows, pigs, horses
    cows = 5
    pigs = 4
    horses = 7
    
    # Solve the system of equations for the number of pairs of each type:
    # C_P + C_H = cows
    # C_P + P_H = pigs
    # C_H + P_H = horses
    # Solution derived: C_P = 1, C_H = 4, P_H = 3
    C_P = 1
    C_H = 4
    P_H = 3
    
    # Ways to choose which cows go with pigs vs horses
    ways_cows = math.comb(cows, C_P)
    
    # Ways to choose which pigs go with cows vs horses
    ways_pigs = math.comb(pigs, C_P)
    
    # Ways to choose which horses go with cows vs pigs
    ways_horses = math.comb(horses, C_H)
    
    # Ways to match the selected groups
    match_Cw_Hh = math.factorial(C_H)  # Matching C_H cows with C_H horses
    match_Ph_Hp = math.factorial(P_H)  # Matching P_H pigs with P_H horses
    match_CP_Pc = math.factorial(C_P)  # Matching C_P cows with C_P pigs (1! = 1)
    
    total_ways = ways_cows * ways_pigs * ways_horses * match_Cw_Hh * match_Ph_Hp * match_CP_Pc
    
    return str(total_ways)

def verify_calculation():
    """
    Secondary function to verify the manual arithmetic steps using a calculator-like approach.
    """
    val = 5 * 4 * 35 * 24 * 6
    return str(int(val))

def solve_and_verify():
    return count_combinations() + " " + verify_calculation()

