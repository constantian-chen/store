def simulate_max_zero(limit):
    S = 0
    k = 0
    zeros = []
    while k < limit:
        k += 1
        if S < k:
            a = 1
        else:
            a = -1
        S = S + k * a
        if S == 0:
            zeros.append(k)
    return zeros

def solve():
    zeros = simulate_max_zero(2010)
    return str(zeros[-1])

