--- Synthesized Tool Code ---
from sympy import Rational, Symbol, integrate

def solve_probability():
    # Define symbols
    h = Rational(1, 2)
    n = 3
    
    # Formula for CDF of range R for n i.i.d. U[0,1] variables:
    # P(R <= h) = n * h^(n-1) - (n-1) * h^n
    prob_1d = n * (h**(n-1)) - (n-1) * (h**n)
    
    # Total probability is the cube of the 1D probability
    total_prob = prob_1d ** 3
    
    return str(int(total_prob))

