from fractions import Fraction

def solve_sherry_train_probability():
    """
    Calculates the probability that Sherry catches the train in the next five minutes.
    Each minute, probability of train arriving is 3/4, probability of noticing is 1/4.
    Catch probability per minute = (3/4) * (1/4) = 3/16.
    Miss probability per minute = 1 - 3/16 = 13/16.
    Prob(catch in 5 mins) = 1 - (13/16)^5.
    Returns the result as a string representation of the reduced fraction.
    """
    # Probabilities as Fractions for exact arithmetic
    p_catch_per_minute = Fraction(3, 16)
    p_miss_per_minute = Fraction(13, 16)
    n_minutes = 5
    
    # Probability of missing all 5 minutes
    p_miss_all = p_miss_per_minute ** n_minutes
    
    # Probability of catching at least one train
    p_catch_at_least_one = Fraction(1, 1) - p_miss_all
    
    return str(p_catch_at_least_one)

