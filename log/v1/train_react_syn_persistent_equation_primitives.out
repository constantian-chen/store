import sympy
from sympy import Symbol, simplify, diff

def solve_min_area():
    """
    Solves the problem of finding the time t < 3 that minimizes the area 
    of the triangle formed by ants moving cyclically around a 3-4-5 right triangle.
    """
    t = Symbol('t')
    
    # Coordinates of the ants at time t
    # A starts at (0,3), moves to B(4,0)
    # B starts at (4,0), moves to C(0,0)
    # C starts at (0,0), moves to A(0,3)
    
    # Ant A
    xA = 4/5 * t
    yA = 3 - 3/5 * t
    
    # Ant B
    xB = 4 - t
    yB = 0
    
    # Ant C
    xC = 0
    yC = t
    
    # Area using shoelace formula: 0.5 * |x1(y2-y3) + x2(y3-y1) + x3(y1-y2)|
    # Or determinant of vectors (B-A) and (C-A)
    
    vec1_x = xB - xA
    vec1_y = yB - yA
    vec2_x = xC - xA
    vec2_y = yC - yA
    
    cross = vec1_x * vec2_y - vec1_y * vec2_x
    area_expr = simplify(simplify((cross / 2).abs()))
    
    # Since we know the parabola opens upwards (after taking abs), we minimize the quadratic inside
    # The expression inside abs is -1.2t^2 + 4.7t - 6. Since discriminant < 0 and coeff < 0, it's always negative.
    # So Area = -(cross/2) = 1.2t^2 - 4.7t + 6
    # Derivative to find min:
    d_area = diff(1.2*t**2 - 4.7*t + 6, t)
    
    # Solve d_area = 0
    crit_points = sympy.solve(d_area, t)
    
    # Filter t < 3 and t > 0
    valid_solutions = [sol for sol in crit_points if 0 < sol < 3]
    
    if valid_solutions:
        return str(float(valid_solutions[0]))
    else:
