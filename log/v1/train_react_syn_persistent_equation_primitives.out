def count_pairs_xy():
    """
    Counts the number of integer pairs (x, y) such that x^2 + 2*y^2 < 25.
    
    Returns:
        str: The count of such pairs.
    """
    count = 0
    # Determine bounds for y: 2*y^2 < 25 => y^2 < 12.5 => |y| <= 3
    for y in range(-3, 4):
        max_x_sq = 24 - 2 * y * y
        if max_x_sq < 0:
            continue
        # Determine bounds for x: x^2 < max_x_sq + 1 (since strictly less than)
        # Actually we iterate x directly or calculate range.
        # ceil(sqrt(max_x_sq)) is the exclusive upper bound.
        import math
        limit_x = int(math.sqrt(max_x_sq + 1e-9)) + 1
        # x ranges from -limit_x + 1 to limit_x - 1
        # But simpler: iterate x
        x_start = -limit_x
        x_end = limit_x
        # Check specific condition to ensure strict inequality
        for x in range(x_start, x_end + 1):
            if x*x + 2*y*y < 25:
                count += 1
    return str(count)

def verify_result():
    """
    Verifies the count by iterating all reasonable x and y.
    Returns:
        str: 'True' if the previous function's logic holds up in a brute force check.
    """
    count = 0
    for x in range(-10, 11):
        for y in range(-10, 11):
            if x*x + 2*y*y < 25:
                count += 1
    return str(count)

def main():
