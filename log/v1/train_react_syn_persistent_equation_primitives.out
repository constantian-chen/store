from typing import List

def count_dna_sequences() -> str:
    """
    Counts the number of possible DNA sequences on Rthea.
    
    Returns:
        str: The count as a string.
    """
    # Transition matrix M for states [Type1, Type2, Type3, Type4]
    # Type1: (A, A), Type2: (B, B), Type3: (A, B), Type4: (B, A)
    M = [
        [1, 2, 1, 1],
        [2, 1, 1, 1],
        [1, 1, 1, 4],
        [1, 1, 4, 1]
    ]
    
    # Initial state for n=1
    # Type1: 2, Type2: 2, Type3: 4, Type4: 4
    state: List[int] = [2, 2, 4, 4]
    
    # Apply transition 4 times to get n=5
    for _ in range(4):
        new_state: List[int] = [
            M[0][0]*state[0] + M[0][1]*state[1] + M[0][2]*state[2] + M[0][3]*state[3],
            M[1][0]*state[0] + M[1][1]*state[1] + M[1][2]*state[2] + M[1][3]*state[3],
            M[2][0]*state[0] + M[2][1]*state[1] + M[2][2]*state[2] + M[2][3]*state[3],
            M[3][0]*state[0] + M[3][1]*state[1] + M[3][2]*state[2] + M[3][3]*state[3]
        ]
        state = new_state
    
    total = sum(state)
    return str(total)

