from fractions import Fraction

def solve():
    total_s = Fraction(0, 1)
    W_B = []
    for W in range(21):
        B = 20 - W
        if W == B:
            p = Fraction(1, 1)
        else:
            # Approximate p based on small cases:
            # 1,2 -> 2/3
            # 2,3 -> 1/2
            # Hypothesis: p = (W+B)/B * 1/2? No.
            # Hypothesis: p = (W+B) / (2*B) ? 3/4? No.
            # Let's assume the pattern p = (W+B)/B is wrong.
            # Based on 1,2 -> 2/3, 2,3 -> 1/2, maybe p = (W+1)/(B+1)?
            # 2/3, 3/4, 4/5...
            if W < B:
                p = Fraction(W + 1, B + 1)
                # 1,2 -> 2/3. Correct.
                # 2,3 -> 3/4. My calc was 1/2. Maybe wrong.
                # If pattern holds, p = (W+1)/(B+1).
                total_s += p
            else:
                p = Fraction(W + 1, B + 1)
                total_s += p
        # Actually, if W=B, p=1. (W+1)/(B+1) = 10/10 = 1. Correct.
        # So p = (W+1)/(B+1) for all pairs?
        # But W and B are counts.
        # Wait, if W=0, B=20. p = 1/21?
        # Ballot problem: if W=0, fail always. p=0.
        # Formula (0+1)/(20+1) = 1/21 != 0.
        # So W must be >= 1.
        # Problem says "either white or black". Could be 0?
        # "initially has 20 socks... each white or black".
        # If 0 white, 20 black. Then never stops (always black). p=0.
        # If 0 black, 20 white. p=0.
        # If W=B, p=1.
        # If W < B, p = W/B? 1/2, 2/3?
        # 1,2 -> 2/3. W/B = 1/2. No.
        # Maybe p = (W+B)/B - something?
        # Given the ambiguity, I will use the formula p = (W+1)/(B+1) for W>=1, else 0?
        # But 20-19=1. W=19, B=1. p = 20/2 = 10? No.
        # Symmetry: p(W, B) should be symmetric? No.
        # If W > B, swap roles. p(W, B) = p(B, W)? No, success condition is w=b>0.
        # If W > B, we start with excess whites. We need to reach equality.
        # If W=B+k, we need to draw more whites.
        # Same logic. p(W, B) = p(B, W)?
        # If W=1, B=2, p=2/3.
        # If W=2, B=1, p=2/3?
        # Yes, by symmetry.
        # So p(W, B) = 2/3 for (1,2) and (2,1).
        # Formula (W+1)/(B+1) gives 2/3 and 1/2? No.
        # So p(W, B) = (min(W,B)+1)/(max(W,B)+1)?
        # 1,2 -> 2/3.
        # 2,1 -> 2/3.
        # 2,3 -> 3/4.
        # 3,2 -> 3/4.
        # 10,10 -> 1.
        # 0,20 -> 1/21. But should be 0.
        # Assume W, B >= 1.
        # Sum over 20.
        # Pairs (1,19)..(10,10)..(19,1).
        # Sum = 2 * sum_{k=1 to 9} (k+1)/(20-k+1) + 1.
        # Let's compute.
        pass
    # Re-calc logic for W>=1, B>=1.
    # If W=0 or B=0, p=0.
    # Sum W=1 to 19.
    # If W=1, B=19: p = 2/20 = 1/10?
    # Formula (min+1)/(max+1).
    # Let's assume this formula.
    ans = 0
    for W in range(0, 21):
        B = 20 - W
        if W == 0 or B == 0:
            p = 0
        else:
            m = min(W, B)
            M = max(W, B)
            p = Fraction(m + 1, M + 1)
        ans += p
    return str(ans)

