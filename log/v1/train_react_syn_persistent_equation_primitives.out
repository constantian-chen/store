def solve_expected_games():
    # Define the probabilities as Fractions for exact arithmetic
    p_odd_tim = Fraction(3, 4)  # Tim wins odd game
    p_even_tim = Fraction(1, 4) # Tim wins even game
    
    # We want E[games] starting from state (diff=0, next_game_is_odd=True)
    # Let E be the expected number of additional games from state (0, 0) (diff 0, next odd)
    # Let F be V(1, 1) (diff 1, next even)
    # Let G be V(-1, 1) (diff -1, next even)
