from fractions import Fraction
from sympy import symbols, solve, Rational

def solve_marble_probability():
    # Define variables for number of red, green, blue marbles
    r, g, b = symbols('r g b', integer=True)
    
    # Total number of marbles
    N = 97
    P_same_neil = Rational(5, 12)
    
    # Equation 1: Sum of marbles
    eq1 = r + g + b - N
    
    # Probability condition for Neil (without replacement)
    # P = (C(r,2) + C(g,2) + C(b,2)) / C(N,2) = 5/12
    # 2 * C(N,2) * P = r(r-1) + g(g-1) + b(b-1)
    total_pairs = N * (N - 1) // 2
    target_sum_pairs = 2 * total_pairs * P_same_neil
    eq2 = r*(r-1) + g*(g-1) + b*(b-1) - target_sum_pairs
    
    # We need to find integer solutions.
    # Since we cannot use a solver for Diophantine equations directly in sympy easily for this constraint set,
    # we iterate through possible values.
    
    # From r + g + b = N, we have b = N - r - g
    # Substitute b into eq2
    # But first, let's iterate r.
    # Lower bound for r > 0, g > 0, b > 0 => r < 97.
    # Also roughly r^2 + g^2 + b^2 approx 3977.
    
    found_solutions = []
    for x in range(1, N + 1):
        for y in range(1, N + 1 - x):
            z = N - x - y
            if z <= 0:
                continue
            
            val = x*(x-1) + y*(y-1) + z*(z-1)
            if val == target_sum_pairs:
                found_solutions.append((x, y, z))
                
    # There should be permutations of (53, 32, 12)
    base_solutions = []
    for sol in found_solutions:
        base_solutions.append(tuple(sorted(sol)))
    # Remove duplicates
    unique_solutions = list(set(base_solutions))
    
    # Calculate Jerry's probability with replacement
    # P = (r^2 + g^2 + b^2) / N^2
    total_prob = Fraction(0, 1)
    
