from sympy import symbols, Eq, solve, sqrt

def solve_geometry():
    u = symbols('u', real=True)
    # Equation derived: a^4 + a^2 - 4 = 0, where a^2 = u
    # Target is 4*u
    # Solve u^2 + u - 4 = 0
    eq = Eq(u**2 + u - 4, 0)
    solutions = solve(eq, u)
    # Select positive solution
    u_val = solve(eq, u)[0]
    if u_val.is_real:
        if u_val > 0:
            bc_sq = 4 * u_val
            return str(bc_sq.evalf()) # Might want exact
        else:
            return "Impossible"
    else:
        return "Impossible"

