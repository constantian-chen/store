def solve():
    n = 2019
    # Number of diagonals
    N = n
    
    # Each diagonal (i, i+3) intersects diagonals (j, j+3) where j is i-2, i-1, i+1, i+2 mod n.
    # Total intersection pairs = N * 4 / 2 = 2 * N
    intersections = 2 * N
    
    # Number of regions R = N + I + 1
    # In general position, no three diagonals are concurrent for this specific family in a convex polygon.
    # Thus, I = intersections.
    pieces = N + intersections + 1
    
    return str(pieces)

