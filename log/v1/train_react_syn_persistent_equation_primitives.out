from math import comb, prod
from fractions import Fraction

def solve_group_probability():
    """
    Computes the probability that among 5 people, each choosing 2 random targets from the other 4,
    there exists a group of 3 people such that every member in the group points at the other two members.
    
    Based on analysis:
    - Total configurations: (C(4, 2))^5 = 6^5
    - For a specific group of 3, they are fixed to point only at each other (1 way each).
    - The other 2 people have 6 choices each.
    - 10 possible groups of 3.
    - Groups are mutually exclusive.
    - Result is (10 * 6^2) / 6^5 = 10 / 324 = 5 / 108.
    """
    n_people = 5
    targets_per_person = 2
    ways_to_choose_targets = comb(n_people - 1, targets_per_person)
    total_configurations = pow(ways_to_choose_targets, n_people)
    
    num_groups = comb(n_people, 3)
    ways_per_group_fixed_targets = 1  # The 3 people in the group have only 1 valid choice each
    ways_for_others = pow(ways_to_choose_targets, n_people - 3)
    
    favorable_configurations = num_groups * ways_per_group_fixed_targets * ways_for_others
    
    prob = Fraction(favorable_configurations, total_configurations)
    return str(prob.numerator) + "/" + str(prob.denominator)

def verify_probability_naive():
    """
    Verifies the result by enumerating all possible configurations for small cases conceptually or
    ensuring the combinatorial logic holds by checking the math with fractions.
    Returns the reduced fraction string.
    """
    # Confirming the arithmetic manually within Python
    from fractions import Fraction
    numerator = 10 * (6**2)
    denominator = 6**5
    result = Fraction(numerator, denominator)
    return str(result.numerator) + "/" + str(result.denominator)

