from fractions import Fraction

def solve_geometric_sequence():
    """
    Solves for 'a' given two sequences where adding 'k' to (20, 50, 100)
    makes it a geometric progression x, ax, a^2x.
    Returns the string representation of 'a'.
    """
    # Original terms
    t1, t2, t3 = 20, 50, 100
    
    # Let added number be k
    # New terms: t1+k, t2+k, t3+k
    # These form a GP: (t2+k)/(t1+k) = (t3+k)/(t2+k) = a
    
    # Equation: (50+k)(50+k) = (20+k)(100+k)
    # k^2 + 100k + 2500 = k^2 + 120k + 2000
    # 20k = 500 => k = 25
    
    k = Fraction(500, 20)
    
    # Calculate a
    # a = (50 + k) / (20 + k)
    numerator = t2 + k
    denominator = t1 + k
    a = numerator / denominator
    
    return str(a)

