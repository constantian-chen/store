from sympy import sin, pi, simplify, N, sqrt
from fractions import Fraction

def solve_heptagon_area():
    # Define the angles for the equilateral triangle (0, 120, 240 degrees)
    tri_angles = [0, 2*pi/3, 4*pi/3]
    
    # The condition "one side of the square is parallel to one side of the triangle"
    # implies the angle difference alpha is fixed relative to the triangle.
    # We found alpha = 15 degrees (pi/12) works.
    # Let's construct the set of angles for a valid configuration.
    alpha = pi/12
    
    sq_angles = [alpha, alpha + pi/2, alpha + pi, alpha + 3*pi/2]
    
    # Combine and sort
    all_angles = tri_angles + sq_angles
    all_angles.sort()
    
    # Calculate area: 0.5 * sum(sin(theta_next - theta_curr))
    area_sum = 0
    n = len(all_angles)
    for i in range(n):
        diff = all_angles[(i+1)%n] - all_angles[i]
        # Handle wrap around for the last segment
        if all_angles[(i+1)%n] < all_angles[i]: # Should not happen in sorted list except last step
             diff = diff + 2*pi
        area_sum += sin(diff)
        
    area = 0.5 * area_sum
    
    # Simplify
    simplified_area = simplify(area)
    
    # Verify numeric value roughly
    # expected: (1 + sqrt(2) + sqrt(6))/2 approx (1 + 1.414 + 2.449)/2 = 4.863/2 = 2.4315
    
    # Convert to string representation that is "plain" (no latex)
    # sympy str usually produces readable math-like strings, but we can ensure no $ signs.
    s_area = str(simplified_area)
    
    # If it contains 'sqrt' or symbolic, that's fine as long as no latex delimiters
    # But let's force a specific clean format if needed. 
    # The problem asks for exact arithmetic.
    # Standard sympy output for (1 + sqrt(2) + sqrt(6))/2 is '1/2 + sqrt(2)/2 + sqrt(6)/2' or '(1 + sqrt(2) + sqrt(6))/2'
    
    return s_area

