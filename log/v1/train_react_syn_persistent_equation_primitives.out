[[ python_codes ## ]]
from math import gcd

def solve():
    # Total number of outcomes for 8 coin flips
    total_outcomes = 2 ** 8
    
    # We determined that the only valid run structures have 6 runs (k=6).
    # This implies 3 runs of Heads and 3 runs of Tails.
    # For Heads to have exactly 1 pair of consecutive Heads, exactly one H-run has length 2, others length 1.
    # For Tails to have exactly 1 pair of consecutive Tails, exactly one T-run has length 2, others length 1.
    # Sum of lengths = (2 + 1 + 1) + (2 + 1 + 1) = 8. Correct.
    #
    # Case 1: Sequence starts with H.
    # Run order: H, T, H, T, H, T.
    # Number of H runs = 3. Choose which one has length 2: 3 ways.
    # Number of T runs = 3. Choose which one has length 2: 3 ways.
    # Total for start H = 3 * 3 = 9.
    
    # Case 2: Sequence starts with T.
    # Run order: T, H, T, H, T, H.
    # Number of T runs = 3. Choose which one has length 2: 3 ways.
    # Number of H runs = 3. Choose which one has length 2: 3 ways.
    # Total for start T = 3 * 3 = 9.
    
    favorable_outcomes = 9 + 9
    
    # Probability p = favorable / total
    # Reduce fraction to simplest form
    g = gcd(favorable_outcomes, total_outcomes)
    a = favorable_outcomes // g
    b = total_outcomes // g
    
    result = 100 * a + b
    return str(result)

if __name__ == "__main__":
    print(solve()) 

