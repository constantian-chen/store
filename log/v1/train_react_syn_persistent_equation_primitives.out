from math import sqrt
from functools import reduce
from operator import mul

def sum_divisors(n: int) -> str:
    '''
    Calculates the sum of positive divisors of an integer n.
    Returns the result as a string.
    '''
    if n <= 0:
        return "0"
    total = 0
    i = 1
    while i * i <= n:
        if n % i == 0:
            total += i
            if i != n // i:
                total += n // i
        i += 1
    return str(total)

def solve_problem():
    '''
    Solves the problem: Let A be the sum of floor(sqrt(n) + sqrt(n+1)) for n=1 to 100.
    Find W, the sum of divisors of A.
    '''
    A = 0
    for n in range(1, 101):
        val = sqrt(n) + sqrt(n+1)
        A += int(val)
    
    # Factorization is not strictly needed if we can call sum_divisors efficiently,
    # but let's verify the value of A.
    W = sum_divisors(A)
    return W

