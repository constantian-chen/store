# Function to calculate the minimum moves based on the derived logic
def solve_math_problem(n_children, n_candies_per_child):
    """
    Solves the problem of finding the minimum number of moves to distribute candies
    so that no two children have the same number.
    Uses the strategy of chaining transfers to build a surplus in the last child,
    then distributing to the rest.
    """
    # Minimum sum of k distinct non-negative integers is k*(k-1)//2
    # here k = n_children - 1
    k = n_children - 1
    min_sum = k * (k - 1) // 2
    
    # We need the accumulated wealth to be >= min_sum
    # Wealth after m chain transfers (to child m+1): 100 + (m * 99)
    # Let m be the number of chain moves.
    # Child index m+1 receives. Total chain moves = m.
    # We need 100 + 99*m >= min_sum
    # Solve for m: 99*m >= min_sum - 100
    # m = ceil((min_sum - 100) / 99)
    # Total moves = m + 1 (for the final distribution)
    
    # Edge case: if min_sum <= 100 + 0, m=0?
    # But we need to fix n_children.
    # If n=2, k=1, min_sum=0. 100 >= 0. m=0?
    # If m=0, child 2 has 100. Distribute 0? No, need to give to 1 child.
    # The formula assumes we build a chain.
    # For n=100, min_sum is large.
    
    required_m = 0
    if min_sum > 100:
        required_m = (min_sum - 100 + 98) // 99 # Integer ceil division
    else:
        required_m = 0 # Should not happen for n=100
        
    total_moves = required_m + 1
    return str(total_moves)

def verify_calculation(n=100):
    """
    Verifies the calculation for the specific problem instance.
    """
    min_moves = solve_math_problem(n, 100)
    return min_moves

def main_solution():
    # The problem asks for the least number of moves for 100 children, 100 candies each.
    result = solve_math_problem(100, 100)
    return result

