from math import isqrt

def solve_geometry_problem():
    """
    Solves the geometry problem: Given an acute triangle ABC with orthocenter H.
    Feet of altitudes from A and B are D and E respectively.
    Given AH = 20, HD = 15, BE = 56. Find BH.
    Uses the similarity of triangles AHE and BHD and the collinearity of B, H, E.
    """
    # Given values
    AH = 20
    HD = 15
    BE = 56
    
    # Let BH = x. Since H lies on BE and the triangle is acute, H is between B and E.
    # So BE = BH + HE => HE = BE - x.
    # By similarity of right triangles AHE and BHD (since angles at E and D are 90 and angles at H are vertical),
    # we have the ratio of hypotenuse to leg corresponding to angle H:
    # AH / BH = HE / HD
    # AH / x = (BE - x) / HD
    # Cross multiply: AH * HD = x * (BE - x)
    # AH * HD = BE * x - x^2
    # x^2 - BE * x + AH * HD = 0
    
    # Coefficients for quadratic equation x^2 - ax + b = 0
    a = BE
    b = AH * HD
    
    # Discriminant
    D = a*a - 4*b
    
    if D < 0:
        return "No real solution"
    
    sqrt_D = isqrt(D)
    if sqrt_D * sqrt_D != D:
        return "No integer solution for discriminant"
    
    denom = 2
    x1 = (a + sqrt_D) // denom
    x2 = (a - sqrt_D) // denom
    
    # Check validity of solutions
    # Validity 1: BH < BE (since H is between B and E)
    # Validity 2: In triangle BHD, BH > HD (hypotenuse > leg)
    
    candidates = []
    for x in [x1, x2]:
        if x > 0 and x < BE and x > HD:
            # Verify the condition sin C <= 1 implicitly by x > HD
            # sin C = BD/BH. BD = sqrt(BH^2 - HD^2). Real if BH > HD.
            # sin C = 1? Max angle 90. Acute means < 90, so sin C < 1.
            # This is handled by the existence of the triangle.
            # We also need to check if the triangle is acute, but the problem states it is.
