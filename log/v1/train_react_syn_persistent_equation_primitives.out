def solve_triangle_secant():
    """
    Calculates the length of the chord PQ formed by the intersection of line AB 
    and the circumcircle of triangle CDE, given triangle ABC side lengths and extension rules.
    
    Returns the length PQ as a string.
    """
    from math import isqrt, sqrt
    
    # Side lengths
    AB = 15
    BC = 18
    CA = 20
    
    # Extensions
    # Extend CA to D such that DA = AB. Order C-A-D.
    CD = CA + AB
    # Extend CB to E such that BE = AB. Order C-B-E.
    CE = CB + AB
    
    # Power of point A with respect to circumcircle of CDE
    # A lies on CD. Chord is CD.
    # Power(A) = vector AC dot vector AD
    # Let C be 0, A be CA, D be CD.
    # AC = -CA, AD = CD - CA = AB
    # Power(A) = (-CA) * (AB) = -CA * AB
    power_A = -1 * CA * AB
    
    # Power of point B with respect to circumcircle of CDE
    # B lies on CE. Chord is CE.
    # Let C be 0, B be CB, E be CE.
    # BC = -CB, BE = CE - CB = AB
    # Power(B) = (-CB) * (AB) = -CB * AB
