from sympy import Integer

def solve_n_tuples(n, mod=10**9 + 7):
    # We derived a_n = (Q_{n+1})/2 - 2^n
    # Q_k follows recurrence Q_k = 2*Q_{k-1} + Q_{k-2}?? No.
    # Pell-Lucas Q_n = P_{n-1} + P_{n+1}
    # Recurrence for Q_n: Q_n = 2*Q_{n-1} + Q_{n-2}?
    # Q_1 = 2, Q_2 = 6. 2*6 - 2 = 10 != 14.
    # Correct recurrence: Q_n = 2*Q_{n-1} - 2*Q_{n-2}? No.
    # Roots 1+sqrt(2), 1-sqrt(2). Sum = 2, Prod = -1.
    # Q_n = 2*Q_{n-1} + Q_{n-2}? 2*6+2=14. Yes.
    # Q_0 = (1+2) + (1-2) = 2.
    # Q_1 = 2.
    # Q_2 = 2*2+2 = 6.
    # Q_3 = 2*6+2 = 14.
    # Q_4 = 2*14+6 = 34.
    # a_n = Q_{n+1}/2 - 2^n.
    # Compute Q_{n+1} mod (2*mod). Then divide by 2.
    
    if n == 0:
        return "0"
    
    # Compute Q_{n+1}
    # Q_0 = 2, Q_1 = 2
    q_prev2 = 2
    q_prev1 = 2
    current = 2
    for i in range(1, n+1):
        # q_i = 2*q_{i-1} + q_{i-2}
        q_curr = (2 * q_prev1 + q_prev2) % (2 * mod)
        q_prev2, q_prev1 = q_prev1, q_curr
    # Now current is Q_{n+1}
    q_np1 = current
    
    # 2^n mod mod
    pow2 = pow(2, n, mod)
    
    # a_n = (q_np1 - 2 * pow2) / 2
    # Ensure subtraction is non-negative
    num = (q_np1 - 2 * pow2) % (2 * mod)
    ans = num // 2
    
    return str(ans)

