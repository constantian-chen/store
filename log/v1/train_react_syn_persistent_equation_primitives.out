        if not (100000 <= n_val <= 999999):
            continue
            
        # Check starts with 2
        if n_val < 200000 or n_val >= 300000:
            continue
            
        # Check ends with 2
        if n_val % 10 != 2:
            continue
            
        best_n = n_val
        break # Assuming uniqueness based on monotonic growth
        
    return str(best_n)

