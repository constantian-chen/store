from sympy import symbols, Matrix

def solve_divisible_count():
    """
    Calculates the number of 3-digit numbers with digits from {1..7} 
    such that at least one cyclic permutation is divisible by 7.
    Uses the mapping to residues modulo 7 and inclusion-exclusion principle.
    """
    p = 7
    # Total residue classes for each digit
    # Number of solutions for Ax + By + Cz = 0 mod p where not all coeffs are 0 is p^2
    count_single = p ** 2
    
    # Intersection of two equations: Ax + By + Cz = 0 and Dx + Ey + Fz = 0
    # These are two distinct planes (since the coefficients are cyclic shifts 
    # and the determinant of the 2x2 minors are non-zero in the specific cases checked manually).
    # In F_p, intersection of two distinct independent planes is a line, containing p points.
    count_double = p
    
    # Intersection of three equations:
    # We verified the determinant of the full matrix is non-zero, so only the trivial solution (0,0,0).
    count_triple = 1
    
    # Principle of Inclusion-Exclusion
    total = 3 * count_single - 3 * count_double + count_triple
    return str(total)

def verify_manual_count():
    """
    Verifies the result by brute force enumeration of all 343 cases.
    This is included for robustness but the primary solution uses the analytic method.
    """
    from sympy import Matrix
    valid_count = 0
    total_count = 0
    for a in range(1, 8):
        for b in range(1, 8):
            for c in range(1, 8):
                total_count += 1
                n1 = 100*a + 10*b + c
                n2 = 100*b + 10*c + a
                n3 = 100*c + 10*a + b
                
                if n1 % 7 == 0 or n2 % 7 == 0 or n3 % 7 == 0:
                    valid_count += 1
    return str(valid_count)

