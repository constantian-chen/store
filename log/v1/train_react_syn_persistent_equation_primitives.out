from math import sqrt

def quadratic_roots_sum(n_coeff, b_coeff, c_coeff):
    """
    Solve the quadratic equation u^2 + n*u + c = 0.
    Returns the sum of the square roots of the two real roots.
    Assumes the roots are positive real numbers.
    """
    # u^2 - 147*u + 5184 = 0 => n=-147, c=5184.
    # But input as n (coeff of u)
    D = b_coeff**2 - 4 * c_coeff
    if D < 0:
        return "No real roots"
    sqrt_D = sqrt(D)
    u1 = (-b_coeff + sqrt_D) / 2.0
    u2 = (-b_coeff - sqrt_D) / 2.0
    if u1 <= 0 or u2 <= 0:
        return "Non-positive roots"
    return str(sqrt(u1) + sqrt(u2))

def solve_problem():
    """
