    def binom(n, r):
        if r < 0 or r > n:
            return 0
        num = 1
        for i in range(r):
            num = num * (n - i)
        den = 1
        for i in range(1, r + 1):
            den = den * i
        return num // den
    
    def partial_sum(k, terms):
        s = 0.0
