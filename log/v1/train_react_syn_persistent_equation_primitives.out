from fractions import Fraction
from functools import reduce
from operator import mul

def calculate_terminating_sum():
    """
    Calculates the sum of 1/n for all n where the decimal expansion of 1/n terminates.
    Such n must be of the form 2^a * 5^b. The sum is the product of two geometric series.
    Returns the result as a string representation of the simplified fraction.
    """
    # Sum for powers of 2: 1/2^0 + 1/2^1 + 1/2^2 + ...
    # First term a=0 is 1. Ratio is 1/2. Sum = 1 / (1 - 1/2) = 2.
    sum_powers_of_2 = Fraction(2, 1)
    
    # Sum for powers of 5: 1/5^0 + 1/5^1 + 1/5^2 + ...
    # First term b=0 is 1. Ratio is 1/5. Sum = 1 / (1 - 1/5) = 5/4.
    sum_powers_of_5 = Fraction(5, 4)
    
    total_sum = sum_powers_of_2 * sum_powers_of_5
    
    return str(total_sum.numerator) + "/" + str(total_sum.denominator)

