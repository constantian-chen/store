from collections import defaultdict
import sys

def solve():
    # Grid size
    N = 26
    limit = 600  # We need |cross| > 600
    
    # Offset for array indexing: max |v| = 25*25 = 625
    max_val = 625
    offset = max_val
    hist_size = 2 * max_val + 1  # 1251
    
    # Precompute histograms and prefix sums for each (dx, dy)
    # Use a 2D list
    dx_range = 51
    matrices = [[None] * dx_range for _ in range(dx_range)]
    
    # Map: dx -> idx, dy -> idx. idx = dx + 25
    # Precompute histograms
    for dx in range(-25, 26):
        idx_dx = dx + 25
        for dy in range(-25, 26):
            idx_dy = dy + 25
            if dx == 0 and dy == 0:
                matrices[idx_dx][idx_dy] = None
                continue
            
            hist = [0] * hist_size
            for x in range(N):
                for y in range(N):
                    v = dy * x - dx * y
                    # Adjust index
                    idx = v + offset
                    if 0 <= idx < hist_size:
                        hist[idx] += 1
            
            # Compute total count for debugging (optional)
            total = sum(hist)
            
            # Precompute prefix sums: prefix[i] = sum(hist[0..i])
            prefix = [0] * (hist_size + 1)
            current = 0
            for i in range(hist_size):
                current += hist[i]
                prefix[i+1] = current
            
            # Store total sum for quick access
