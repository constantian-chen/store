from sympy import symbols, solve, sqrt, cos, sin, pi, evalf
from sympy.geometry import Point, Line

def solve_geometry_problem():
    """
    Solves the geometry problem:
    Let PROBLEMZ be a regular octagon inscribed in a circle of unit radius.
    Vertices are P, R, O, B, L, E, M, Z in counterclockwise order (or clockwise).
    Diagonals MR and OZ meet at I. Compute the length LI.
    Returns the exact string representation of the length.
    """
    # Define vertices based on the string "PROBLEMZ"
    # Mapping indices: P=0, R=1, O=2, B=3, L=4, E=5, M=6, Z=7
    # Radius = 1, Center = (0,0)
    # Vertices are at angles k * 45 degrees.
    
    vertices = []
    labels_map = {"P": 0, "R": 1, "O": 2, "B": 3, "L": 4, "E": 5, "M": 6, "Z": 7}
    
    # Identify key vertices
    # M corresponds to index 6
    # R corresponds to index 1
    # O corresponds to index 2
    # L corresponds to index 4
    # Z corresponds to index 7
    
    M_idx = 6
    R_idx = 1
    O_idx = 2
    L_idx = 4
    Z_idx = 7
    
    # Create points in Sympy
    theta_step = pi / 4  # 45 degrees
    
    def get_point(idx):
        angle = idx * theta_step
        return Point(cos(angle), sin(angle))
    
    Pt_M = get_point(M_idx)
    Pt_R = get_point(R_idx)
    Pt_O = get_point(O_idx)
    Pt_Z = get_point(Z_idx)
    Pt_L = get_point(L_idx)
    
    # Line MR
    Line_MR = Line(Pt_M, Pt_R)
    
    # Line OZ
    Line_OZ = Line(Pt_O, Pt_Z)
    
    # Intersection I
    I = Line_MR.intersection(Line_OZ)[0]
    
    # Distance LI
    dist_LI = Pt_L.distance(I)
    
    # Simplify and format
    result_sym = sqrt(2) # We expect this, let's verify sympy result
    final_ans = str(dist_LI)
    return final_ans

