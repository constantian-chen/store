--- Synthesized Tool Code ---
import sys

def solve():
    """
    Calculates the number of positive integers <= 240 expressible as sum of distinct factorials
    considering 0! and 1! as distinct items.
    """
    # Factorials: 0!, 1!, 2!, 3!, 4!, 5! -> 1, 1, 2, 6, 24, 120
    # We treat the two 1s as distinct items in the set of summands.
    factorials = [1, 1, 2, 6, 24, 120]
    
    # Generate all subset sums
    n = len(factorials)
    valid_sums = set()
    
    # Iterate through all 2^n subsets
    for i in range(1 << n):
        current_sum = 0
        for j in range(n):
            if (i >> j) & 1:
                current_sum += factorials[j]
        valid_sums.add(current_sum)
    
    # We only count positive integers <= 240.
    # Based on analysis, all sums are <= 154, so constraint <= 240 is always met for generated sums.
    count = sum(1 for s in valid_sums if s > 0)
    return str(count)

def main():
    """Main function to execute the solution."""
    result = solve()
    return result

if __name__ == "__main__":
    print(main())

