--- Synthesized Tool Code ---
import math

def solve_largest_rational_root():
    """
    Computes the largest possible rational root of ax^2 + bx + c = 0
    where a, b, c are positive integers <= 100.
    
    The roots are x = (-b ± sqrt(b^2 - 4ac)) / (2a).
    Roots are rational iff b^2 - 4ac is a perfect square k^2.
    Since a,b,c > 0, roots are strictly negative. We want the root closest to 0.
    Root value is (-b + k) / (2a) where k = sqrt(b^2 - 4ac).
    Let delta = b - k. Then delta = 4ac / (b+k).
    Since delta must be even, the smallest possible delta is 2.
    For delta=2, root magnitude is 2/(2a) = 1/a.
    We maximize a such that there exists c>=1 with b = ac + 1 <= 100.
    Max a occurs when c=1, then b = a + 1 <= 100 => a <= 99.
    With a=99, c=1, b=100, we get root -1/99.
    Returns the string representation of this value.
    """
    max_a = 99
    c_min = 1
    b_val = max_a * c_min + 1
    
    # Verify constraints
    assert 1 <= max_a <= 100
    assert 1 <= b_val <= 100
    assert 1 <= c_min <= 100
    
    # Calculate discriminant and root
    discriminant = b_val**2 - 4 * max_a * c_min
    k = int(math.isqrt(discriminant))
    assert k ** 2 == discriminant
    
    # Calculate larger root (closer to 0)
    # x = (-b + k) / (2a)
    numerator = -b_val + k
    denominator = 2 * max_a
    
    # Simplify fraction
    # Since delta = b - k = 2, numerator = -2
    # So root is -2 / (2 * 99) = -1 / 99
    g = math.gcd(abs(numerator), denominator)
    num_s = numerator // g
    den_s = denominator // g
    
    return f"{num_s}/{den_s}"

