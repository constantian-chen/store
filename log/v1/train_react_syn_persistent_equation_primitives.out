from math import gcd
from functools import reduce
from operator import lcm as math_lcm

def lcm(a, b):
    if a == 0 or b == 0: return 0
    return a * b // gcd(a, b)

def compute_quixotic(limit=10000):
    solutions = []
    current_lcm = 1
    # Precompute LCMs to avoid recomputing from scratch every time
    # L_n = lcm(L_{n-1}, n)
    
    for n in range(1, limit + 1):
        if n == 1:
            current_lcm = 1
        else:
            current_lcm = lcm(current_lcm, n)
        
        # Compute S_n = sum(L_n / k for k in 1..n)
        # To optimize, we can accumulate, but given constraints, just compute sum
        # Using integer arithmetic
        s_n = 0
        for k in range(1, n + 1):
            # Since current_lcm is divisible by k, this is safe
            term = current_lcm // k
            s_n += term
            # Check divisibility by 45 periodically or at end
            if k == n:
                if s_n % 45 == 0:
                    solutions.append(n)
                if len(solutions) >= 10:
                    break
        if len(solutions) >= 10:
            break
            
    return solutions[solutions.index(solutions[-1]) - 10 + len(solutions) - 1] # No, just return the 10th

def solve():
    sols = []
    L = 1
    for n in range(1, 5000):
        L = L * n // gcd(L, n)
        # Calculate S_n mod 45
        # We can compute each term mod 45?
        # No, L/k might be large, but we only need mod 45.
        # However, L/k = (L mod (45*k)) // k ?
        # Safer to use big ints and mod at the end.
        s = 0
        for k in range(1, n + 1):
            s += L // k
        if s % 45 == 0:
            sols.append(n)
    if len(sols) >= 10:
        return str(sols[9])
    else:
        return "NOT_FOUND"

result = solve()
print(result, end="")

