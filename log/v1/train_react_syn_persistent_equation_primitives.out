from math import gcd

def get_divisors(num):
    divs = []
    for i in range(1, int(num**0.5) + 1):
        if num % i == 0:
            divs.append(i)
            if i*i != num:
                divs.append(num // i)
    return divs

def solve():
    m = 500
    count = 0
    # Iterate r from 1 to 15
    for r in range(1, 16):
        # Condition: 1 <= r <= 15
        if not (1 <= r <= 15):
            continue
        
        M = m - r
        # n must be a divisor of M and n > r
        for n in get_divisors(M):
            if n <= r:
                continue
            
            # Check s = n % r
            s = n % r
            
            # Check conditions on s:
            # 1. s != 0 (if s=0, t=0, but problem requires 2 <= s <= 9)
            # 2. 2 <= s <= 9
            # 3. t = r % s == 0 (which means s divides r)
            if s != 0:
                if 2 <= s <= 9 and r % s == 0:
                    count += 1
    return str(count)

