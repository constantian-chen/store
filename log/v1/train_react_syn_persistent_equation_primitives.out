from math import comb

def solve_grid_paths_expects():
    """
    Computes the expected number of up-right paths from (0,0) to (5,5)
    not passing through a randomly chosen lattice point (x,y) in the 6x6 grid.
    """
    n = 5
    total_steps = 2 * n
    total_paths = comb(total_steps, n)
    
    num_points = (n + 1) * (n + 1)
    
    # Sum of paths passing through all points (x,y) in the grid
    # Using the derived formula S = (2n + 1) * binomial(2n, n)
    sum_blocked = (2 * n + 1) * total_paths
    
    expected_blocked = sum_blocked / num_points
    expected_unblocked = total_paths - expected_blocked
    
    return str(int(expected_unblocked))

def verify_vandermonde_sum():
    """
    Verifies the sum logic by brute force summation for n=5.
    """
    n = 5
    total_sum = 0
    for x in range(n + 1):
        for y in range(n + 1):
            k = x + y
            # Paths (0,0)->(x,y) is comb(x+y, x)
            # Paths (x,y)->(n,n) is comb((n-x)+(n-y), n-x)
            ways1 = comb(x + y, x)
            ways2 = comb((n - x) + (n - y), n - x)
            total_sum += ways1 * ways2
    return data_

