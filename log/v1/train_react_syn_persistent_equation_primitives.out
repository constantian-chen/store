from functools import reduce

def nCr(n, r):
    if r < 0 or r > n:
        return 0
    if r == 0 or r == n:
        return 1
    if r > n // 2:
        r = n - r
    
    res = 1
    for i in range(r):
        res = res * (n - i) // (i + 1)
    return res

def solve_idempotent_functions(n):
    total = 0
    for k in range(1, n + 1):
        ways_to_choose_range = nCr(n, k)
        ways_to_map_others = k ** (n - k)
        term = ways_to_choose_range * ways_to_map_others
        total += term
    return str(total)

def solve_main():
    n = 5
    result = solve_idempotent_functions(n)
    return result

