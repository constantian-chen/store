import math

def solve_triangle_inradius():
    """
    Computes the inradius r of a triangle given the segments BF=1, FG=6, GA=6
    on the line DE where D, E are tangency points and F, G are intersections of
    bisectors of A and B.
    Uses the relations BF = r*cot(B/2), AG = r*cot(A/2), FG = r*cot(C/2).
    """
    # System of equations derived:
    # r = v = 6u
    # u^2 = 1/48
    # r = 6 * sqrt(1/48)
    
    u_sq = 1/48
    r = 6 * math.sqrt(u_sq)
    return str(round(r, 10))

if __name__ == "__main__":
    print(solve_triangle_inradius())
