def solve_marty_score():
    """
    Calculates the minimum score Marty could have to conclude everyone else scored below average.
    Given 4 people, average 20, total sum 80.
    Marty knows sum = 80 and knows his own score m.
    He needs to know that for any non-negative integers a, b, c summing to 80-m, 
    max(a, b, c) < 20.
    This requires 80 - m <= 19.
    """
    total_sum = 4 * 20
    max_other_sum_to_be_sure = 19  # Because if sum is 19, max element is 19.
    
    # We need m such that (total_sum - m) <= max_other_sum_to_be_sure
    # m >= total_sum - max_other_sum_to_be_sure
    min_m = total_sum - max_other_sum_to_be_sure
    
    return str(min_m)

