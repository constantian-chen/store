from sympy import sqrt, solve, N

def solve_math_problem():
    # Step 1: Define variables and solve for coordinates of A1
    # Parabola focus A(0, sqrt(3)), directrix y=0
    # Equation: x^2 + (y-sqrt(3))^2 = y^2 => x^2 = 2*sqrt(3)*y - 3
    # Line AB: y = sqrt(3)*(x+1)
    # Intersection: x^2 = 2*sqrt(3)*sqrt(3)*(x+1) - 3 = 6x + 3
    # x^2 - 6x - 3 = 0
    # x = (6 - sqrt(36+12))/2 = 3 - 2*sqrt(3) (since x in [-1,0])
    # y = sqrt(3)*(3 - 2*sqrt(3) + 1) = 4*sqrt(3) - 6
    # Distance d from BC (y=0) to A1A2 is y_A1 = 4*sqrt(3) - 6
    
    s = 2
    H = s * sqrt(3) / 2
    d = 4 * sqrt(3) - 6
    
    # Step 2: Calculate side length of the inner triangle
    # The lines form a triangle with altitude h' = |3d - H|
    # Since 3d > H, h' = 3d - H
    # Side length a' = 2 * h' / sqrt(3)
    h_prime = 3 * d - H
    a_prime = 2 * h_prime / sqrt(3)
    
    # Step 3: Perimeter
    P = 3 * a_prime
    # Simplify expression
    P_simplified = 22 - 12 * sqrt(3) * 3 # Hand calculated as 66 - 36*sqrt(3)
    # Let's trust the derivation 3*(22-12sqrt3) = 66 - 36sqrt3
    
    return str(N(P)) # Return float for check, but we need exact.
    # Actually the problem asks for exact. But the output string should be the final answer.
    # Let's compute exact string.
    return "66 - 36*sqrt(3)"

def main():
    return solve_math_problem()

if __name__ == "__main__":
    print(main())
