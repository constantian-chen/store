tool_args_0: {'code': 'import random\n\ndef simulate(n, trials):\n    counts = [0] * (n + 1)\n    for _ in range(trials):\n        deck = list(range(1, n + 1))\n        while len(deck) > 1:\n            c1, c2 = deck[0], deck[1]\n            # Discard one, keep one at bottom\n            if random.random() < 0.5:\n                deck = deck[2:] + [c2]\n            else:\n                deck = deck[2:] + [c1]\n            # Wait, deck[2:] shifts indices. Correct.\n        counts[deck[0]] += 1\n    \n    mean_val = sum((i+1) * counts[i+1] for i in range(n)) / trials\n    return mean_val, counts/n\n\nmean_100, dist_100 = simulate(100, 100000)\nprint(f"Mean_100 Estimate: {mean_100}")\n# Check small n too\nfor n in [4, 5, 6, 8, 9, 10]:\n    m, d = simulate(n, 50000)\n    print(f"n={n}, Mean={m:.4f}, Dist20={d[0:20]}")'}
