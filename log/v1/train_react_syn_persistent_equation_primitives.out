def solve_odd_m():
    """Count odd integers m in [1, 49] that are solutions."""
    return str(25)

def solve_even_m():
    """Count even integers m in [1, 49] that are solutions."""
    count = 0
    # m = 2*k, k odd. k must be 1 or have a prime factor p=1 mod 4.
    # Valid k in range [1, 24]
    from sympy import factorint, isprime
    primes_1mod4 = [5, 13, 17, 29, 37, 41]
    valid_k = set()
    valid_k.add(1)
    for k in range(1, 25, 2):
        if k == 1:
            continue
        f = factorint(k)
        okay = False
        for p in f:
            if p % 4 == 1:
                okay = True
                break
        if okay:
            valid_k.add(k)
    for k in valid_k:
        if 2*k <= 49:
            count += 1
    return str(count)

def main():
    odd_count = solve_odd_m()
    even_count = solve_even_m()
    total = odd_count + even_count
    return str(total)

