        [6, 2, 3, 5, 1],
        [5, 2, 2, 9, 1],
        [4, 5, 9, 1, 1],
        [5, 6, 6, 1, 1]
    ]
    
    total = 0
    for multiset in multisets:
        # Calculate number of distinct permutations
        # Formula: n! / (n1! * n2! * ...)
        import math
        n = 5
        perms = math.factorial(n)
        # Count frequencies
        freq = {}
        for x in multiset:
            freq[x] = freq.get(x, 0) + 1
        for k, v in freq.items():
            perms //= math.factorial(v)
        total += perms
        
    return str(total)

