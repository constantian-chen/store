from sympy import primefactors, divisors, isprime

def find_loose_numbers(n_max: int = 100) -> int:
    """
    Finds the sum of all loose positive integers less than n_max.
    A number n is loose if it has exactly 6 divisors and for any two divisors a < b, b >= 2a.
    
    Parameters:
        n_max (int): The upper limit (exclusive) for n.
        
    Returns:
        int: The sum of all loose numbers less than n_max.
    """
    loose_sum = 0
    loose_numbers = []
    
    for n in range(1, n_max):
        # Get divisors
        divs = sorted([d for d in range(1, n+1) if n % d == 0])
        
        # Check number of divisors
        if len(divs) != 6:
            continue
        
        # Check gap condition
        is_loose = True
        for i in range(0, 5):
            a = divs[i]
            b = divs[i+1]
            if b < 2 * a:
                is_loose = False
                break
        
        if is_loose:
            loose_numbers.append(n)
            loose_sum += n
            
    return loose_sum

def solve_problem() -> str:
    """
    Solves the specific problem: Sum of loose numbers less than 100.
    Returns the result as a string.
    """
    result = find_loose_numbers(100)
    return str(result)

