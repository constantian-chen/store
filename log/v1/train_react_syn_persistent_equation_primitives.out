from math import factorial
from fractions import Fraction

def calculate_increasing_subsequences_sum(n: int) -> str:
    """
    Calculates the sum of the number of strictly increasing subsequences of length >= 2
    over all permutations of n distinct elements.
    
    Formula: Sum = n! * Sum_{k=2 to n} (C(n, k) / k!)
               = Sum_{k=2 to n} (n! / k!) * C(n, k)
               = Sum_{k=2 to n} (n! / k!) * (n! / (k! * (n-k)!))
               = Sum_{k=2 to n} ( (n!)^2 / ( (k!)^2 * (n-k)! ) )
    
    Args:
        n: Number of distinct elements (cards).
    
    Returns:
        The total sum as a string.
    """
    if n < 2:
        return "0"
    
    total_sum = 0
    n_fact = factorial(n)
    
    for k in range(2, n + 1):
        k_fact = factorial(k)
        n_minus_k_fact = factorial(n - k)
        # Term is C(n, k) * (n! / k!)
        # = (n! / (k! * (n-k)!)) * (n! / k!)
        term = (n_fact * n_fact) // (k_fact * k_fact * n_minus_k_fact)
        total_sum += term
        
    return str(total_sum)

def verify_example(n: int) -> str:
    """
    Verifies the logic on the example provided in the problem statement implicitly,
    though the example was n=4 with specific sequence, we check n=4 total sum.
    For n=4, sum should be 4! * (C(4,2)/2! + C(4,3)/3! + C(4,4)/4!)
    = 24 * (6/2 + 4/6 + 1/24) = 24 * (3 + 2/3 + 1/24) = 72 + 16 + 1 = 89.
    """
    if n < 2:
        return "0"
    
    total_sum = 0
    n_fact = factorial(n)
    
    for k in range(2, n + 1):
        k_fact = factorial(k)
        n_minus_k_fact = factorial(n - k)
        term = (n_fact * n_fact) // (k_fact * k_fact * n_minus_k_fact)
        total_sum += term
        
    expected = 89 if n == 4 else "unknown"
    if n == 4 and total_sum == 89:
        return "Verification passed for n=4."
    elif n == 6 and total_sum == 8287:
        return "Calculation matches expected result for n=6."
    else:
        return f"Calculated {total_sum} for n={n}."

