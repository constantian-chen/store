def compute_expected_value():
    """
    Calculates the expected value of a counter after 10 seconds,
    where the counter increments by 1 or resets to 0 with probability 0.5 each.
    Returns the numerator and denominator of the reduced fraction.
    """
    from math import gcd
    k = 10
    # Formula derived: E_k = (2^k - 1) / 2^k
    m = (2 ** k) - 1
    n = 2 ** k
    
    # Ensure reduced form (though for k=10, 2^k is power of 2 and m is odd, so gcd is 1)
    common = gcd(m, n)
    m = m // common
    n = n // common
    
    return str(m), str(n)

