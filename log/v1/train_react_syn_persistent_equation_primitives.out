from fractions import Fraction
import math

def solve_waffle_holes():
    """
    Calculates the number of unit-square holes centered at integer coordinates
    that are entirely contained within a circle of radius 3 centered at the origin.
    A hole centered at (m, n) is a square [m-0.5, m+0.5] x [n-0.5, n+0.5].
    Condition: All four corners must satisfy x^2 + y^2 <= 9.
    """
    r = 3
    r_sq = 9
    count = 0
    
    # Check integer coordinates m in range [-4, 4]
    # Since x in [m-0.5, m+0.5], if |m| >= 3, then one side is >= 2.5+0.5=3?
    # If m=3, x range [2.5, 3.5], so 3.5 is possible. 3.5^2 > 9.
    # So m must be in [-2, 2].
    # Similarly n in [-2, 2].
    
    for m in range(-2, 3):
        for n in range(-2, 3):
            # Define the four corners
            x_corners = [m + 0.5, m - 0.5]
            y_corners = [n + 0.5, n - 0.5]
            
            # Check if all corners are inside the circle
            all_inside = True
            for x in x_corners:
                for y in y_corners:
                    if x*x + y*y > r_sq:
                        all_inside = False
                        break
                if not all_inside:
                    break
            
            if all_inside:
                count += 1
                
    return str(count)

