from sympy import symbols, solve, Eq, Rational
import math

def solve_polynomial():
    # Define symbols
    b, c, x = symbols('b c x')
    
    # Define P(x)
    P = x**2 + b*x + c
    
    # Roots r1, r2
    r1, r2 = symbols('r1 r2')
    
    # We know P(1) is a root, P(2) is a root.
    # Let's assume P(1) = r1 and P(2) = r2 (the other case yields symmetric result)
    # P(1) = 1 + b + c = r1
    # P(2) = 4 + 2b + c = r2
    # r1^2 + b*r1 + c = 0
    # r2^2 + b*r2 + c = 0
    
    equations = []
    
    # Relations from definitions
    equations.append(Eq(1 + b + c, r1))
    equations.append(Eq(4 + 2*b + c, r2))
    equations.append(Eq(r1**2 + b*r1 + c, 0))
    equations.append(Eq(r2**2 + b*r2 + c, 0))
    
    # We have 4 equations and 4 unknowns b, c, r1, r2 (excluding order)
    # Solve the system
    sol = solve(equations, (b, c, r1, r2), dict=True)
    
    # There might be multiple solutions due to permutation of roots, collect c values
    possible_c_values = set()
    for s in sol:
        c_val = s.get(c)
        if c_val is not None:
            possible_c_values.add(c_val)
            
    return "The possible values for P(0) = c are: " + str(list(possible_c_values))

