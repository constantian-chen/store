def calculate_min_diagonal_sum():
    """
    Calculates the minimum sum of numbers along the diagonal of an 8x8 grid
    where consecutive numbers 1..64 are adjacent, subject to the constraint
    that no two consecutive numbers can be on the diagonal (since diagonal cells are not adjacent).
    The optimal strategy is to place the smallest available numbers such that no two are consecutive.
    This yields the first 8 odd numbers.
    Returns the integer sum.
    """
    # The diagonal cells (i, i) for i=1..8 are all the same color in a chessboard coloring.
    # In a Hamiltonian path of a bipartite graph, vertices with values 1, 3, 5... must be on one color class
    # and 2, 4, 6... on the other, because consecutive numbers must be adjacent (different colors).
    # If 1 is on a White cell, 2 on Black, 3 on White, etc.
    # The 8 diagonal cells in an 8x8 grid are all White (since i+i = 2i is even).
    # Thus, we can only place odd numbers on the diagonal.
    # No two odd numbers are consecutive integers, so the adjacentness constraint between diagonals is satisfied
    # by inserting even numbers in between.
    # To minimize the sum, we choose the smallest 8 odd numbers.
    
    odd_numbers = list(range(1, 16, 2))  # 1, 3, 5, 7, 9, 11, 13, 15
    
    current_sum = sum(odd_numbers)
    return str(current_sum)

