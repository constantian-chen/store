from fractions import Fraction

def solve():
    x_prev3 = Fraction(2, 3) # x_3
    x_prev2 = Fraction(1, 1) # x_2
    x_prev1 = Fraction(1, 1) # x_1
    
    # We need x_4 onwards.
    # x_n = x_{n-1}^2 * x_{n-2} / (2 * x_{n-2}^2 - x_{n-1} * x_{n-3})
    
    # Initialize list for reference if needed, but we just need to iterate.
    # To use x_{n-3}, we need to store history.
    # x_1, x_2, x_3 are known.
    
    history = [x_prev1, x_prev2, x_prev3] # [x1, x2, x3]
    
    n = 4
    while True:
        x_next = (history[-1] ** 2 * history[-2]) / (2 * history[-2] ** 2 - history[-1] * history[-3])
        # Check if x_next <= 1/10^6
        # 10^6 = 1000000
        threshold = Fraction(1, 1000000)
        if x_next <= threshold:
            return str(n)
        
        history.append(x_next)
        n += 1

print(solve())

