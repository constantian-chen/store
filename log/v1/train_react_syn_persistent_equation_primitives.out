import math

def calculate_volume():
    C = 2016
    p = 2016
    # Calculate V_norm(p) = 4*sqrt(pi)/p^2 * (Gamma(1/p)^2) / Gamma(3/2 + 2/p)
    # We use the approximation for large p or direct gamma computation
    # Since p is large, we can use math.gamma
    term1 = 4 * math.sqrt(math.pi)
    term2 = (1/p)**2
    term3 = math.gamma(1/p)**2
    term4 = math.gamma(1.5 + 2/p)
    V_norm = term1 * term2 * term3 / term4
    
    # Scaling factor J = C^(1/p*2 + 1/2)
    scale = C**(2/p + 0.5)
    
    V = scale * V_norm
    
    # Round to nearest ten
    return str(round(V/10)*10)

