import math

def count_colorings(n: int) -> str:
    '''
    Calculates the number of distinct colorings of a regular 2n-gon's sides with 3 colors
    such that each color is used at least once and every visible chain of sides from an external point
    contains at most 2 distinct colors.
    
    Logic:
    1. The condition implies that the cyclic sequence of colors can contain at most 2 distinct colors.
    2. Since each of the 3 colors must be used at least once, we must choose exactly 2 colors out of 3.
    3. For a chosen pair of colors, the number of valid colorings of 2n sides is the number of sequences
       using only these two colors, minus the two monochromatic cases (all color 1 or all color 2),
       because the other colors must appear at least once.
    4. Total = C(3, 2) * (2^(2n) - 2).
    
    Args:
        n (int): Positive integer defining the 2n-gon.
    
    Returns:
        str: The exact integer count as a string.
    '''
    total_sides = 2 * n
    num_ways_choose_2 = binomial(3, 2)
    total_dir = pow(2, total_sides)
    mono_cases = 2
    valid_per_pair = total_dir - mono_cases
    result = num_ways_choose_2 * valid_per_pair
    return str(result)

def binomial(n: int, k: int) -> int:
    '''Helper to compute nCk.'''
    if k < 0 or k > n:
        return 0
    return math.comb(n, k)

