from itertools import permutations

def solve_song_listening():
    '''
    Solves the problem of counting ways for 3 people to listen to 3 songs such that
    each person listens to exactly 2 songs and each song is listened to by exactly 2 people.
    Returns the count as a string.
    '''
    songs = [1, 2, 3]
    people = ['A', 'B', 'C']
    
    # Generate all combinations of 2 songs for each person
    song_pairs = [set(c) for c in permutations(songs, 2)]
    unique_pairs = list(set(song_pairs))
    
    # Filter pairs to only those that are valid subsets of size 2
    # Actually permutations of songs 1,2,3 taken 2 gives (1,2), (1,3), (2,1)...
    # Sets will be {1,2}, {1,3}, {2,3}
    valid_sets = [{p[0], p[1]} for p in permutations(songs, 2)]
    valid_sets = list(set(valid_sets))
    
    # We need to assign these sets to people A, B, C
    # Since there are 3 sets and 3 people, we just permute the sets among the people
    # But we must verify the condition: each song is listened to by exactly 2 people.
    
    count = 0
    # There are 3! ways to assign the 3 distinct sets to 3 distinct people if the sets are distinct.
    # We found analytically that the counts must be 1 for each set type.
    # Let's verify programmatically.
    
    # The sets must be the ones: {1,2}, {1,3}, {2,3}
    required_sets = (frozenset({1,2}), frozenset({1,3}), frozenset({2,3}))
    
    for p in permutations(required_sets):
        # p is a tuple of sets assigned to A, B, C respectively
        # Check constraints
        song_counts = {1:0, 2:0, 3:0}
        for s_set in p:
            for song in s_set:
                song_counts[song] += 1
        
        valid = True
        if song_counts[1] != 2 or song_counts[2] != 2 or song_counts[3] != 2:
            valid = False
            
        if valid:
            count += 1
            
    return str(count)

