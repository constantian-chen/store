from sympy import tan, sin, Symbol, pi, Rational, N

def compute_expression():
    """
    Computes the value of (tan^2(20°) - sin^2(20°)) / (tan^2(20°) * sin^2(20°)).
    Uses symbolic math to ensure exactness.
    Returns the result as a string.
    """
    theta = 20 * pi / 180
    tan_theta_sq = tan(theta)**2
    sin_theta_sq = sin(theta)**2
    numerator = tan_theta_sq - sin_theta_sq
    denominator = tan_theta_sq * sin_theta_sq
    result = numerator / denominator
    # Simplify symbolically to remove any floating point approximation artifacts
    result_simplified = result.simplify()
    return str(result_simplified) if result_simplified.is_Symbol or result_simplified.is_Pow else str(result_simplified)

