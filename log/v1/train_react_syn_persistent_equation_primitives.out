from fractions import Fraction

def solve():
    # Boundary conditions
    # P[n] is probability of winning starting from score n
    # Winning means reaching exactly 5. Failing means > 5.
    # Max needed state is 6 because if we are at 4 and H->Make, we go to 7.
    # Actually states can go up to 7 in one step.
    # P[5] = 1 (Win)
    # P[6] = 0 (Lose)
    # P[7] = 0 (Lose)
    
    P = {}
    P[5] = Fraction(1, 1)
    P[6] = Fraction(0, 1)
    P[7] = Fraction(0, 1)
    
    # We work backwards from 7 down to 0 using the recurrence derived:
    # P[i+3] = 3*P[i] - 2*P[i+1]
    # This allows us to express P[i] if we know higher terms, but our recurrence was:
    # 3*P[i] = P[i+3] + 2*P[i+1] => P[i] = (P[i+3] + 2*P[i+1]) / 3
    # Wait, let's re-verify the direction.
    # The equation P[i] = 1/4 P[i+3] + 1/4 P[i] + 1/2 P[i+1] holds for i < 5.
    # Rearranging: 3/4 P[i] = 1/4 P[i+3] + 1/2 P[i+1]
    # Multiply by 4: 3 P[i] = P[i+3] + 2 P[i+1]
    # So P[i] = (P[i+3] + 2*P[i+1]) / 3.
    
    # We know P[5], P[6], P[7].
    # We can compute P[4], P[3], P[2], P[1], P[0].
    
    # Compute P[4]: needs P[7], P[5]
    # P[4] = (P[7] + 2*P[5]) / 3
    P4 = (P[7] + 2 * P[5]) / 3
    P[4] = P4
    
    # Compute P[3]: needs P[6], P[4]
    P3 = (P[6] + 2 * P[4]) / 3
    P[3] = P3
    
    # Compute P[2]: needs P[5], P[3]
    P2 = (P[5] + 2 * P[3]) / 3
    P[2] = P2
    
    # Compute P[1]: needs P[4], P[2]
    P1 = (P[4] + 2 * P[2]) / 3
    P[1] = P1
    
    # Compute P[0]: needs P[3], P[1]
    P0 = (P[3] + 2 * P[1]) / 3
    P[0] = P0
    
    # Return as string simplified fraction
    return str(P0.numerator) + "/" + str(P0.denominator)

