from sympy import Rational, Matrix, geometry

def solve_triangle_area():
    """
    Calculates the area of triangle EFG given triangle ABC with side lengths 13, 14, 15.
    Points D, E, F, G are defined as midpoints of BC, AD, BE, DF respectively.
    """
    # Side lengths
    AB_len = 13
    BC_len = 15
    CA_len = 14
    
    # Calculate Area of ABC using Heron's formula
    s = Rational(AB_len + BC_len + CA_len, 2)
    area_ABC = (s * (s - AB_len) * (s - BC_len) * (s - CA_len)).sqrt()
    
    # Coefficients for the determinant method relative to basis vectors A and C (from origin B)
    # Derived: Area(EFG) = |k1*m2 - k2*m1| * Area(ABC)
    # Where EF = k1*A + k2*C and EG = m1*A + m2*C (relative to B)
    # From derivation:
    # EF = -1/4 A - 1/8 C
    # EG = -3/8 A + 1/16 C
    k1 = Rational(-1, 4)
    k2 = Rational(-1, 8)
    m1 = Rational(-3, 8)
    m2 = Rational(1, 16)
    
    det_coeff = k1 * m2 - k2 * m1
    # The factor is |det_coeff|
    
    area_EFG = abs(det_coeff) * area_ABC
    
    return str(area_EFG)

