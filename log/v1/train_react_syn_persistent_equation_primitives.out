def solve_knight_squares():
    """
    Calculates the number of squares a knight can end up on after exactly 2009 moves
    starting from the lower-left corner (1,1) of an 8x8 chessboard.
    Returns the count as a string.
    """
    n_moves = 2009
    board_size = 8
    
    # Check reachability logic:
    # Knight moves always flip the parity of (row + col).
    # Start (1,1): sum = 2 (even).
    # After odd moves, sum must be odd.
    # The graph diameter on 8x8 is 6.
    # Since n_moves >= 6 and (n_moves - min_dist) is even for all target squares of correct color,
    # all squares of the correct color are reachable.
    # Count squares with odd sum in 8x8 grid.
    
    count = 0
    for r in range(1, board_size + 1):
        for c in range(1, board_size + 1):
            if (r + c) % 2 != 0:
                count += 1
                
    return str(count)

