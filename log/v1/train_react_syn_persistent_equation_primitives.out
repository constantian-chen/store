from functools import reduce
import math

def solve_quadrilateral_area():
    """
    Calculates the area of the convex quadrilateral formed by the intersection
    of the circle x^2 + y^2 = 73 and the hyperbola xy = 24.
    
    Returns:
        str: The integer area of the quadrilateral.
    """
    # The intersection points are found by solving x^2 + (24/x)^2 = 73
    # This leads to x^4 - 73x^2 + 576 = 0
    # x^2 = (73 +/- 55) / 2 -> x^2 = 64 or x^2 = 9
    # Points are (8,3), (-8,-3), (3,8), (-3,-8)
    
    points = [(8, 3), (3, 8), (-8, -3), (-3, -8)]
    
    # Calculate area using the shoelace formula
    # Area = 0.5 * |sum(x_i*y_{i+1} - x_{i+1}*y_i)|
    area_sum = 0
    n = len(points)
    for i in range(n):
        x_i, y_i = points[i]
        x_next, y_next = points[(i + 1) % n]
        area_sum += (x_i * y_next - x_next * y_i)
        
    area = abs(area_sum) / 2
    return str(int(area))

