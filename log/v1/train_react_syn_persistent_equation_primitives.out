    import math
    def check(x_deg):
        x = math.radians(x_deg)
        # Avoid division by zero
        if abs(math.sin(4*x)) < 1e-9 or abs(math.sin(2*x)) < 1e-9:
            return False
        lhs = 1 + math.sin(x) / math.sin(4*x)
        rhs = math.sin(3*x) / math.sin(2*x)
        return abs(lhs - rhs) < 1e-6

    sols = [20, 60, 100, 140]
    for s in sols:
        if not check(s):
            print(f"Fail at {s}")
            return False
    return True

