from typing import List, Optional

def find_virtual_squared_plus_one() -> str:
    """
    Finds all virtual numbers of the form n^2 + 1.
    A virtual number is a 4-digit integer of the form abab with a != 0.
    
    Returns:
        A string listing the found virtual numbers, comma-separated, or an empty string if none.
    """
    solutions = []
    
    # n must be positive integer
    # 1010 <= n^2 + 1 <= 9999
    # 1009 <= n^2 <= 9998
    # sqrt(1009) approx 31.7, sqrt(9998) approx 99.99
    min_n = 32
    max_n = 99
    
    for n in range(min_n, max_n + 1):
        val = n * n + 1
        
        # Check if val is of form abab
        # val = 1000*a + 100*b + 10*a + b = 1010*a + 101*b = 101*(10*a + b)
