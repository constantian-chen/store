from itertools import product

def count_nasty_functions(n: int) -> str:
    '''
    Counts the number of functions f: {1, ..., n} -> {1, ..., n}
    such that there are no distinct a, b with f(a)=b and f(b)=a.
    
    Args:
        n: The size of the domain and codomain (integer).
        
    Returns:
        A string representing the integer count of nasty functions.
    '''
    # Total number of functions
    total = n ** n
    # We can use the inclusion-exclusion principle formula derived:
    # sum_{k=0 to n//2} (-1)^k * M_k * n^(n-2k)
    # where M_k is the number of matchings of size k in K_n.
    # M_k = n! / ((n-2k)! * (2^k) * (k!))
    
    import math
    
    nasty_count = 0
    for k in range(0, n // 2 + 1):
        # Calculate number of ways to choose k disjoint pairs (matchings)
        # M_k = C(n, 2) * C(n-2, 2) * ... * C(n-2(k-1), 2) / k!
        # This is equivalent to n! / ((n-2k)! * 2^k * k!)
        
        numerator = math.factorial(n)
        denominator = math.factorial(n - 2 * k) * (2 ** k) * math.factorial(k)
        M_k = numerator // denominator
        
        term = M_k * (n ** (n - 2 * k))
        
        if k % 2 == 1:
            nasty_count -= term
        else:
            nasty_count += term
            
    return str(nasty_count)

