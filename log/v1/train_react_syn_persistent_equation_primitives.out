            # Format the output nicely, using exact form if possible
            exact = sp.nsimplify(res)
            return str(exact)
        else:
            return "No real convergence solution found"
    else:
        return "Multiple solutions: " + ", ".join([str(sp.nsimplify(s)) for s in valid_solutions])

