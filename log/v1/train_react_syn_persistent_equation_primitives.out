def solve_modulo_100():
    count = 0
    for n in range(1, 1001):
        # Check n=1 separately as it fails mod 4
        if n == 1:
            continue
        # Check n == 16 mod 20
        if n % 20 == 16:
            count += 1
    return str(count)

