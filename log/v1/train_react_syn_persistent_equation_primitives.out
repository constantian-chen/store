import sympy

def calculate_perimeter():
    """
    Calculates the perimeter of a right triangle with area 5 and hypotenuse 5.
    Returns the exact string representation of the perimeter.
    """
    # Define symbols
    a = sympy.symbols('a', positive=True)
    b = sympy.symbols('b', positive=True)
    
    # Equations
    # Area = 1/2 * a * b = 5  => a*b = 10
    # Hypotenuse = 5 => a^2 + b^2 = 25
    
    # Solve the system of equations
    sol = sympy.solve([a*b - 10, a**2 + b**2 - 25], (a, b))
    
    # Calculate sum of legs for each solution
    perimeters = []
    for leg_pair in sol:
        if leg_pair[0] > 0 and leg_pair[1] > 0:
            leg_sum = leg_pair[0] + leg_pair[1]
            perimeter = leg_sum + 5 # Hypotenuse is 5
            perimeters.append(sympy.simplify(perimeter))
    
    # Since it's a triangle, all valid solutions should yield the same perimeter or symmetric legs
    # We pick the first valid simplified perimeter
    result = perimeters[0]
    
    # Convert to string without scientific notation or excessive precision, keeping sqrt if necessary
    return str(result)

# execute and get result for verification logic inside thought, but output only the function
