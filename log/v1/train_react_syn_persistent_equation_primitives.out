from fractions import Fraction

def solve_polya_urn():
    """
    Solves the probability problem for the Peer Pressure High School election.
    Models the election as a Polya Urn process with initial counts A=2, C=1,
    and N=2016 additional voters.
    Returns the probability that Alice wins as an irreducible fraction string.
    """
    M = 2016  # Number of undecided voters
    A0 = 2    # Initial votes for Alice
    C0 = 1    # Initial votes for Celia
    
    # The number of additional votes X for Alice follows a distribution:
    # P(X=k) = 2 * (k+1) / ((M+1)*(M+2)) for k in 0..M
    
    # Alice wins if A_final > C_final
    # A_final = A0 + X = 2 + X
    # C_final = C0 + (M - X) = 1 + M - X
    # Condition: 2 + X > 1 + M - X  =>  2X > M - 1
    # X > (M - 1) / 2
    
    threshold = (M - 1) / 2
    # Since X is integer, we need X >= floor(threshold) + 1 if threshold is integer?
    # M=2016, M-1=2015. 2015/2 = 1007.5.
    # X > 1007.5 => X >= 1008.
    start_k = int(M // 2) + 1 # 1008
    
    # Calculate sum of (k+1) for k from start_k to M
    # Sum = (start_k+1) + ... + (M+1)
    # Let j = k+1. Sum j from start_k+1 to M+1.
    # S(n) = n(n+1)/2. Sum = S(M+1) - S(start_k)
    
    def sum_range(n):
        return n * (n + 1) // 2
    
    sum_numerator = sum_range(M + 1) - sum_range(start_k)
    den_norm = (M + 1) * (M + 2) // 2 # part of the denominator scaling
    
    # Probability P = (2 * sum_numerator) / den_norm * 2? 
    # Let's re-derive the sum part carefully.
    # P(X=k) = 2 * (k+1) / ((M+1)*(M+2))
    # Sum P(X=k) for k=start_k..M = [2 / ((M+1)*(M+2))] * sum_{k=start_k}^M (k+1)
    # Let S_val = sum_{k=start_k}^M (k+1) = sum_{j=start_k+1}^{M+1} j
    # S_val = S(M+1) - S(start_k)
    
    S_M_plus_1 = sum_range(M + 1)
    S_start_k = sum_range(start_k)
    S_val = S_M_plus_1 - S_start_k
    
    prob_frac = Fraction(2 * S_val, (M + 1) * (M + 2))
    
    return str(prob_frac)

