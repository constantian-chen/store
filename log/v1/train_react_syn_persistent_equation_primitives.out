    fact_k2 = math.factorial(k2)
    fact_k3 = math.factorial(k3)
    div = fact_n // (fact_k1 * fact_k2 * fact_k3)
    return "Verified: " + str((fact_n, fact_k1, fact_k2, fact_k3, div))

