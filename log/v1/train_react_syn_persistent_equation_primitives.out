from math import floor

def calculate_prime_val_legendre(n: int, p: int) -> int:
    """
    Calculates the exponent of prime p in n! using Legendre's Formula.
    
    Parameters:
    - n (int): The factorial number n!
    - p (int): The prime number to count exponent for
    
    Returns:
    - int: The exponent of p in the prime factorization of n!
    """
    count = 0
    current_p_pow = p
    while current_p_pow <= n:
        count += floor(n / current_p_pow)
        # Prevent overflow by checking next power logic or integer limits if n is huge
        # But for n=2007, standard integer arithmetic is safe.
        # Using division to bound safely:
        if n // p < current_p_pow:
            break
        current_p_pow *= p
    return count

