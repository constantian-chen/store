import math

def count_light_configurations(n_rows: int, n_cols: int) -> str:
    """
    Computes the number of distinct configurations of lights in an n_rows x n_cols grid.
    The lights are controlled by switches on the top of each column and left of each row.
    A light turns on if and only if both its row and column switches are 'on'.
    This problem reduces to counting the number of distinct Cartesian products S_R x S_C,
    where S_R is a subset of row indices and S_C is a subset of column indices.
    The set of such products includes the empty set (when either S_R or S_C is empty)
    and all non-empty products where both S_R and S_C are non-empty.
    The number of non-empty subsets of size n is 2^n - 1.
    The number of distinct non-empty products is (2^n_rows - 1) * (2^n_cols - 1).
    Adding the single empty configuration, the total is (2^n_rows - 1) * (2^n_cols - 1) + 1.
    
    Parameters:
    n_rows (int): Number of rows in the grid.
    n_cols (int): Number of columns in the grid.
    
    Returns:
    str: The number of distinct light configurations as a string.
    """
    non_empty_rows = 2 ** n_rows - 1
    non_empty_cols = 2 ** n_cols - 1
    total_non_empty_configs = non_empty_rows * non_empty_cols
    total_configs = total_non_empty_configs + 1
    return str(total_configs)

def calculate_2_pow_minus_1(n: int) -> int:
    """
    Helper function to calculate 2^n - 1. Used to derive the number of non-empty subsets.
    
    Parameters:
    n (int): The exponent.
    
    Returns:
    int: The value of 2^n - 1.
    """
    return (1 << n) - 1

