import math

def solve_triangular_row(target: int) -> str:
    """
    Finds the row number in the standard triangular arrangement of natural numbers
    where row k contains k numbers.
    Sequence: Row 1: [1], Row 2: [2, 3], Row 3: [4, 5, 6], ...
    The cumulative count up to row n is n*(n+1)/2.
