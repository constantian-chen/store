import math
from fractions import Fraction

def solve_marble_probability():
    """
    Calculates the probability that no two red marbles are adjacent in a ring
    of 4 red and 8 blue marbles.
    
    Returns:
        str: The probability as a reduced fraction string (e.g., "7/33").
    """
    n = 12  # Total marbles
    r = 4   # Red marbles
    b = n - r  # Blue marbles
    
    # Total number of linear arrangements of r red and b blue marbles
    total_arrangements = math.comb(n, r)
    
    # Number of favorable arrangements (no two reds adjacent in circle)
    # Formula for choosing k non-consecutive items from n arranged in a circle:
    # C_count = (n / (n - k)) * C(n - k, k)
    favorable_count = (n // (n - r)) * math.comb(n - r, r)
    
    # Calculate probability
    prob = Fraction(favorable_count, total_arrangements)
    
    return f"{prob.numerator}/{prob.denominator}"

