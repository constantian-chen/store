from fractions import Fraction

def solve_geometric_system():
    # Define the coefficients based on the derived values
    # a*S = 15, b*S = 18, c*S = 58, S^2 = 91
    # We compute K = (49*b^2 - 33*b*c + 9*c^2) / a^2
    # Since a, b, c are proportional to 15, 18, 58, the factor 1/91 cancels out.
    
    num_a = 15
    num_b = 18
    num_c = 58
    
    numerator = 49 * (num_b ** 2) - 33 * (num_b * num_c) + 9 * (num_c ** 2)
    denominator = num_a ** 2
    
    result = numerator / denominator
    # Ensure exact integer result
    assert isinstance(result, (int, float))
    if result == int(result):
        return str(int(result))
    return str(result)

def verify_distances(a, b, c):
    # Verify the initial conditions
    eq1 = a**2 + a*b + b**2 - 9
    eq2 = b**2 + b*c + c**2 - 52
    eq3 = c**2 + c*a + a**2 - 49
    
    if abs(eq1) < 1e-9 and abs(eq2) < 1e-9 and abs(eq3) < 1e-9:
        return True
    return False

def compute_k():
    # Using fractions for exact arithmetic
    from fractions import Fraction
    a = Fraction(15, 1)
    b = Fraction(18, 1)
    c = Fraction(58, 1)
    
    # The actual values are a/S, b/S, c/S. The ratio K is independent of S.
    # K = (49*b^2 - 33*b*c + 9*c^2) / a^2
    numerator = 49 * b * b - 33 * b * c + 9 * c * c
    denominator = a * a
    
    result = numerator // denominator
    return str(result)
