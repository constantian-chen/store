# Correct code
from fractions import Fraction

def main():
    total = Fraction(0,1)
    for W in range(21):
        B = 20 - W
        if W == 0 or B == 0:
            p = Fraction(0,1)
        else:
            m = min(W, B)
            M = max(W, B)
            p = Fraction(m + 1, M + 1)
        total += p
    return f"{total}"

if __name__ == "__main__":
    print(main())

