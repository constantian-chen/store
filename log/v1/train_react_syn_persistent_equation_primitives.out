from math import comb

def calculate_f5():
    total = 0
    for r in range(4):
        for c in range(4):
            sign = (-1)**(r+c)
            exp_base = 3*r + 3*c - r*c
            exp_wacky = (3-r)*(3-c)
            val = comb(3, r) * comb(3, c) * sign * (4**exp_base) * (5**exp_wacky)
            total += val
            yield val
    return total

