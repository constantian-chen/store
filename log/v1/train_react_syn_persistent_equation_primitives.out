    # Since left_side = 4 * 16^16 = 2^2 * (2^4)^16 = 2^2 * 2^64 = 2^66
    
    # Calculate exact value
    val = 4 * (n ** n)
    
    # Verify it's a power of 2
    import math
    log_val = math.log2(val)
    
    if not log_val.is_integer():
        return "Not a power of 2"
    
    x_val = int(log_val)
    
    return str(x_val)

