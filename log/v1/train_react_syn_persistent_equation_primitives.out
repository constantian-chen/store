from math import comb

def count_possible_winners(N: int, rounds_won: int) -> str:
    """
    Calculate the number of players who can possibly win a given number of rounds
    in a single-elimination tournament with N players, assuming distinct skill levels
    and optimal bracket placement.
    
    To win R rounds, a player must be the strongest in a group of size 2^R.
    This requires at least 2^R - 1 players with lower skill.
    Let k be the skill level (1-indexed, 1 is lowest).
    Number of players with lower skill = k - 1.
    Condition: k - 1 >= 2^rounds_won - 1  => k >= 2^rounds_won.
    
    Args:
        N (int): Total number of players.
        rounds_won (int): Number of consecutive rounds to win.
        
    Returns:
        str: The count of such players.
    """
    group_size = 1 << rounds_won  # 2^rounds_won
    # Minimum skill level required is group_size (since we need group_size-1 weaker players, 1 <= skill lower < group_size)
    # If skill is group_size, we have 0..group_size-1, count = group_size, each < group_size.
    # Specifically, we need k-1 >= group_size - 1 -> k >= group_size.
    
    min_skill = group_size
    if min_skill > N:
        return "0"
    
    # Valid skills are min_skill, min_skill+1, ..., N
    count = N - min_skill + 1
    return str(count)

