def calculate_digit_at_position(pos: int) -> str:
    """
    Calculates the digit at the given position (1-based) in the sequence where
    each positive integer n is repeated n times.
    
    Args:
        pos: The 1-based position in the sequence.
        
    Returns:
        A string containing the single digit found at the position.
    """
    n = 1
    current_len = 0  # Total digits accumulated so far
    
    while True:
        # Length of the string representation of n
        digits_count = len(str(n))
        # Number of times n is repeated
        repeat_count = n
        block_length = digits_count * repeat_count
        
        if current_len + block_length >= pos:
            # The position is within this block
            offset = pos - current_len - 1  # 0-based index within the block
            return get_block_digit(n, offset)
        
        current_len += block_length
        n += 1

def get_block_digit(n: int, idx: int) -> str:
    """
    Returns the character at 0-based index idx from the infinite repetition
    of the string representation of n.
    Example: n=12, string="12". idx=0 -> '1', idx=1 -> '2', idx=2 -> '1'.
    
    Args:
        n: The integer to repeat.
        idx: 0-based index within the repeated sequence.
        
    Returns:
        The character at the specified index.
    """
    s = str(n)
    return s[idx % len(s)]

def solve_complex_problem() -> str:
    """
    Solves the specific problem of finding the sum of the 4501st and 4052nd digits.
    
    Returns:
        The sum of the two digits as an integer string.
    """
    d1 = int(calculate_digit_at_position(4501))
    d2 = int(calculate_digit_at_position(4052))
    return str(d1 + d2)

