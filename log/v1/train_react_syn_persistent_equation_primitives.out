from fractions import Fraction

def calculate_expected_profit(R: int, B: int) -> str:
    """
    Calculates the expected profit for the card guessing game.
    
    Parameters:
    R (int): Number of red cards in the deck. Also the number of times Val must guess 'Red'.
    B (int): Number of black cards in the deck. Val guesses 'Black' exactly B times.
    
    Returns:
    str: The expected profit as a string in simplest fraction format "numerator/denominator".
    """
    N = R + B
    numerator = (B - R) ** 2
    denominator = R + B
    
    result_fraction = Fraction(numerator, denominator)
    return f"{result_fraction.numerator}/{result_fraction.denominator}"

def solve():
    """
    Solves the specific instance of the problem where R=2011 and B=2012.
    Returns the expected profit as a string.
    """
    R = 2011
    B = 2012
    return calculate_expected_profit(R, B)

