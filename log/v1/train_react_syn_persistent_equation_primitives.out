def calculate_combinations(n: int, k: int) -> str:
    """
    Calculates the binomial coefficient C(n, k) exactly using Python's arbitrary precision integers.
    Uses the property C(n, k) = C(n, n-k) to minimize multiplications.
      
    Args:
        n (int): Total number of steps.
        k (int): Number of steps in one direction (half the sum of displacement).
          
    Returns:
        str: The string representation of the binomial coefficient.
    """
    if k < 0 or k > n:
        return "0"
    if k == 0 or k == n:
        return "1"
    if k > n // 2:
        k = n - k
    
    # Calculate C(n, k) = n! / (k! * (n-k)!)
    # Compute iteratively to keep numbers as small as possible during intermediate steps,
    # though Python handles large integers well.
    # C(n, k) = product(n-i) / i for i in 1..k
    
    result = 1
    for i in range(1, k + 1):
        result = result * (n - i + 1) // i
        
    return str(result)

