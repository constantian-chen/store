from fractions import Fraction

def solve_fourier_problem():
    """
    Solves for x given the relationship between the sums of the 'foury' and 'fourier' series.
    
    The series are:
    Foury: 4 + 4x + 4x^2 + ... = 4 / (1 - x)
    Fourier: 4 + 44x + 444x^2 + ... = sum(4 * (10^(n+1) - 1) // 9 * x^n)
    
    Given: Sum(Fourier) = 4 * Sum(Foury)
    """
    # Define the equation components symbolically using Fractions for exact arithmetic
    # Let S1 = 4 / (1 - x)
    # Let S2 = (4/9) * (10 / (1 - 10x) - 1 / (1 - x))
    # Condition: S2 = 4 * S1
    
    # Simplify the condition:
    # (4/9) * (10/(1-10x) - 1/(1-x)) = 16 / (1-x)
    # 1/9 * (10/(1-10x) - 1/(1-x)) = 4 / (1-x)
    # 10/(1-10x) - 1/(1-x) = 36 / (1-x)
    # 10/(1-10x) = 37 / (1-x)
    # 10(1-x) = 37(1-10x)
    
    # Calculate 10(1-x) and 37(1-10x) and solve for x
    # 10 - 10x = 37 - 370x
    # 360x = 27
    # x = 27/360
    
    # Using Fraction for exact reduction
    numerator = 27
    denominator = 360
    
    x_val = Fraction(numerator, denominator)
    
    # Reduce fraction
    # Fraction() automatically reduces
    
    return f"{x_val.numerator}/{x_val.denominator}"

def verify_solution():
    """
    Verifies the solution x = 3/40 by computing the series sums approximately and checking the ratio.
    This is a sanity check using float arithmetic, but the problem requires exact.
    """
    from math import isclose
    
    x_approx = float(3/40)
    
    # S1
    s1 = 4 / (1 - x_approx)
    
    # S2: sum first few terms or formula
    # Formula derived: S2 = (4/9) * (10/(1-10x) - 1/(1-x))
    s2 = (4/9) * (10/(1 - 10*x_approx) - 1/(1 - x_approx))
    
    ratio = s2 / s1
    
    expected_ratio = 4.0
    
    return str(ratio)

def test_edge_cases():
