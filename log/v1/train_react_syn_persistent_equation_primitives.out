from functools import reduce

def calculate_modulo(x, a, b, c):
    """
    Check divisibility of N and M by x.
    N = 100a + 10b + c
    M = 100b + 10c + a
    Returns (N_mod, M_mod)
    """
    N = 100 * a + 10 * b + c
    M = 100 * b + 10 * c + a
    return N % x, M % x

def check_x(x):
    """
    Verify if x satisfies the condition:
    For all a in 1..9, b in 0..9, c in 0..9,
    if N % x == 0, then M % x == 0.
    """
    for a in range(1, 10):
        for b in range(0, 10):
            for c in range(0, 10):
                n_mod, m_mod = calculate_modulo(x, a, b, c)
                if n_mod == 0 and m_mod != 0:
                    return False
    return True

def solve():
    valid_xs = []
    for x in range(10, 100):
        if check_x(x):
            valid_xs.append(x)
    return str(sum(valid_xs))
