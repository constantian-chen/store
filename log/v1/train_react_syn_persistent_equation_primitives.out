from sympy import isprime

def find_prime_digits_primes():
    """
    Identifies two-digit prime numbers where both digits are also prime numbers.
    Returns a list of these prime numbers as strings.
    """
    prime_digits = [2, 3, 5, 7]
    valid_primes = []
    
    for tens in prime_digits:
        for units in prime_digits:
            value = tens * 10 + units
            if isprime(value):
                valid_primes.append(str(value))
    
    return valid_primes

def count_prime_digits_primes():
    """
    Counts the number of two-digit prime numbers where both digits are also prime numbers.
    Returns the count as a string.
    """
    result_list = find_prime_digits_primes()
    return str(len(result_list))

