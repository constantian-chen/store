import math

def solve_decagon_angle():
    """
    Computes the angle A0A3A7 in a regular decagon A0A1...A9.
    Returns the angle in degrees as a string.
    """
    n = 10  # Number of vertices
    steps = 10  # Total steps in the cycle
    
    # Identify the positions of the vertices involved
    # A0, A3, A7
    # The angle is at A3, formed by chords A3A0 and A3A7.
    # The interior angle of the triangle A0-A3-A7 at vertex A3 subtends the arc A0-A7 that does not contain A3.
    
    # Calculate the arc length (number of edges) between A0 and A7 not passing through A3.
    # The two arcs between 0 and 7 have lengths:
    # Arc 1: |7 - 0| = 7
    # Arc 2: n - 7 = 3
    # Since A3 is at position 3, which is between 0 and 7 on the longer path (0->1->2->3->4->5->6->7),
    # the angle at A3 subtends the shorter arc between 0 and 7.
    
    arc_indices = abs(7 - 0)
    if arc_indices > n // 2:
        arc_indices = n - arc_indices
    
    # Verify A3 is not on the minor arc.
    # The minor arc is {1, 2} (if endpoints 0 and 3? No, 0 and 7).
    # Minor arc nodes (exclusive): 9, 8.
    # A3 is 3. 3 is not in {9, 8}. Correct.
    
    # The measure of the minor arc is arc_indices * (360/n).
    # The inscribed angle is half of that.
    total_arc_degrees = arc_indices * (360.0 / n)
    angle_degrees = total_arc_degrees / 2.0
    
    return str(int(round(angle_degrees)))

