{"code": "\"\"\"\nimport mpmath as mp\nmp.mp.dps = 80\n\ndef prob_ab(a, b, n):\n    # P(z_a + z_b <= 1)\n    if a > b: a, b = b, a\n    # Formula: sum_{i=0}^{a+b-1} (-1)^i * binom(a+b, i) * binom(n-a-b+i, ...)? No.\n    # Use the recursive relation or direct integral.\n    # Direct integral is robust.\n    # C = n! / ((a-1)! (b-a-1)! (n-b)!)\n    # I = int_0^{0.5} u^{a-1} * int_u^{1-u} (v-u)^{b-a-1} (1-v)^{n-b} dv du\n    # Note: if b=a+1, (v-u)^0=1.\n    # Optimization: change variables\n    # Use mp.quad2d with lambda\n    C = mp.factorial(n) / (mp.factorial(a-1) * mp.factorial(b-a-1) * mp.factorial(n-b))\n    def integrand(u, v):\n        return u**(a-1) * (v-u)**(b-a-1) * (1-v)**(n-b)\n    # Domain: 0 <= u <= 0.5, u <= v <= 1-u\n    # Note: if u+v > 1, excluded. So v <= 1-u.\n    # v >= u.\n    # Split v range? No, 0 <= u <= 0.5. \n    # v from u to 1-u.\n    # Integrand non-zero.\n    val = mp.quad(lambda u: mp.quad(lambda v: integrand(u, v), [u, 1-u]), [0, 0.5])\n    return C * val\n\ndef solve(N, K):\n    total_cfg = mp.binomial(N, K)\n    prob_sum = mp.mpf('0')\n    # Loop b, w\n    # b from K+1 to N\n    for b in range(K+1, N+1):\n        # w from 1 to min(b-1, K)\n        max_w = min(b-1, K)\n        for w in range(1, max_w+1):\n            slots = b - w - 1\n            needed = K - w\n            if slots < needed:\n                continue\n            weight = mp.binomial(slots, needed)\n            p_val = prob_ab(w, b, N)\n            prob_sum += weight * p_val\n    # Case b=K, w=K+1\n    # Config: S={1..K}. max=K, min(S^c)=K+1.\n    if K < N:\n        p_last = prob_ab(K, K+1, N)\n        prob_sum += p_last\n    return prob_sum / total_cfg\n\nN = 2019\nK = 1000\nres = solve(N, K)\nprint(res)\nprint(mp.nstr(res, 30))\n\"\"\"\n}

