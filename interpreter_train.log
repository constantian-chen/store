  "code": "\"\"\"\nSimulate the billiard trajectory in a semicircular room.\nRoom: Upper half of unit circle. Boundary: Arc (x^2+y^2=1, y>=0) and Diameter (y=0, -1<=x<=1).\nStart: (-1, 0). Initial angle: 46 degrees.\n\"\"\"\nimport math\n\n# Constants\nSTART = (-1.0, 0.0)\nINITIAL_ANGLE_DEG = 46.0\nTOL = 1e-8  # Tolerance for point equality\n\n# Helper: Rotated vector\ndef rotate_vec(vec, angle_deg):\n    cos_a = math.cos(math.radians(angle_deg))\n    sin_a = math.sin(math.radians(angle_deg))\n    x, y = vec\n    return x * cos_a - y * sin_a, x * sin_a + y * cos_a\n\n# Helper: Line segment from P with direction v, intersection with circle x^2+y^2=1\n# Line: P + t*v, t > 0\n# Intersection with circle: ||P + t*v||^2 = 1\n# (Px + t*vx)^2 + (Py + t*vy)^2 = 1\n# t^2(vx^2+vy^2) + 2t(Px*vx+Py*vy) + (Px^2+Py^2-1) = 0\n# Since |v|=1: t^2 + 2t(Px*vx+Py*vy) + (Px^2+Py^2-1) = 0\ndef intersect_circle(P, v):\n    # P is (x,y), v is (vx, vy), |v|=1\n    x, y = P\n    vx, vy = v\n    a = 1.0\n    b = 2 * (x * vx + y * vy)\n    c = x*x + y*y - 1.0\n    \n    disc = b*b - 4*a*c\n    if disc < 0:\n        return None\n    sqrt_disc = math.sqrt(disc)\n    t1 = (-b - sqrt_disc) / (2*a)\n    t2 = (-b + sqrt_disc) / (2*a)\n    \n    # We want the smallest positive t\n    results = []\n    for t in [t1, t2]:\n        if t > 1e-9 and t < 1e9:  # Avoid t=0\n            q = P[0] + t * v[0]\n            r = P[1] + t * v[1]\n            results.append((t, (q, r)))\n    \n    if not results:\n        return None\n    results.sort(key=lambda k: k[0])\n    return results[0][1]\n\ndef intersect_diameter(P, v):\n    # Diameter is y=0, x in [-1, 1]\n    x, y = P\n    vx, vy = v\n    \n    # Intersection with y=0\n    if abs(vy) < 1e-12:\n        return None\n    t = -y / vy\n    if t < 0:\n        return None\n    \n    qx = x + t * vx\n    if abs(qx) <= 1.0 + 1e-8:  # Allow slight tolerance for floating point\n        return (q, r) if (r := y + t*vy) else (qx, 0.0)\n    return None\n\n# Initial state\nrx, ry = START\ndir_x, dir_y = math.cos(math.radians(INITIAL_ANGLE_DEG)), math.sin(math.radians(INITIAL_ANGLE_DEG))\n\n# Ensure we are moving into the room\n# At (-1,0), the room is x>-1, y>0. Our vector has cos(46)>0, sin(46)>0. OK.\n\nreflections = 0\n\nwhile True:\n    x_curr, y_curr = rx, ry\n    \n    # Find next hit\n    # Check distance to arc\n    hit_arc = intersect_circle((rx, ry), (dir_x, dir_y))\n    # Check distance to diameter\n    hit_diam = intersect_diameter((rx, ry), (dir_x, dir_y))\n    \n    # Determine closest positive hit\n    t_arc, loc_arc = hit_arc\n    t_diam, loc_diam = hit_diam\n    \n    # Compare t\n    # If one is None, the other is the hit\n    # We need the smallest t > epsilon\n    \n    candidates = []\n    if hit_arc:\n        # Ensure we don't count the start point if we are close (though we move away)\n        if t_arc > 1e-6:\n            candidates.append((t_arc, 'arc', loc_arc))\n    \n    if hit_diam:\n        if t_diam > 1e-6:\n            candidates.append((t_diam, 'diam', loc_diam))\n    \n    if not candidates:\n        print(\"No intersection found, breaking\")\n        break\n    \n    t_min, wall_type, loc = min(candidates, key=lambda k: k[0])\n    \n    # Check if this location is the START point (-1, 0)\n    # This is the termination condition (coming back for the first time)\n    # We need to be careful: is the start point considered a 'wall' reflection? \n    # The problem asks: \"reflect off the walls before coming back...\"\n    # The beam hits the wall, reflects. If the hit point is (-1,0), the process stops.\n    # So we count reflections only if the wall_type != 'start'? \n    # Actually, (-1,0) is part of the boundary. If we hit it, we are done.\n    # Does hitting it count as a reflection? \n    # \"How many times does the light beam reflect off the walls before coming back...\"\n    # Usually, the event \"coming back\" triggers the end. The reflection at (-1,0) is not part of the count because the sequence ends there.\n    # So if loc is approximately (-1, 0), we stop.
    
    dist_start = (loc[0] + 1)**2 + (loc[1] - 0)**2\n    if dist_start < 1e-4:\n        # We returned to start\n        # Is this a reflection? No, it's the end condition.\n        # But wait, if we hit (-1,0) from inside, did we reflect off a wall? \n        # Yes, (-1,0) is on the boundary. But the question phrasing \"before coming back\" implies the count is of reflections that occur DURING the journey, not the return event itself if that event is the return.\n        # Let's assume the answer is the number of iterations.
        print(f\"Returned at reflection count {reflections} (current hit is return)\")\n        break\n    \n    # Update position\n    rx, ry = loc\n    reflections += 1\n    \n    # Reflect direction\n    if wall_type == 'arc':\n        # Reflection off circle: angle of incidence = angle of reflection.\n        # Normal at (x,y) is (x,y).\n        # v_new = v - 2 (v . n) n\n        n = (rx, ry)\n        # Normalize n (it's unit radius)\n        v_dot_n = dir_x * n[0] + dir_y * n[1]\n        dir_x = dir_x - 2 * v_dot_n * n[0]\n        dir_y = dir_y - 2 * v_dot_n * n[1]\n        # Re-normalize to avoid drift\n        norm = math.sqrt(dir_x**2 + dir_y**2)\n        dir_x /= norm\n        dir_y /= norm\n    \n    elif wall_type == 'diam':\n        # Reflection off horizontal y=0: x-component same, y flips\n        dir_y = -dir_y\n        # Normalize\n        norm = math.sqrt(dir_x**2 + dir_y**2)\n        dir_x /= norm\n        dir_y /= norm\n\nprint(f\"Total reflections: {reflections}\")\n"
