from sympy import Rational, sqrt, simplify

def solve_parabola_triangle_area():
    """
    Computes the area of the triangle formed by the intersections of lines
    A1C2, B1A2, and C1B2 for a 5-12-13 right triangle.
    """
    # Coordinates of vertices
    # C at (0,0), A at (0,5), B at (12,0)
    # AC = 5, BC = 12, AB = 13
    
    # Points derived from parabola properties
    # A1 on AB: x = 10/3, y = 65/18
    A1_x = Rational(10, 3)
    A1_y = Rational(65, 18)
    
    # A2 on AC: (0, 5/2)
    A2_x = Rational(0)
    A2_y = Rational(5, 2)
    
    # B1 on BC: (6, 0)
    B1_x = Rational(6)
    B1_y = Rational(0)
    
    # B2 on AB: (156/25, 12/5)
    B2_x = Rational(156, 25)
    B2_y = Rational(12, 5)
    
    # C1 on AC: (0, 12/5)
    C1_x = Rational(0)
    C1_y = Rational(12, 5)
    
    # C2 on BC: (10/3, 0)
    C2_x = Rational(10, 3)
    C2_y = Rational(0)
    
    # Line 1: A1C2 -> Vertical line x = 10/3
    L1_x = A1_x
    
    # Line 2: B1A2 -> 5x + 12y = 30
    # Intersection of L1 and L2 (P1)
    # 5*(10/3) + 12*y = 30 => 12*y = 30 - 50/3 = 40/3 => y = 40/36 = 10/9
    P1_x = L1_x
    P1_y = (Rational(30) - 5 * L1_x) / 12
    
    # Line 3: C1B2 -> Horizontal line y = 12/5
    L3_y = C1_y
    
    # Intersection of L2 and L3 (P2)
    # 5*x + 12*(12/5) = 30 => 5*x = 30 - 144/5 = 6/5 => x = 6/25
    P2_x = (Rational(30) - 12 * L3_y) / 5
    P2_y = L3_y
    
    # Intersection of L1 and L3 (P3)
    P3_x = L1_x
    P3_y = L3_y
    
    # Calculate Area of triangle P1 P2 P3
    # Base = |P3_x - P2_x|
    # Height = |P3_y - P1_y|
    base = abs(P3_x - P2_x)
    height = abs(P3_y - P1_y)
    
    area = Rational(1, 2) * base * height
    return str(simplify(area))

