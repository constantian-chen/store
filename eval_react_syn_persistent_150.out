def solve_last_two_digits() -> str:
    """
    Computes the last two digits of 1032^1032 by calculating 1032^1032 mod 100.
    Uses the Chinese Remainder Theorem approach:
    1. Compute mod 4
    2. Compute mod 25 using Euler's theorem
    3. Combine results.
    Returns the result as a two-digit string.
    """
    base = 1032
    exp = 1032
    modulus = 100
    
    # Modulo 4
    mod4 = pow(base, exp, 4)
    
    # Modulo 25
    # phi(25) = 20
    phi_25 = 20
    exp_mod_phi = exp % phi_25
    mod25 = pow(base, exp_mod_phi, 25)
    
    # Solve x = 0 (mod 4) and x = mod25 (mod 25)
    # x = 25*k + mod25
    # 25*k + mod25 = 0 (mod 4) => k + mod25 = 0 (mod 4) => k = -mod25 (mod 4)
    k = (-mod25) % 4
    result = 25 * k + mod25
    
    return f"{result:02d}"

