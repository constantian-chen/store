def solve():
    """
    Computes the length of AE for the given triangle geometry problem.
    Triangle sides: AB=13, BC=14, CA=15.
    AD is altitude to BC.
    r1, r2 are inradii of ABD, ACD.
    Result is AE = h - (r1 + r2).
    """
    from sympy import Rational, sqrt, simplify
    
    # Sides of triangle ABC
    a = 13  # AB
    b = 14  # BC
    c = 15  # CA
    
    # Calculate altitude AD (h) and segments BD (x), CD (y)
    # Using Heron's formula for area
    s = (a + b + c) / 2
    area = sqrt(s * (s - a) * (s - b) * (s - c))
    h = 2 * area / b
    
    # Calculate BD (x) and CD (y)
    # x^2 + h^2 = a^2 => x = sqrt(a^2 - h^2)
    # y = b - x
    x = sqrt(a**2 - h**2)
    y = b - x
    
    # Inradius of right triangle ABD (legs x, h; hyp a)
    r1 = (x + h - a) / 2
    
    # Inradius of right triangle ACD (legs y, h; hyp c)
    r2 = (y + h - c) / 2
    
    # Intersection E on AD such that DE = r1 + r2
    # AE = h - DE
    AE = h - (r1 + r2)
    
    # Simplify and convert to string
    result = simplify(AE)
    return str(result)

