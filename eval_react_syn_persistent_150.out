--- Synthesized Tool Code ---
def solve():
    """
    Solves the geometry problem for triangle ABC with sides 5, 8, 7.
    Calculates the length of DE where Gamma is tangent to circumcircle at A and BC.
    """
    from sympy import Rational, sqrt, simplify

    # Side lengths
    a = 8
    b = 7
    c = 5

    # Semi-perimeter
    s = Rational(a + b + c, 2)

    # Area using Heron's formula
    area = sqrt(s * (s - a) * (s - b) * (s - c))

    # Circumradius R
    R = a * b * c / (4 * area)

    # Cosine of angle A
    cos_A = (b**2 + c**2 - a**2) / (2 * b * c)

    # Altitude from A to BC
    h_a = 2 * area / a

    # Distance from circumcenter O to BC
    d = R * cos_A

    # Calculate radius r of Gamma
    # Derived from r = R * h_a / (R + h_a - d)
    r = R * h_a / (R + h_a - d)

    # Homothety ratio k = r / R
    k = r / R

    # Length DE = k * BC
    DE = k * a

    return str(simplify(DE))

