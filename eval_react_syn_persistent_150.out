from sympy import Rational, simplify

def solve_card_probability() -> str:
    """
    Calculates the probability that the second card has a different suit than the first,
    and the third card has a different suit than both the first and second.
    
    Returns the result as a simplified fraction string.
    """
    # Total cards
    total_cards = 52
    # Cards per suit
    cards_per_suit = 13
    
    # Step 1: First card can be anything.
    # Ways to choose first card: 52
    
    # Step 2: Second card must be a different suit than the first.
    # Remaining cards: 51
    # Cards of same suit as first: 12
    # Cards of different suits: 51 - 12 = 39
    ways_second = total_cards - cards_per_suit
    
    # Step 3: Third card must be different from first and second suits.
    # First and second suits are distinct.
    # Remaining cards: 50
    # Cards of suit 1 remaining: 12
    # Cards of suit 2 remaining: 12
    # Forbidden cards: 12 + 12 = 24
    # Allowed cards: 50 - 24 = 26
    # Alternatively: 2 suits * 13 cards = 26
    ways_third = 2 * cards_per_suit
    
    # Total favorable outcomes
    favorable = total_cards * ways_second * ways_third
    
    # Total possible outcomes
    total = total_cards * (total_cards - 1) * (total_cards - 2)
    
    # Calculate probability
    prob = Rational(favorable, total)
    
    # Simplify and format
    return str(simplify(prob))

