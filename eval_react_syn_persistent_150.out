def solve() -> str:
    """Simulates the coin flipping process and returns the number of steps until 20 tails."""
    from collections import defaultdict
    
    # State: position (int), direction (1 for positive, -1 for negative)
    pos = 0
    direction = 1
    # Coins: dictionary mapping position to state (1 for heads, -1 for tails, 0 for no coin)
    # Initially all heads (1)
    coins = defaultdict(lambda: 1)
    
    steps = 0
    target_tails = 20
    
    while True:
        steps += 1
        coin_state = coins[pos]
        
        if coin_state == 1:  # Heads
            coins[pos] = -1  # Flip to tails
            direction = -direction  # Turn around
            pos += direction
        elif coin_state == -1:  # Tails
            coins[pos] = 0  # Pick up (remove)
            pos += direction
        else:  # No coin (0)
            coins[pos] = 1  # Place heads
            pos += direction
        
        # Count tails
        tails_count = sum(1 for state in coins.values() if state == -1)
        if tails_count == target_tails:
            return str(steps)

