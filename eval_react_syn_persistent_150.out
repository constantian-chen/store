from sympy import Rational

def solve_rain_probability() -> str:
    """
    Calculates the smallest positive integer n such that the probability of rain
    n days from today is greater than 49.9%, given the specific transition probabilities.
    
    Transition:
    - Rain -> Rain: 3/4
    - No Rain -> Rain: 1/4
    - Initial state: No Rain (p_0 = 0)
    
    Recurrence: p_{n+1} = 1/2 * p_n + 1/4
    Closed form: p_n = 1/2 - 1/2^(n+1)
    Condition: p_n > 499/1000
    """
    target = Rational(499, 1000)
    n = 1
    while True:
        # p_n = 1/2 - 1/2^(n+1)
        p_n = Rational(1, 2) - Rational(1, 2**(n + 1))
        if p_n > target:
            return str(n)
        n += 1

