    # By Fermat's Little Theorem, 7^10 = 1 mod 11.
    # So we need E mod 10.
    # E = 6^F where F = 5^(3^(2^1)).
    # Since F >= 1, 6^F = 6 mod 10.
    # So E = 6 mod 10.
    # Then N = 7^6 mod 11.
    
    # Calculate 7^6 mod 11
    base = 7
    exp = 6
    mod = 11
    
    result = pow(base, exp, mod)
    
    # The result is in 0..10.
    # If result is 0, the digit is 11 (since the number is positive, sum of digits > 0).
    # Otherwise, the digit is the result.
    if result == 0:
        final_digit = 11
    else:
        final_digit = result
        
    return str(final_digit)

