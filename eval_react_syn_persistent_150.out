def solve() -> str:
    from collections import Counter

    # Days in each month for 2021 (non-leap year)
    days_in_month = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    
    counts = Counter()
    
    for m in range(1, 13):
        for d in range(1, days_in_month[m] + 1):
            # Format as mmdd string
            m_str = f"{m:02d}"
            d_str = f"{d:02d}"
            
            # Calculate digit sum
            digit_sum = sum(int(c) for c in m_str + d_str)
            
            counts[digit_sum] += 1
            
    # Find n such that count(n) == n
    result = None
    for s, count in counts.items():
        if s == count:
            result = str(s)
            break
            
    return result

