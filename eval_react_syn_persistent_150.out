from math import gcd

def lcm(a, b):
    return abs(a * b) // gcd(a, b)

def M(a, b):
    return lcm(a, b) // gcd(a, b)

def compute_x(n):
    if n < 2:
        return 0
    val = n
    for k in range(n - 1, 1, -1):
        val = M(k, val)
    return val

def solve() -> str:
    limit = 2021
    # We need x_n for n from 2 to 2022
    x = {}
    for k in range(2, limit + 2):
        x[k] = compute_x(k)
    
    count = 0
    for n in range(2, limit + 1):
        xn = x[n]
        xn1 = x[n + 1]
        # Check 5*xn^2 + 5*xn1^2 = 26*xn*xn1
        lhs = 5 * xn * xn + 5 * xn1 * xn1
        rhs = 26 * xn * xn1
        if lhs == rhs:
            count += 1
            
    return str(count)

