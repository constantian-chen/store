import math

def solve():
    """
    Finds all virtual numbers of the form n^2 + 1.
    A virtual number is a 4-digit number of the form abab where a != 0.
    """
    results = []
    # Iterate through all possible virtual numbers
    # a in 1..9, b in 0..9
    for a in range(1, 10):
        for b in range(0, 10):
            num = 1000 * a + 100 * b + 10 * a + b
            # Check if num - 1 is a perfect square
            val = num - 1
            if val > 0:
                root = int(math.isqrt(val))
                if root * root == val:
                    results.append(num)
    
    # Return the results as a comma-separated string
    if not results:
        return "None"
    return ", ".join(map(str, results))

