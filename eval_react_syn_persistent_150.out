from sympy import divisors

def solve() -> str:
    """
    Finds the maximum integer n such that for each k <= n/2,
    there exist two divisors of n with difference k.
    """
    max_n = 0
    for n in range(1, 1000):
        divs = divisors(n)
        diffs = set()
        for i in range(len(divs)):
            for j in range(i + 1, len(divs)):
                diffs.add(divs[j] - divs[i])
        
        limit = n // 2
        valid = True
        for k in range(1, limit + 1):
            if k not in diffs:
                valid = False
                break
        
        if valid:
            max_n = n
            
    return str(max_n)

