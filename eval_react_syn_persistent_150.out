def solve():
    """
    Finds the minimum sum of four distinct primes p, q, r, s such that pq - rs is divisible by 30.
    """
    import sympy as sp
    
    # Generate primes up to a reasonable limit
    primes = list(sp.primerange(2, 100))
    
    # Filter out 2, 3, 5 because if any of them is used, the product would be divisible by 2, 3, or 5,
    # requiring the other product to be divisible by the same, which implies sharing the prime.
    # Since primes must be distinct, none can be 2, 3, or 5.
    valid_primes = [p for p in primes if p > 5]
    
    min_sum = float('inf')
    best_set = None
    
    # Iterate through all combinations of 4 distinct primes
    n = len(valid_primes)
    for i in range(n):
        p = valid_primes[i]
        for j in range(i + 1, n):
            q = valid_primes[j]
            for k in range(j + 1, n):
                r = valid_primes[k]
                for l in range(k + 1, n):
                    s = valid_primes[l]
                    
                    # Check condition: pq - rs divisible by 30
                    if (p * q - r * s) % 30 == 0:
                        current_sum = p + q + r + s
                        if current_sum < min_sum:
                            min_sum = current_sum
                            best_set = (p, q, r, s)
                    elif (p * r - q * s) % 30 == 0:
                        current_sum = p + q + r + s
                        if current_sum < min_sum:
                            min_sum = current_sum
                            best_set = (p, q, r, s)
                    elif (p * s - q * r) % 30 == 0:
                        current_sum = p + q + r + s
                        if current_sum < min_sum:
                            min_sum = current_sum
                            best_set = (p, q, r, s)
    
    return str(min_sum)

