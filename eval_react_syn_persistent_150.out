from typing import List

def count_idempotent_functions(n: int) -> str:
    """
    Counts the number of idempotent functions f: {1..n} -> {1..n} such that f(f(x)) = f(x).
    The formula is sum_{k=1}^{n} C(n, k) * k^(n-k).
    """
    from math import comb
    
    total = 0
    for k in range(1, n + 1):
        ways_to_choose_image = comb(n, k)
        ways_to_map_non_image = k ** (n - k)
        total += ways_to_choose_image * ways_to_map_non_image
    
    return str(total)

def solve() -> str:
    """
    Solves the specific problem for n=5.
    """
    return count_idempotent_functions(5)

