import sympy

def solve_bh_length() -> str:
    """
    Calculates the length of BH given AH, HD, and BE in an acute triangle ABC
    with orthocenter H.
    
    Given:
    AH = 20
    HD = 15
    BE = 56
    
    Using similarity of triangles AHE and BHD:
    AH * HD = BH * HE
    Let BH = x, then HE = 56 - x.
    20 * 15 = x * (56 - x)
    
    Solve for x and validate against the condition that triangle AHE must exist
    (i.e., HE < AH since AH is the hypotenuse).
    """
    AH = 20
    HD = 15
    BE = 56
    
    x = sympy.symbols('x')
    equation = AH * HD - x * (BE - x)
    
    solutions = sympy.solve(equation, x)
    
    valid_solution = None
    for sol in solutions:
        sol_val = float(sol)
        # Check if HE < AH (hypotenuse > leg in right triangle AHE)
        # HE = BE - BH
        HE = BE - sol_val
        if HE < AH and HE > 0:
            valid_solution = sol
            break
            
    if valid_solution is not None:
        return str(int(valid_solution))
    else:
        return "No valid solution found"

