    term3 = 4 * math.factorial(6)
    term4 = 4 * math.factorial(4)
    term5 = math.factorial(3)
    term6 = math.factorial(2)
    term7 = math.factorial(2)
    
    total = term1 + term2 + term3 + term4 + term5 + term6 + term7
    return str(total)

