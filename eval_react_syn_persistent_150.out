def solve() -> str:
    """
    Calculates the expected number of unpoked babies in a circle of n=2006.
    Each baby pokes left or right with probability 1/2.
    Returns the result as a simplified fraction string.
    """
    n = 2006
    # Probability a specific baby is unpoked:
    # Baby i is unpoked if (i-1 chooses Left) AND (i+1 chooses Right).
    # P(i-1 Left) = 1/2, P(i+1 Right) = 1/2.
    # Independent events => P = 1/4.
    # Expected value = n * 1/4.
    from fractions import Fraction
    result = Fraction(n, 4)
    return str(result)

