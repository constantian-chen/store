import sympy
from sympy.geometry import Point, Circle
from itertools import combinations

def count_circles():
    # Define a general triangle that is not isosceles and not right-angled
    # A(0, 4), B(1, 0), C(3, 1)
    A = Point(0, 4)
    B = Point(1, 0)
    C = Point(3, 1)
    
    # Midpoints
    D = Point((B.x + C.x) / 2, (B.y + C.y) / 2)
    E = Point((C.x + A.x) / 2, (C.y + A.y) / 2)
    F = Point((A.x + B.x) / 2, (A.y + B.y) / 2)
    
    points = [A, B, C, D, E, F]
    point_names = ['A', 'B', 'C', 'D', 'E', 'F']
    
    circles = {}
    triplet_count = 0
    
    # Iterate over all triplets
    for i, j, k in combinations(range(6), 3):
        p1, p2, p3 = points[i], points[j], points[k]
        name = f"{point_names[i]}{point_names[j]}{point_names[k]}"
        
        # Check collinearity
        if Point.is_collinear(p1, p2, p3):
            continue
        
        triplet_count += 1
        
        try:
            circ = Circle(p1, p2, p3)
            # Use center and radius squared as key to avoid float issues
            # sympy Circle has center and radius
            key = (circ.center, circ.radius**2)
            
            if key not in circles:
                circles[key] = []
            circles[key].append(name)
        except Exception as e:
            # Should not happen for non-collinear points
            pass
            
    num_circles = len(circles)
    return num_circles

