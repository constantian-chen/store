def solve_right_triangle_perimeter() -> str:
    """
    Solves for the perimeter of a right triangle given area 5 and hypotenuse 5.
    Returns the exact perimeter as a string.
    """
    # Let a and b be the legs, c be the hypotenuse
    # Given: c = 5, Area = 1/2 * a * b = 5 => a * b = 10
    # Pythagorean theorem: a^2 + b^2 = c^2 = 25
    # We need P = a + b + c
    
    # We know (a + b)^2 = a^2 + b^2 + 2ab
    # (a + b)^2 = 25 + 2 * 10 = 45
    # a + b = sqrt(45) = 3 * sqrt(5)
    
    sum_legs = sqrt(45)
    hypotenuse = 5
    perimeter = sum_legs + hypotenuse
    
    # Simplify the expression
    perimeter_simplified = simplify(perimeter)
    
    return str(perimeter_simplified)

