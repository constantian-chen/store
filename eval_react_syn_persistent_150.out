def count_valid_points():
    """
    Calculates the number of interior points P in a unit square such that
    the square can be partitioned into 10 triangles of equal area with P as a common vertex.
    
    The condition leads to x and y coordinates of P being multiples of 1/5,
    specifically in the set {1/5, 2/5, 3/5, 4/5} to ensure at least one triangle per side.
    """
    # Possible values for 5x and 5y must be integers k such that 1 <= k <= 4
    # because n_i = 5h_i >= 1 and h_i < 1 implies n_i < 5.
    # So n_i in {1, 2, 3, 4}.
    # This corresponds to x, y in {1/5, 2/5, 3/5, 4/5}.
    
    possible_coords = [1/5, 2/5, 3/5, 4/5]
    count = 0
    for x in possible_coords:
        for y in possible_coords:
            # Verify the conditions
            n1 = 5 * y
            n2 = 5 * (1 - y)
            n3 = 5 * x
            n4 = 5 * (1 - x)
            
            # Check if integers and >= 1
            if (n1.is_integer() and n2.is_integer() and 
                n3.is_integer() and n4.is_integer() and
                n1 >= 1 and n2 >= 1 and n3 >= 1 and n4 >= 1):
                count += 1
                
    return str(count)

