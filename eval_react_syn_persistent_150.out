def solve():
    """
    Computes the number of ways to construct the roads in HMMTLand.
    The problem asks for the number of labeled 3-regular graphs on 8 vertices
    such that for any pair of distinct vertices, the number of common neighbors is 0 or 2.
    
    Based on the analysis:
    1. The cube graph Q3 satisfies the condition.
       - Number of labeled Q3 graphs = 8! / |Aut(Q3)| = 40320 / 48 = 840.
    2. The disjoint union of two K4 graphs (2K4) satisfies the condition.
       - Number of labeled 2K4 graphs = binom(8, 4) / 2 = 70 / 2 = 35.
    3. Other 3-regular graphs on 8 vertices (e.g., Wagner graph) do not satisfy the condition
       (they have pairs with 1 common neighbor).
    
    Total ways = 840 + 35 = 875.
    """
    import math
    
    # Number of labeled Q3 graphs
    # Aut(Q3) = 2^3 * 3! = 8 * 6 = 48
    n = 8
    aut_q3 = 48
    count_q3 = math.factorial(n) // aut_q3
    
    # Number of labeled 2K4 graphs
    # Choose 4 vertices for the first K4, the rest form the second.
    # Divide by 2 because the two K4 components are indistinguishable.
    count_2k4 = math.comb(n, 4) // 2
    
    total_ways = count_q3 + count_2k4
    return str(total_ways)

