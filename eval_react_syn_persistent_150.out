from sympy import symbols, Eq, solve, Rational, sqrt, simplify

def solve_trapezoid_problem():
    """
    Solves for 'a' in the trapezoid problem where vertices lie on y=x^2.
    Given conditions:
    1. a + b = AB (derived from AD + BC = 2AB and AD=2a, BC=2b)
    2. AB = (a-b) * sqrt(1 + (a+b)^2)
    3. AB = 3/4
    Returns the value of a as a string.
    """
    # Define symbols
    a, b, AB_val = symbols('a b AB_val', real=True, positive=True)
    
    # Given value for AB
    AB_val = Rational(3, 4)
    
    # Equation 1: a + b = AB
    eq1 = Eq(a + b, AB_val)
    
    # Equation 2: AB = (a - b) * sqrt(1 + (a + b)^2)
    # Substitute a+b with AB_val in the sqrt term to simplify logic or solve system directly
    # Let's solve the system directly
    eq2 = Eq(AB_val, (a - b) * sqrt(1 + (a + b)**2))
    
    # Solve the system for a and b
    solution = solve((eq1, eq2), (a, b), dict=True)
    
    if not solution:
        return "No solution found"
    
    # Extract 'a' from the solution
    # There should be one valid solution with a > b > 0
    sol_a = None
    for sol in solution:
        if sol[a] > sol[b] and sol[b] > 0:
            sol_a = sol[a]
            break
            
    if sol_a is None:
        return "No valid solution found"
        
    # Simplify and return as string
    result = simplify(sol_a)
    return str(result)

