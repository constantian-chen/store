def solve_game():
    """
    Simulates the game to determine the number of moves William makes.
    The game is equivalent to a subtraction game where players subtract 1 or 2 from 100.
    The first to reach 0 wins.
    Mark goes first.
    Optimal play:
    - If current n % 3 == 0, the current player loses (if opponent plays optimally).
    - If current n % 3 != 0, the current player wins by moving to a multiple of 3.
    Since 100 % 3 == 1, Mark wins.
    The moves are forced to maintain the winning strategy.
    """
    n = 100
    mark_moves = 0
    william_moves = 0
    turn = 0  # 0 for Mark, 1 for William
    
    while n > 0:
        if turn == 0:
            # Mark's turn
            # Mark wants to win.
            # If n % 3 != 0, he can move to n' such that n' % 3 == 0.
            # If n % 3 == 0, he loses (but he won't be in this state if he played optimally).
            if n % 3 == 1:
                move = 1
            elif n % 3 == 2:
                move = 2
            else:
                # Should not happen if Mark plays optimally from start
                # If forced to lose, he might try to delay?
                # But here he is in a winning position.
                move = 1 # Fallback
            n -= move
            mark_moves += 1
        else:
            # William's turn
            # William is in a losing position (n % 3 == 0).
            # He cannot win. He might try to delay, but moves don't change the round count.
            # He can move 1 or 2.
            # Let's assume he moves 1 or 2, doesn't matter for the count.
            move = 1
            n -= move
            william_moves += 1
        
        turn = 1 - turn
        
    return str(william_moves)

