def solve_probability():
    """
    Solves for the probability p such that the expected value of the blackboard number
    follows a linear form at + b for all t.
    The recurrence for the expected value mu_t is:
    mu_{t+1} = (3p + (1-p)/2) * mu_t + p
    mu_{t+1} = ((5p + 1)/2) * mu_t + p
    For mu_t = at + b to be a solution for arbitrary initial conditions, the coefficient
    of mu_t must be 1.
    """
    p = symbols('p')
    # Coefficient of mu_t in the recurrence
    coeff = (5 * p + 1) / 2
    # Set coefficient to 1 for linear growth (non-exponential)
    eq = coeff - 1
    solution = solve(eq, p)
    if solution:
        val = solution[0]
        # Return as a string in simplest form
        return str(val)
    return "No solution"

