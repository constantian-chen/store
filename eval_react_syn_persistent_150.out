def solve() -> str:
    import math
    n = 6
    total_sum = 0
    factorial_n = math.factorial(n)
    square_factorial_n = factorial_n ** 2
    
    for k in range(2, n + 1):
        denom = (math.factorial(k) ** 2) * math.factorial(n - k)
        term = square_factorial_n // denom
        total_sum += term
        
    return str(total_sum)

