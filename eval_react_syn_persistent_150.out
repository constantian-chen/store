from itertools import combinations

def solve() -> str:
    factorials = [1, 1, 2, 6, 24, 120]
    sums = set()
    n = len(factorials)
    for r in range(1, n + 1):
        for combo in combinations(range(n), r):
            s = sum(factorials[i] for i in combo)
            if s <= 240:
                sums.add(s)
    return str(len(sums))

