from itertools import combinations
from fractions import Fraction
from math import gcd

def count_divisors(n: int) -> int:
    """Returns the number of divisors of n."""
    if n == 0:
        return 0
    if n == 1:
        return 1
    count = 1
    d = 2
    temp = n
    while d * d <= temp:
        exponent = 0
        while temp % d == 0:
            exponent += 1
            temp //= d
        if exponent > 0:
            count *= (exponent + 1)
        d += 1
    if temp > 1:
        count *= 2
    return count

def solve() -> str:
    """
    Computes the expected number of divisors of the product of elements
    of a random subset of {1, 2, ..., 10}.
    """
    elements = list(range(1, 11))
    total_sum = 0
    total_subsets = 2 ** len(elements)
    
    # Iterate over all possible subsets
    # We can use bit manipulation from 0 to 2^10 - 1
    for i in range(total_subsets):
        product = 1
        for j in range(len(elements)):
            if (i >> j) & 1:
                product *= elements[j]
        
        total_sum += count_divisors(product)
    
    expected_value = Fraction(total_sum, total_subsets)
    return f"{expected_value.numerator}/{expected_value.denominator}"

