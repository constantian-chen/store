from sympy import binomial

def solve() -> str:
    """
    Calculates the number of paths from (0,0) to (8,0) with steps (+1,+1) and (+1,-1)
    that never go below the x-axis. This is the 4th Catalan number.
    """
    n = 4  # Since 2n = 8 steps total
    # Catalan number formula: C_n = 1/(n+1) * binomial(2n, n)
    catalan_number = binomial(2 * n, n) // (n + 1)
    return str(catalan_number)


def calculate_catalan(n: int) -> str:
    """
    Calculates the n-th Catalan number using the formula C_n = (2n)! / ((n+1)! * n!).
    Returns the result as a string.
    """
    if n < 0:
        return "0"
    result = binomial(2 * n, n) // (n + 1)
    return str(result)


def count_dyk_paths(total_steps: int) -> str:
    """
    Counts Dyck paths of a given total length (must be even).
    If total_steps is odd, returns 0.
    """
    if total_steps % 2 != 0:
        return "0"
    n = total_steps // 2
    return calculate_catalan(n)

