import math
from sympy import gamma, N, Rational

def solve_volume():
    n = 2016
    # Formula derived: V = 8 * n^(-1.5 + 2/n) * (Gamma(1/n)^2 * Gamma(1.5)) / Gamma(2/n + 1.5)
    # Using SymPy for high precision
    n_val = n
    term1 = 8
    term2 = n_val ** (-1.5 + 2/n_val)
    term3 = (gamma(1/n_val) ** 2 * gamma(Rational(3, 2))) / gamma(2/n_val + Rational(3, 2))
    
    V = term1 * term2 * term3
    V_float = float(V.evalf())
    
    # Round to nearest multiple of 10
    rounded = round(V_float / 10) * 10
    return str(int(rounded))

