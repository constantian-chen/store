def solve():
    from itertools import product

    count = 0
    # Iterate through all possible digits for a 5-digit number
    # d1 is 1-9, others 1-9 (since product is 180, no 0 allowed)
    # Actually, we can just iterate 1-9 for all to be safe, as 0 would make product 0.
    # But to be precise, d1 in 1..9, d2..d5 in 1..9.
    
    # Optimization: Generate partitions or just brute force since 9^5 is small.
    # 9^5 = 59049 iterations. Very fast.
    
    for d1 in range(1, 10):
        for d2 in range(1, 10):
            for d3 in range(1, 10):
                for d4 in range(1, 10):
                    for d5 in range(1, 10):
                        if d1 * d2 * d3 * d4 * d5 == 180:
                            count += 1
                            
    return str(count)

