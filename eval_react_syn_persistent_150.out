from sympy import symbols, integrate, Rational

def solve():
    """
    Computes the probability that a 3x3 grid of i.i.d. U[0,1] random variables
    has at least one saddle point.
    
    A saddle point is an entry that is the maximum in its row and minimum in its column.
    Due to continuity, saddle points are unique almost surely.
    The probability is 9 * P(specific cell is saddle point).
    P(cell (i,j) is saddle) = integral from 0 to 1 of x^(2) * (1-x)^(2) dx.
    """
    x = symbols('x')
    # Probability for a single cell to be a saddle point
    # Row has 2 other elements < x, Col has 2 other elements > x
    # Integral of x^2 * (1-x)^2 from 0 to 1
    p_single = integrate(x**2 * (1 - x)**2, (x, 0, 1))
    
    # There are 3*3 = 9 cells, and events are disjoint
    n = 3
    total_prob = n**2 * p_single
    
    # Return as a string fraction
    return str(total_prob)

