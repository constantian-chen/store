    eq2 = Eq(A + 3*B + 4*C + 12*D, Rational(1, 12))
    eq3 = Eq(A + 4*B + 3*C + 12*D, Rational(1, 12))
    eq4 = Eq(A + 4*B + 4*C + 16*D, Rational(1, 16))
    
    sol = sympy_solve((eq1, eq2, eq3, eq4), (A, B, C, D))
    
