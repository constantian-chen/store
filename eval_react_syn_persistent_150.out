def solve() -> str:
    """
    Calculates the number of pairs of nonzero integers (c, d) with -2015 <= c, d <= 2015
    such that cx = d and dx = c both have integer solutions.
    
    Logic:
    1. cx = d has integer solution iff c divides d.
    2. dx = c has integer solution iff d divides c.
    3. c|d and d|c implies |c| = |d|.
    4. Since c, d != 0, d = c or d = -c.
    5. Range is [-N, N] excluding 0, where N = 2015.
    6. Number of choices for c is 2N.
    7. For each c, there are 2 choices for d (c and -c).
    8. Total pairs = 2N * 2 = 4N.
    """
    N = 2015
    # Number of nonzero integers in [-N, N] is 2*N
    num_c = 2 * N
    
    # For each c, d can be c or -c (2 options)
    total_pairs = num_c * 2
    
    return str(total_pairs)

