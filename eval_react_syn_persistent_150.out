def solve() -> str:
    """
    Computes the sum of all positive integers n < 2048 such that n has an even number of 1's in its binary representation.
    """
    k = 11
    # Total numbers from 0 to 2^k - 1 is 2^k
    # Number of elements with even popcount is 2^(k-1)
    # Sum of all numbers from 0 to 2^k - 1 is (2^k - 1) * 2^k / 2
    # By symmetry, sum of even popcount numbers = sum of odd popcount numbers = Total Sum / 2
    # Sum = (2^k - 1) * 2^(k-1) / 2 = (2^k - 1) * 2^(k-2)
    # Since 0 is included in the even set but contributes 0, the sum of positive integers is the same.
    
    total_sum = (2**k - 1) * (2**k) // 2
    sum_even = total_sum // 2
    
    return str(sum_even)

