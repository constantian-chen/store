def solve():
    """
    Solves the problem where P(x) = x^2 + bx + c, P(P(1)) = P(P(2)) = 0,
    and P(1) != P(2). Returns P(0) as a string.
    """
    from sympy import symbols, Eq, solve as sympy_solve
    
    b, c = symbols('b c')
    
    # P(1) and P(2) are roots of P(x)
    # Sum of roots: P(1) + P(2) = -b
    # Product of roots: P(1) * P(2) = c
    
    p1 = 1 + b + c
    p2 = 4 + 2*b + c
    
    eq1 = Eq(p1 + p2, -b)
    eq2 = Eq(p1 * p2, c)
    
    sol = sympy_solve((eq1, eq2), (b, c))
    
    # sol is a list of tuples (b, c). We expect one valid solution.
    # Check P(1) != P(2) constraint if multiple solutions exist.
    final_c = None
    
    for s in sol:
        b_val, c_val = s
        p1_val = 1 + b_val + c_val
        p2_val = 4 + 2*b_val + c_val
        if p1_val != p2_val:
            final_c = c_val
            break
            
    if final_c is None:
        return "No solution"
    
    return str(final_c)

