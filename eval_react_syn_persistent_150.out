def solve() -> str:
    """
    Calculates the expected length of the string generated by appending H, M, T
    with probabilities 1/4, 1/2, 1/4 until 'MM' appears.
    
    Uses a system of linear equations for expected values:
    E: expected additional length from start (no previous M)
    E1: expected additional length given the last character was M
    
    Equations:
    E = 1 + 0.5*E + 0.5*E1
    E1 = 1 + 0.5*E
    
    Solving yields E = 6.
    """
    # Define probabilities
    p_h = 1/4
    p_m = 1/2
    p_t = 1/4
    
    # Probability of resetting to state 0 (H or T)
    p_reset = p_h + p_t
    
    # Solve the system:
    # E = 1 + p_reset * E + p_m * E1
    # E1 = 1 + p_reset * E
    
    # From E1 equation: E1 = 1 + p_reset * E
    # Substitute into E equation:
    # E = 1 + p_reset * E + p_m * (1 + p_reset * E)
    # E = 1 + p_reset * E + p_m + p_m * p_reset * E
    # E * (1 - p_reset - p_m * p_reset) = 1 + p_m
    
    # Since p_reset + p_m = 1, p_m * p_reset = p_m * (1 - p_m)
    # Let's just compute numerically with fractions to be safe
    from fractions import Fraction
    
    p_h = Fraction(1, 4)
    p_m = Fraction(1, 2)
    p_t = Fraction(1, 4)
    p_reset = p_h + p_t
    
    # E = 1 + p_reset * E + p_m * E1
    # E1 = 1 + p_reset * E
    # Substitute E1:
    # E = 1 + p_reset * E + p_m * (1 + p_reset * E)
    # E = 1 + p_reset * E + p_m + p_m * p_reset * E
    # E - p_reset * E - p_m * p_reset * E = 1 + p_m
    # E * (1 - p_reset - p_m * p_reset) = 1 + p_m
    
    numerator = 1 + p_m
    denominator = 1 - p_reset - p_m * p_reset
    
    expected_length = numerator / denominator
    
    return str(expected_length)

