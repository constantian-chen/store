def solve() -> str:
    def get_mu(n):
        if n == 1:
            return 1
        factors = 0
        d = 2
        temp = n
        while d * d <= temp:
            if temp % d == 0:
                count = 0
                while temp % d == 0:
                    count += 1
                    temp //= d
                if count > 1:
                    return 0
                factors += 1
            d += 1
        if temp > 1:
            factors += 1
        return -1 if factors % 2 == 1 else 1

    def count_solutions(n):
        if n < 5:
            return 0
        A = (n - 3) // 2
        if A < 1:
            return 0
        r = (-n) % 3
        if r == 0:
            r = 3
        if r > A:
            return 0
        return (A - r) // 3 + 1

    total_sum = 0
    for k in range(5, 301):
        val = 300 // k
        if val == 0:
            continue
        
        N_k = 0
        # Iterate divisors
        d = 1
        while d * d <= k:
            if k % d == 0:
                # divisor d
                mu_d = get_mu(d)
                if mu_d != 0:
                    N_k += mu_d * count_solutions(k // d)
                
                # divisor k // d
                if d * d != k:
                    d2 = k // d
                    mu_d2 = get_mu(d2)
                    if mu_d2 != 0:
                        N_k += mu_d2 * count_solutions(k // d2)
            d += 1
        
        total_sum += val * N_k
    
    return str(total_sum)

