from sympy import Rational, simplify

def find_nth_d0(n: int) -> str:
    """
    Computes the n-th smallest value of d0 such that the minimum speed v to catch the train is a perfect square.
    The formula derived is d0 = n^4 / 8.
    
    Args:
        n (int): The index of the smallest value (1-based).
        
    Returns:
        str: The value of d0 as a simplified fraction or integer string.
    """
    if n <= 0:
        return "0"
    val = Rational(n**4, 8)
    if val.denominator == 1:
        return str(val.numerator)
    else:
        return f"{val.numerator}/{val.denominator}"

