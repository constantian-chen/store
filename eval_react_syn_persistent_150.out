from itertools import product

def solve():
    n = 10
    blocks = []
    for start in range(n):
        block = set((start + i) % n for i in range(5))
        blocks.append(block)
    
    total = 0
    for c1, c2, c3, c4 in product(range(n), repeat=4):
        inter = blocks[c1] & blocks[c2] & blocks[c3] & blocks[c4]
        if not inter:
            total += 1
    
    return str(total)

