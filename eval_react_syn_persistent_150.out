from sympy import Rational, sqrt, simplify

def solve_hexagon_area() -> str:
    """
    Calculates the area of an equilateral hexagon with side length 1
    and interior angles 90, 120, 150, 90, 120, 150 degrees.
    
    The coordinates of the vertices are derived by traversing the perimeter
    starting from (0,0) with the first side along the x-axis.
    The area is computed using the Shoelace formula.
    
    Returns:
        str: The area in the form 'a + b*sqrt(c)' or simplified fraction.
    """
    # Coordinates based on the geometric construction
    # A = (0, 0)
    # B = (1, 0)
    # C = (1 + cos(60), sin(60)) = (1.5, sqrt(3)/2)
    # D = (1.5, sqrt(3)/2 + 1)
    # E = (1.5 - 1, sqrt(3)/2 + 1) = (0.5, 1 + sqrt(3)/2)
    # F = (0.5 + cos(240), 1 + sqrt(3)/2 + sin(240)) = (0, 1)
    
    # Define coordinates as sympy expressions
    x = [0, 1, Rational(3, 2), Rational(3, 2), Rational(1, 2), 0]
    y = [0, 0, sqrt(3)/2, 1 + sqrt(3)/2, 1 + sqrt(3)/2, 1]
    
    n = len(x)
    area_sum = 0
    for i in range(n):
        j = (i + 1) % n
        area_sum += x[i] * y[j] - x[j] * y[i]
        
    area = abs(area_sum) / 2
    area_simplified = simplify(area)
    
    return str(area_simplified)

